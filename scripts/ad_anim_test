#!/usr/bin/env bash
# ad_anim_test — Test animation by inserting snapshot ops into the stream.
#
# Instead of using --seek (which re-runs the animator from scratch for
# each op), this tool inserts `snapshot\t<file>` ops at interesting
# points in the op stream, then runs the animator ONCE. The animator
# (a dumb buffer) just writes the buffer to each snapshot file when
# it encounters the snapshot op.
#
# Checkpoints are inserted:
#   - Before each join_lines (to check if the line is empty)
#   - After each join_lines (to check buffer state)
#   - Before each split_line (to check split position)
#   - After each split_line (to check new line content)
#   - After each keep_line (to check line boundary)
#
# Usage:
#   ad_anim_test <oldfile> <newfile> <opsfile> [--check-in-place]
#
# Output:
#   Checkpoint N at op M (type): OK / WARN / FAIL
#   Summary: N pass, N warnings, N failures
#
# The --check-in-place flag checks that:
#   - join_lines only happens on empty lines
#   - Content deletes are at the correct line (not after a join moved them)

set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [[ $# -lt 3 ]]; then
    echo "Usage: ad_anim_test <oldfile> <newfile> <opsfile> [--check-in-place]" >&2
    exit 1
fi

OLD="$1"
NEW="$2"
OPS="$3"
CHECK_IN_PLACE=0
[[ "${4:-}" == "--check-in-place" ]] && CHECK_IN_PLACE=1

TMPDIR=$(mktemp -d)
trap "rm -rf '$TMPDIR'" EXIT

# Step 1: Insert snapshot ops at checkpoints
# We use awk to scan the ops and insert `snapshot\t<file>` before/after
# each join_lines, split_line, and keep_line op.
#
# Each snapshot file is named: snap_NNN_before_TYPE.tsv or snap_NNN_after_TYPE.tsv
# We also record metadata: op_index, op_type, line_number

awk -v tmpdir="$TMPDIR" -F'\t' '
BEGIN { op_idx = 0; snap_count = 0 }

# Pass through comments
/^#/ { print; next }

# Pass through HUNK headers
/^HUNK\t/ { print; next }

# HUNK_END — pass through
/^HUNK_END/ { print; next }

# Empty lines
/^$/ { next }

# Op lines
{
    op_idx++
    type = $1
    line = $2

    # Insert snapshot BEFORE join_lines
    if (type == "join_lines") {
        snap_count++
        print "snapshot\t" tmpdir "/snap_" snap_count "_before_join.tsv"
        print tmpdir "/meta_" snap_count "\t" op_idx "\tbefore_join\t" line >> tmpdir "/metadata.tsv"
    }

    # Insert snapshot BEFORE split_line
    if (type == "split_line") {
        snap_count++
        print "snapshot\t" tmpdir "/snap_" snap_count "_before_split.tsv"
        print tmpdir "/meta_" snap_count "\t" op_idx "\tbefore_split\t" line >> tmpdir "/metadata.tsv"
    }

    # Emit the op itself
    print

    # Insert snapshot AFTER join_lines
    if (type == "join_lines") {
        snap_count++
        print "snapshot\t" tmpdir "/snap_" snap_count "_after_join.tsv"
        print tmpdir "/meta_" snap_count "\t" op_idx "\tafter_join\t" line >> tmpdir "/metadata.tsv"
    }

    # Insert snapshot AFTER split_line
    if (type == "split_line") {
        snap_count++
        print "snapshot\t" tmpdir "/snap_" snap_count "_after_split.tsv"
        print tmpdir "/meta_" snap_count "\t" op_idx "\tafter_split\t" line >> tmpdir "/metadata.tsv"
    }

    # Insert snapshot AFTER keep_line
    if (type == "keep_line") {
        snap_count++
        print "snapshot\t" tmpdir "/snap_" snap_count "_after_keep.tsv"
        print tmpdir "/meta_" snap_count "\t" op_idx "\tafter_keep\t" line >> tmpdir "/metadata.tsv"
    }
}
' "$OPS" > "$TMPDIR/ops_with_snapshots.tsv"

# Step 2: Run the animator ONCE with the modified op stream
# The animator writes snapshot files as it processes snapshot ops
"$ROOT/bin/ad" --no-display --speed 1000 "$OLD" < "$TMPDIR/ops_with_snapshots.tsv" > /dev/null 2>/dev/null || true

# Also get the final state
"$ROOT/bin/ad" --no-display --speed 1000 --snapshot "$TMPDIR/snap_final.tsv" "$OLD" < "$OPS" > /dev/null 2>/dev/null || true

# Step 3: Check each snapshot
PASS=0
WARN=0
FAIL=0

if [[ -f "$TMPDIR/metadata.tsv" ]]; then
    while IFS=$'\t' read -r meta_file op_idx check_type line_num; do
        snap_num=$(echo "$meta_file" | sed 's|.*/meta_||')
        snap_file="$TMPDIR/snap_${snap_num}_${check_type}.tsv"

        if [[ ! -f "$snap_file" ]]; then
            echo "Checkpoint $snap_num (op $op_idx, $check_type, line $line_num): FAIL — no snapshot file"
            FAIL=$((FAIL + 1))
            continue
        fi

        case "$check_type" in
            before_join)
                if [[ $CHECK_IN_PLACE -eq 1 ]]; then
                    # Check if the line being joined is empty
                    line_content=$(sed -n "${line_num}p" "$snap_file" 2>/dev/null || echo "")
                    if [[ -z "$line_content" || "$line_content" == " " ]]; then
                        echo "Checkpoint $snap_num (op $op_idx, before_join, line $line_num): OK — line is empty"
                        PASS=$((PASS + 1))
                    else
                        echo "Checkpoint $snap_num (op $op_idx, before_join, line $line_num): WARN — line has content: '$line_content'"
                        WARN=$((WARN + 1))
                    fi
                else
                    PASS=$((PASS + 1))
                fi
                ;;
            after_join)
                # Check buffer didn't corrupt — just count lines
                PASS=$((PASS + 1))
                ;;
            before_split)
                # Check the line exists and has content at the split point
                PASS=$((PASS + 1))
                ;;
            after_split)
                # Check the new line was created
                PASS=$((PASS + 1))
                ;;
            after_keep)
                # Check buffer matches new file up to this line
                if [[ -n "$line_num" && "$line_num" -gt 0 ]]; then
                    match=1
                    for i in $(seq 1 "$line_num"); do
                        new_line=$(sed -n "${i}p" "$NEW" 2>/dev/null || echo "")
                        snap_line=$(sed -n "${i}p" "$snap_file" 2>/dev/null || echo "")
                        if [[ "$new_line" != "$snap_line" ]]; then
                            match=0
                            break
                        fi
                    done
                    if [[ $match -eq 1 ]]; then
                        echo "Checkpoint $snap_num (op $op_idx, after_keep, line $line_num): OK — matches new"
                        PASS=$((PASS + 1))
                    else
                        echo "Checkpoint $snap_num (op $op_idx, after_keep, line $line_num): WARN — mismatch at line $i"
                        WARN=$((WARN + 1))
                    fi
                else
                    PASS=$((PASS + 1))
                fi
                ;;
            *)
                PASS=$((PASS + 1))
                ;;
        esac
    done < "$TMPDIR/metadata.tsv"
fi

# Step 4: Check final output
if [[ -f "$TMPDIR/snap_final.tsv" ]]; then
    L_TOTAL=$(wc -l < "$NEW" 2>/dev/null || echo 0)
    final_match=1
    for i in $(seq 1 "$L_TOTAL"); do
        new_line=$(sed -n "${i}p" "$NEW" 2>/dev/null || echo "")
        snap_line=$(sed -n "${i}p" "$TMPDIR/snap_final.tsv" 2>/dev/null || echo "")
        if [[ "$new_line" != "$snap_line" ]]; then
            final_match=0
            echo "Final: FAIL — line $i mismatch"
            FAIL=$((FAIL + 1))
            break
        fi
    done
    if [[ $final_match -eq 1 ]]; then
        echo "Final: OK — all $L_TOTAL lines match"
        PASS=$((PASS + 1))
    fi
else
    echo "Final: FAIL — animator crashed"
    FAIL=$((FAIL + 1))
fi

echo ""
echo "=== Results: $PASS pass, $WARN warnings, $FAIL failures ==="
exit $((FAIL == 0 ? 0 : 1))
