#!/usr/bin/env bash
# ad_tmux — thin wrapper that runs ad_vim inside a tmux pane.
#
# This is a thin wrapper around ad_vim. It creates a tmux session,
# runs ad_vim inside it, and cleans up when done.
#
# Usage: ad_tmux [options] <oldfile> <newfile>
#   All options are passed through to ad_vim.
#
# Requires: tmux, vim 8+ with +timers and +float.

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

show_help() {
    cat <<'HELP'
ad_tmux — animate a code diff in vim inside a tmux pane

Usage: ad_tmux [options] <oldfile> <newfile>

This is a thin wrapper around ad_vim. It creates a tmux session,
runs ad_vim inside it, and cleans up when done.

All ad_vim options are passed through. See 'ad_vim --help' for details.

Options:
  --session-name NAME   tmux session name (default: ad_tmux_$$)
  --help, -h            Show this help

Environment:
  TMUX_BIN              Path to tmux binary (default: tmux)

Examples:
  ad_tmux old.py new.py
  ad_tmux --speed 0.5 --highlight inline old.py new.py
HELP
}

# Parse our own args (--session-name, --help)
# Everything else goes to ad_vim
SESSION_NAME="ad_tmux_$$"
AD_VIM_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --session-name)
            SESSION_NAME="$2"
            shift 2
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        --version|-V)
            AD_VERSION="$(cat "$ROOT/VERSION" 2>/dev/null || echo "2.0.0")"
            echo "ad_tmux $AD_VERSION"
            exit 0
            ;;
        *)
            AD_VIM_ARGS+=("$1")
            shift
            ;;
    esac
done

if [[ ${#AD_VIM_ARGS[@]} -lt 2 ]]; then
    echo "Error: need <oldfile> <newfile>" >&2
    echo "Run 'ad_tmux --help' for details." >&2
    exit 1
fi

TMUX="${TMUX_BIN:-tmux}"
if ! command -v "$TMUX" >/dev/null 2>&1; then
    echo "ad_tmux: tmux not found. Install tmux or set TMUX_BIN." >&2
    exit 1
fi

AD_VIM="$ROOT/apps/vim/ad_vim"
if [[ ! -x "$AD_VIM" ]]; then
    echo "ad_tmux: ad_vim not found at $AD_VIM" >&2
    exit 1
fi

# Check if already inside tmux
if [[ -n "${TMUX:-}" ]]; then
    # Already in tmux — just run ad_vim directly
    exec "$AD_VIM" "${AD_VIM_ARGS[@]}"
fi

# Create a new tmux session and run ad_vim in it
# Use a unique session name to avoid collisions
"$TMUX" new-session -d -s "$SESSION_NAME" \
    "$AD_VIM" "${AD_VIM_ARGS[@]}" 2>/dev/null || {
    echo "ad_tmux: failed to create tmux session" >&2
    exit 1
}

# Attach to the session
# When the user detaches (Ctrl-b d) or ad_vim exits, clean up
trap "$TMUX kill-session -t '$SESSION_NAME' 2>/dev/null || true" EXIT

"$TMUX" attach-session -t "$SESSION_NAME"
