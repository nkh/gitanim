#!/usr/bin/env bash
# ad_session — Vim-only interactive op debugger.
#
# Creates a session directory, copies old/new, generates ops, git init,
# and launches vim with a split layout:
#   Left:  diff (new vs result) — updated on F6
#   Right: ops.tsv (editing) + result.txt (horizontal split)
#
# F5: run animation in terminal split
# F6: run animator (snapshot), update result.txt, refresh diff
#
# Usage:
#   ad_session <oldfile> <newfile> [opfile] [options]
#   ad_session --resume <session_dir>
#   ad_session --resume-latest
#   ad_session --list-sessions

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SESSIONS_DIR="$ROOT/ad_sessions"

# Source layer group parser
source "$SCRIPT_DIR/lib/ad_layer_groups.sh"

show_help() {
    cat <<'HELP'
ad_session — Vim-only interactive op debugger.

USAGE
    ad_session <oldfile> <newfile> [opfile] [options]
    ad_session --resume <session_dir>
    ad_session --resume-latest
    ad_session --list-sessions

DESCRIPTION
    Creates a session directory under ad_sessions/ in the project root.
    Copies old/new files, generates ops, initializes a git repo, and
    launches vim with:
      Left split:  diff (new vs result) — updated on F6
      Right top:   ops.tsv (editing, F5=animate, F6=snapshot)
      Right bot:   result.txt (horizontal split, updated on F6)

    No tmux required. Everything runs inside vim.

OPTIONS
    --help, -h                Show this help and exit
    --ad-layer=<name>         Layer(s) for ad_gen_ops (if generating ops)
    --session-name=<name>     Custom session directory name
    --resume=<path>           Resume existing session
    --resume-latest           Resume most recent session
    --list-sessions           List sessions and exit
    --no-generate             Don't generate ops if opfile missing
    --fold-context=<N>        Context lines around non-keep ops (default: 5)
    --fold-hunks              Start with all hunks folded
    --layer-file=<file>       Layer group file (default: .ad_layers)
                              First line = active group name. Edit to switch.

VIM SHORTCUTS (inside session)
    F5                        Run animation in terminal split
    F6                        Run animator (snapshot), update result + diff
    <leader>r                 Same as F6
    <leader>c                 Git commit
    <leader>q                 Commit and quit
    <leader>Q                 Quit without committing
    <leader>g                 Regenerate ops (backs up to ops.tsv.bak)
    <leader>d                 Reopen diff split (result vs new)
    <leader>h                 Fold all hunks except current
    <leader>H                 Unfold all hunks
    <leader>k                 Toggle keep-op folding
    <leader>?                 Show help (shortcuts)

EXAMPLES
    ad_session old.py new.py --ad-layer=ad_layer_reorder
    ad_session old.py new.py my_ops.tsv --session-name bug42
    ad_session --resume-latest
    ad_session --list-sessions

SEE ALSO
    ad_tmux_watch — tmux version (ad_watch + vim in panes)
    ad_watch — display script
    ad_gen_ops — generates op file
HELP
}

# --- Parse args ---
OLD_FILE=""
NEW_FILE=""
OP_FILE=""
GEN_OPS_ARGS=()
NO_GENERATE=0
SESSION_NAME=""
RESUME_DIR=""
RESUME_LATEST=0
LIST_SESSIONS=0
FOLD_CONTEXT=5
FOLD_HUNKS=0
LAYER_FILE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h) show_help; exit 0 ;;
        --no-generate) NO_GENERATE=1; shift ;;
        --ad-layer=*) GEN_OPS_ARGS+=("$1"); shift ;;
        --ad-layer) GEN_OPS_ARGS+=("$1" "$2"); shift 2 ;;
        --ad-layer-path=*) GEN_OPS_ARGS+=("$1"); shift ;;
        --ad-layer-path) GEN_OPS_ARGS+=("$1" "$2"); shift 2 ;;
        --session-name=*) SESSION_NAME="${1#--session-name=}"; shift ;;
        --session-name) SESSION_NAME="$2"; shift 2 ;;
        --resume=*) RESUME_DIR="${1#--resume=}"; shift ;;
        --resume) RESUME_DIR="$2"; shift 2 ;;
        --resume-latest) RESUME_LATEST=1; shift ;;
        --list-sessions) LIST_SESSIONS=1; shift ;;
        --fold-context=*) FOLD_CONTEXT="${1#--fold-context=}"; shift ;;
        --fold-hunks) FOLD_HUNKS=1; shift ;;
        --layer-file=*) LAYER_FILE="${1#--layer-file=}"; shift ;;
        --layer-file) LAYER_FILE="$2"; shift 2 ;;
        --*) echo "ad_session: unknown option: $1" >&2; exit 1 ;;
        *)
            if [[ -z "$OLD_FILE" ]]; then OLD_FILE="$1"
            elif [[ -z "$NEW_FILE" ]]; then NEW_FILE="$1"
            elif [[ -z "$OP_FILE" ]]; then OP_FILE="$1"
            else echo "ad_session: unexpected argument: $1" >&2; exit 1
            fi
            shift ;;
    esac
done

# --- List sessions ---
if [[ $LIST_SESSIONS -eq 1 ]]; then
    if [[ ! -d "$SESSIONS_DIR" ]]; then
        echo "No sessions found." ; exit 0
    fi
    echo "Sessions in $SESSIONS_DIR:"
    for d in "$SESSIONS_DIR"/*/; do
        [[ -d "$d" ]] || continue
        name=$(basename "$d")
        mtime=$(stat -c %Y "$d" 2>/dev/null || echo 0)
        mdate=$(date -d @"$mtime" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "?")
        git_status="clean"
        if (cd "$d" && git diff --quiet 2>/dev/null && git diff --cached --quiet 2>/dev/null); then
            :
        else
            git_status="dirty"
        fi
        printf "  %-30s  %s  %s\n" "$name" "$mdate" "$git_status"
    done
    exit 0
fi

# --- Resume ---
if [[ -n "$RESUME_DIR" || $RESUME_LATEST -eq 1 ]]; then
    if [[ $RESUME_LATEST -eq 1 ]]; then
        if [[ ! -d "$SESSIONS_DIR" ]]; then
            echo "ad_session: no sessions found" >&2; exit 1
        fi
        RESUME_DIR=$(ls -td "$SESSIONS_DIR"/*/ 2>/dev/null | head -1)
        if [[ -z "$RESUME_DIR" ]]; then
            echo "ad_session: no sessions found" >&2; exit 1
        fi
        RESUME_DIR="${RESUME_DIR%/}"
    fi
    RESUME_DIR=$(cd "$RESUME_DIR" && pwd)
    if [[ ! -d "$RESUME_DIR" ]]; then
        echo "ad_session: session not found: $RESUME_DIR" >&2; exit 1
    fi
    OLD_FILE=$(ls "$RESUME_DIR"/old.* 2>/dev/null | head -1)
    NEW_FILE=$(ls "$RESUME_DIR"/new.* 2>/dev/null | head -1)
    OP_FILE="$RESUME_DIR/ops.tsv"
    if [[ -z "$OLD_FILE" || -z "$NEW_FILE" ]]; then
        echo "ad_session: session missing old/new files: $RESUME_DIR" >&2; exit 1
    fi
    SESSION_DIR="$RESUME_DIR"
    # Resolve layer file in session
    if [[ -z "$LAYER_FILE" && -f "$SESSION_DIR/layers.txt" ]]; then
        LAYER_FILE="$SESSION_DIR/layers.txt"
    fi
    echo "ad_session: resuming session: $SESSION_DIR" >&2
else
    # --- Create new session ---
    if [[ -z "$OLD_FILE" || -z "$NEW_FILE" ]]; then
        show_help; exit 1
    fi
    if [[ ! -f "$OLD_FILE" ]]; then
        echo "ad_session: old file not found: $OLD_FILE" >&2; exit 1
    fi
    if [[ ! -f "$NEW_FILE" ]]; then
        echo "ad_session: new file not found: $NEW_FILE" >&2; exit 1
    fi

    OLD_FILE=$(cd "$(dirname "$OLD_FILE")" && pwd)/$(basename "$OLD_FILE")
    NEW_FILE=$(cd "$(dirname "$NEW_FILE")" && pwd)/$(basename "$NEW_FILE")

    if [[ -n "$SESSION_NAME" ]]; then
        SESSION_DIR="$SESSIONS_DIR/$SESSION_NAME"
    else
        local_basename=$(basename "$OLD_FILE")
        local_basename="${local_basename%.*}"
        timestamp=$(date '+%Y%m%d_%H%M%S')
        SESSION_DIR="$SESSIONS_DIR/${local_basename}_$timestamp"
    fi

    mkdir -p "$SESSION_DIR"

    old_ext="${OLD_FILE##*.}"
    new_ext="${NEW_FILE##*.}"
    cp "$OLD_FILE" "$SESSION_DIR/old.$old_ext"
    cp "$NEW_FILE" "$SESSION_DIR/new.$new_ext"
    OLD_FILE="$SESSION_DIR/old.$old_ext"
    NEW_FILE="$SESSION_DIR/new.$new_ext"

    # --- Resolve layer file ---
    # Priority: --layer-file > .ad_layers in project root > none
    if [[ -z "$LAYER_FILE" ]]; then
        if [[ -f "$ROOT/.ad_layers" ]]; then
            LAYER_FILE="$ROOT/.ad_layers"
        fi
    fi
    # Copy layer file into session
    if [[ -n "$LAYER_FILE" && -f "$LAYER_FILE" ]]; then
        cp "$LAYER_FILE" "$SESSION_DIR/layers.txt"
        LAYER_FILE="$SESSION_DIR/layers.txt"
        echo "ad_session: layer file: $LAYER_FILE" >&2
    else
        LAYER_FILE=""
    fi

    # --- Determine layers to use ---
    if [[ -n "$LAYER_FILE" ]]; then
        # Parse layer group file — first non-comment line = active group
        if ad_layers_parse "$LAYER_FILE"; then
            ad_layers_to_args
            GEN_OPS_ARGS=("${AD_LAYER_ARGS[@]}")
            echo "ad_session: layer group '$AD_LAYERS_GROUP': ${AD_LAYERS_RESULT:-none}" >&2
        else
            echo "ad_session: failed to parse layer file: $LAYER_FILE" >&2
            exit 1
        fi
    fi

    if [[ -n "$OP_FILE" && -f "$OP_FILE" ]]; then
        cp "$OP_FILE" "$SESSION_DIR/ops.tsv"
        echo "ad_session: copied ops from $OP_FILE" >&2
    elif [[ $NO_GENERATE -eq 0 ]]; then
        echo "ad_session: generating ops..." >&2
        "$SCRIPT_DIR/ad_gen_ops" "$OLD_FILE" "$NEW_FILE" "${GEN_OPS_ARGS[@]}" > "$SESSION_DIR/ops.tsv"
        echo "ad_session: generated ops ($(wc -l < "$SESSION_DIR/ops.tsv") lines)" >&2
    else
        echo "ad_session: no ops file and --no-generate given" >&2; exit 1
    fi
    OP_FILE="$SESSION_DIR/ops.tsv"

    # Create empty result.txt
    touch "$SESSION_DIR/result.txt"

    # Git init
    (cd "$SESSION_DIR" && git init -q 2>/dev/null && git add -A && git commit -q -m "Initial session" 2>/dev/null) || true

    # Create resume.sh
    cat > "$SESSION_DIR/resume.sh" <<RESUME
#!/usr/bin/env bash
cd "$SESSION_DIR"
exec "$SCRIPT_DIR/ad_session" --resume "$SESSION_DIR"
RESUME
    chmod +x "$SESSION_DIR/resume.sh"

    # Add ad_sessions/ to .gitignore
    if ! grep -q '^ad_sessions/' "$ROOT/.gitignore" 2>/dev/null; then
        echo "ad_sessions/" >> "$ROOT/.gitignore"
    fi

    echo "ad_session: session created: $SESSION_DIR" >&2
fi

# --- Resolve paths relative to session dir ---
OLD_BASE=$(basename "$OLD_FILE")
NEW_BASE=$(basename "$NEW_FILE")
OP_BASE="ops.tsv"
RESULT_BASE="result.txt"
ANIMATOR_BIN=""
for dir in "$ROOT/bin" "$ROOT/pipeline"; do
    if [[ -x "$dir/ad" ]]; then
        ANIMATOR_BIN="$dir/ad"
        break
    fi
done
if [[ -z "$ANIMATOR_BIN" ]]; then
    echo "ad_session: animator (ad) not found" >&2; exit 1
fi

# Relative path from session dir to animator
ANIMATOR_REL=$(python3 -c "import os; print(os.path.relpath('$ANIMATOR_BIN', '$SESSION_DIR'))")

VIM_SYNTAX="$SCRIPT_DIR/vim/ad_ops_syntax.vim"
VIM_SESSION="$SCRIPT_DIR/vim/ad_session.vim"

# --- Launch vim ---
# Write a vim init script that sets variables, then source both scripts.
VIM_INIT="$SESSION_DIR/.ad_init.vim"
LAYER_FILE_BASE=""
if [[ -n "$LAYER_FILE" && -f "$LAYER_FILE" ]]; then
    LAYER_FILE_BASE=$(basename "$LAYER_FILE")
fi
# Resolve ad_gen_ops relative path
GEN_OPS_BIN=""
for dir in "$ROOT/bin" "$ROOT/scripts"; do
    if [[ -x "$dir/ad_gen_ops" ]]; then
        GEN_OPS_BIN="$dir/ad_gen_ops"
        break
    fi
done
GEN_OPS_REL=""
if [[ -n "$GEN_OPS_BIN" ]]; then
    GEN_OPS_REL=$(python3 -c "import os; print(os.path.relpath('$GEN_OPS_BIN', '$SESSION_DIR'))")
fi

cat > "$VIM_INIT" <<VIMINIT
let g:ad_session_dir='$SESSION_DIR'
let g:ad_old_file='$OLD_BASE'
let g:ad_new_file='$NEW_BASE'
let g:ad_ops_file='$OP_BASE'
let g:ad_result_file='$RESULT_BASE'
let g:ad_animator='$ANIMATOR_REL'
let g:ad_gen_ops='$GEN_OPS_REL'
let g:ad_fold_context=$FOLD_CONTEXT
let g:ad_fold_hunks=$FOLD_HUNKS
let g:ad_layer_file='$LAYER_FILE_BASE'
VIMINIT

cd "$SESSION_DIR"

# Build tab commands
VIM_TABS="-c \"tabnew $OLD_BASE\" -c \"tabnew $NEW_BASE\""
if [[ -n "$LAYER_FILE_BASE" ]]; then
    VIM_TABS="$VIM_TABS -c \"tabnew $LAYER_FILE_BASE\""
fi

eval exec vim -S "\"$VIM_INIT\"" -S "\"$VIM_SYNTAX\"" -S "\"$VIM_SESSION\"" "\"$OP_BASE\"" $VIM_TABS -c \"tabfirst\"
