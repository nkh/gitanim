#!/usr/bin/env bash
# ad_tmux_watch — Session-based interactive op debugger (tmux version).
#
# Creates a session directory in the project, copies old/new files,
# generates ops, initializes a git repo, and launches tmux with
# ad_watch + vim.
#
# Usage:
#   ad_tmux_watch <oldfile> <newfile> [opfile] [--ad-layer=<name>]...
#   ad_tmux_watch --resume <session_dir>
#   ad_tmux_watch --resume-latest
#   ad_tmux_watch --list-sessions
#
# Examples:
#   ad_tmux_watch old.py new.py --ad-layer=ad_layer_reorder
#   ad_tmux_watch old.py new.py existing_ops.tsv
#   ad_tmux_watch --session-name bug42 old.py new.py
#   ad_tmux_watch --resume-latest

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SESSIONS_DIR="$ROOT/ad_sessions"

show_help() {
    cat <<'HELP'
ad_tmux_watch — Session-based interactive op debugger (tmux version).

USAGE
    ad_tmux_watch <oldfile> <newfile> [opfile] [options]
    ad_tmux_watch --resume <session_dir>
    ad_tmux_watch --resume-latest
    ad_tmux_watch --list-sessions

DESCRIPTION
    Creates a session directory under ad_sessions/ in the project root.
    Copies old/new files, generates ops (if not provided), initializes a
    git repo, and launches tmux with:
      Left pane:  ad_watch (auto-refreshes on save)
      Right pane: vim with 3 tabs (ops, old, new) + syntax highlighting

    Sessions persist in the project directory (not /tmp).

OPTIONS
    --help, -h                Show this help and exit
    --ad-layer=<name>         Layer(s) for ad_gen_ops (if generating ops)
    --ad-layer-path=<dir>     Add a directory to the layer search path
    --session-name=<name>     Custom session directory name
    --resume=<path>           Resume existing session
    --resume-latest           Resume most recent session
    --list-sessions           List sessions and exit
    --no-generate             Don't generate ops if opfile missing
    --show-delays             Keep delay ops in ad_watch
    --show-decorations        Keep decoration ops in ad_watch
    --fold-context=<N>        Context lines around non-keep ops (default: 5)
    --fold-hunks              Start with all hunks folded

EXAMPLES
    # New session with generated ops
    ad_tmux_watch old.py new.py --ad-layer=ad_layer_reorder

    # New session with existing ops
    ad_tmux_watch old.py new.py my_ops.tsv

    # Custom session name
    ad_tmux_watch old.py new.py --session-name bug42

    # Resume latest session
    ad_tmux_watch --resume-latest

    # List all sessions
    ad_tmux_watch --list-sessions

SEE ALSO
    ad_session — vim-only version (no tmux required)
    ad_watch — display script
    ad_gen_ops — generates op file
HELP
}

# --- Parse args ---
OLD_FILE=""
NEW_FILE=""
OP_FILE=""
GEN_OPS_ARGS=()
WATCH_ARGS=()
NO_GENERATE=0
SESSION_NAME=""
RESUME_DIR=""
RESUME_LATEST=0
LIST_SESSIONS=0
FOLD_CONTEXT=5
FOLD_HUNKS=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h) show_help; exit 0 ;;
        --no-generate) NO_GENERATE=1; shift ;;
        --show-delays) WATCH_ARGS+=("--show-delays"); shift ;;
        --show-decorations) WATCH_ARGS+=("--show-decorations"); shift ;;
        --ad-layer=*) GEN_OPS_ARGS+=("$1"); shift ;;
        --ad-layer) GEN_OPS_ARGS+=("$1" "$2"); shift 2 ;;
        --ad-layer-path=*) GEN_OPS_ARGS+=("$1"); shift ;;
        --ad-layer-path) GEN_OPS_ARGS+=("$1" "$2"); shift 2 ;;
        --session-name=*) SESSION_NAME="${1#--session-name=}"; shift ;;
        --session-name) SESSION_NAME="$2"; shift 2 ;;
        --resume=*) RESUME_DIR="${1#--resume=}"; shift ;;
        --resume) RESUME_DIR="$2"; shift 2 ;;
        --resume-latest) RESUME_LATEST=1; shift ;;
        --list-sessions) LIST_SESSIONS=1; shift ;;
        --fold-context=*) FOLD_CONTEXT="${1#--fold-context=}"; shift ;;
        --fold-hunks) FOLD_HUNKS=1; shift ;;
        --*) echo "ad_tmux_watch: unknown option: $1" >&2; exit 1 ;;
        *)
            if [[ -z "$OLD_FILE" ]]; then OLD_FILE="$1"
            elif [[ -z "$NEW_FILE" ]]; then NEW_FILE="$1"
            elif [[ -z "$OP_FILE" ]]; then OP_FILE="$1"
            else echo "ad_tmux_watch: unexpected argument: $1" >&2; exit 1
            fi
            shift ;;
    esac
done

# --- List sessions ---
if [[ $LIST_SESSIONS -eq 1 ]]; then
    if [[ ! -d "$SESSIONS_DIR" ]]; then
        echo "No sessions found." ; exit 0
    fi
    echo "Sessions in $SESSIONS_DIR:"
    for d in "$SESSIONS_DIR"/*/; do
        [[ -d "$d" ]] || continue
        name=$(basename "$d")
        mtime=$(stat -c %Y "$d" 2>/dev/null || echo 0)
        mdate=$(date -d @"$mtime" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "?")
        git_status="clean"
        if (cd "$d" && git diff --quiet 2>/dev/null && git diff --cached --quiet 2>/dev/null); then
            :
        else
            git_status="dirty"
        fi
        printf "  %-30s  %s  %s\n" "$name" "$mdate" "$git_status"
    done
    exit 0
fi

# --- Resume ---
if [[ -n "$RESUME_DIR" || $RESUME_LATEST -eq 1 ]]; then
    if [[ $RESUME_LATEST -eq 1 ]]; then
        if [[ ! -d "$SESSIONS_DIR" ]]; then
            echo "ad_tmux_watch: no sessions found" >&2; exit 1
        fi
        RESUME_DIR=$(ls -td "$SESSIONS_DIR"/*/ 2>/dev/null | head -1)
        if [[ -z "$RESUME_DIR" ]]; then
            echo "ad_tmux_watch: no sessions found" >&2; exit 1
        fi
        RESUME_DIR="${RESUME_DIR%/}"
    fi
    # Resolve to absolute
    RESUME_DIR=$(cd "$RESUME_DIR" && pwd)
    if [[ ! -d "$RESUME_DIR" ]]; then
        echo "ad_tmux_watch: session not found: $RESUME_DIR" >&2; exit 1
    fi
    # Find old/new/ops in session dir
    OLD_FILE=$(ls "$RESUME_DIR"/old.* 2>/dev/null | head -1)
    NEW_FILE=$(ls "$RESUME_DIR"/new.* 2>/dev/null | head -1)
    OP_FILE="$RESUME_DIR/ops.tsv"
    if [[ -z "$OLD_FILE" || -z "$NEW_FILE" ]]; then
        echo "ad_tmux_watch: session missing old/new files: $RESUME_DIR" >&2; exit 1
    fi
    SESSION_DIR="$RESUME_DIR"
    echo "ad_tmux_watch: resuming session: $SESSION_DIR" >&2
else
    # --- Create new session ---
    if [[ -z "$OLD_FILE" || -z "$NEW_FILE" ]]; then
        show_help; exit 1
    fi
    if [[ ! -f "$OLD_FILE" ]]; then
        echo "ad_tmux_watch: old file not found: $OLD_FILE" >&2; exit 1
    fi
    if [[ ! -f "$NEW_FILE" ]]; then
        echo "ad_tmux_watch: new file not found: $NEW_FILE" >&2; exit 1
    fi

    # Resolve old/new to absolute
    OLD_FILE=$(cd "$(dirname "$OLD_FILE")" && pwd)/$(basename "$OLD_FILE")
    NEW_FILE=$(cd "$(dirname "$NEW_FILE")" && pwd)/$(basename "$NEW_FILE")

    # Generate session directory name
    if [[ -n "$SESSION_NAME" ]]; then
        SESSION_DIR="$SESSIONS_DIR/$SESSION_NAME"
    else
        local_basename=$(basename "$OLD_FILE")
        local_basename="${local_basename%.*}"
        timestamp=$(date '+%Y%m%d_%H%M%S')
        SESSION_DIR="$SESSIONS_DIR/${local_basename}_$timestamp"
    fi

    mkdir -p "$SESSION_DIR"

    # Copy old/new into session
    old_ext="${OLD_FILE##*.}"
    new_ext="${NEW_FILE##*.}"
    cp "$OLD_FILE" "$SESSION_DIR/old.$old_ext"
    cp "$NEW_FILE" "$SESSION_DIR/new.$new_ext"
    OLD_FILE="$SESSION_DIR/old.$old_ext"
    NEW_FILE="$SESSION_DIR/new.$new_ext"

    # Ops file
    if [[ -n "$OP_FILE" && -f "$OP_FILE" ]]; then
        cp "$OP_FILE" "$SESSION_DIR/ops.tsv"
        echo "ad_tmux_watch: copied ops from $OP_FILE" >&2
    elif [[ $NO_GENERATE -eq 0 ]]; then
        echo "ad_tmux_watch: generating ops..." >&2
        "$SCRIPT_DIR/ad_gen_ops" "$OLD_FILE" "$NEW_FILE" "${GEN_OPS_ARGS[@]}" > "$SESSION_DIR/ops.tsv"
        echo "ad_tmux_watch: generated ops ($(wc -l < "$SESSION_DIR/ops.tsv") lines)" >&2
    else
        echo "ad_tmux_watch: no ops file and --no-generate given" >&2; exit 1
    fi
    OP_FILE="$SESSION_DIR/ops.tsv"

    # Git init
    (cd "$SESSION_DIR" && git init -q 2>/dev/null && git add -A && git commit -q -m "Initial session" 2>/dev/null) || true

    # Create resume.sh
    cat > "$SESSION_DIR/resume.sh" <<RESUME
#!/usr/bin/env bash
cd "$SESSION_DIR"
exec "$SCRIPT_DIR/ad_tmux_watch" --resume "$SESSION_DIR"
RESUME
    chmod +x "$SESSION_DIR/resume.sh"

    # Add ad_sessions/ to .gitignore
    if ! grep -q '^ad_sessions/' "$ROOT/.gitignore" 2>/dev/null; then
        echo "ad_sessions/" >> "$ROOT/.gitignore"
    fi

    echo "ad_tmux_watch: session created: $SESSION_DIR" >&2
fi

# --- Check tmux ---
if ! command -v tmux &>/dev/null; then
    echo "ad_tmux_watch: tmux is not installed" >&2; exit 1
fi
if [[ -z "${TMUX:-}" ]]; then
    echo "ad_tmux_watch: must be run inside a tmux session" >&2
    echo "  Start tmux first: tmux" >&2; exit 1
fi

# --- Launch ---
VIM_SYNTAX="$SCRIPT_DIR/vim/ad_ops_syntax.vim"

# Build vim fold args
VIM_FOLD_ARGS=""
if [[ $FOLD_HUNKS -eq 1 ]]; then
    VIM_FOLD_ARGS="$VIM_FOLD_ARGS -c \"let g:ad_fold_hunks=1\""
fi
VIM_FOLD_ARGS="$VIM_FOLD_ARGS -c \"let g:ad_fold_context=$FOLD_CONTEXT\""

# Build ad_watch command
WATCH_CMD="$SCRIPT_DIR/ad_watch"
if [[ ${#WATCH_ARGS[@]} -gt 0 ]]; then
    WATCH_CMD="$WATCH_CMD ${WATCH_ARGS[*]}"
fi
WATCH_CMD="$WATCH_CMD \"$OLD_FILE\" \"$NEW_FILE\" \"$OP_FILE\""

# Build vim command — 3 tabs: ops (default), old, new
VIM_CMD="vim -S \"$VIM_SYNTAX\" \"$OP_FILE\" $VIM_FOLD_ARGS -c \"tabnew $OLD_FILE\" -c \"tabnew $NEW_FILE\" -c \"tabfirst\""

# Create tmux window with vertical split
tmux new-window -n "ad_session" "cd '$SESSION_DIR' && $WATCH_CMD"
tmux split-window -h -t "{left}" "cd '$SESSION_DIR' && $VIM_CMD"
tmux select-pane -t "{right}"

echo "" >&2
echo "ad_tmux_watch: launched" >&2
echo "  Session:  $SESSION_DIR" >&2
echo "  Left:     ad_watch (auto-refresh on save)" >&2
echo "  Right:    vim (ops | old | new tabs)" >&2
echo "  Resume:   bash $SESSION_DIR/resume.sh" >&2
