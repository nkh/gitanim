#!/usr/bin/env bash
# set_config — Source this script to apply a "balanced" set of diffvim
# timing environment variables. Useful for previews and demos where the
# defaults feel too fast or too slow.
#
# Usage:
#   source ./set_config                # apply env vars to current shell
#   ./set_config -h | --help           # print this help
#
# Variables set (all exported):
#   DIFFVIM_TICK_MS=200        Animation frame interval (~5 fps timer)
#   DIFFVIM_TYPE_DELAY_MS=80   Delay between typed characters (ms)
#   DIFFVIM_DELETE_DELAY_MS=80 Delay between deleted characters (ms)
#   DIFFVIM_MOVE_MIN_MS=100    Minimum cursor-glide duration (ms)
#   DIFFVIM_MOVE_MAX_MS=1500   Maximum cursor-glide duration (ms)
#   DIFFVIM_MOVE_MS_PER_UNIT=6 Milliseconds per unit of glide distance
#   DIFFVIM_HUNK_PAUSE_MS=200  Pause between hunks (ms)
#
# Options:
#   -h, --help    Show this help and exit.
#
# Note: this script must be SOURCED (`source ./set_config`) to actually
# export the variables into your shell. Running it directly only prints
# the values.

# Handle -h / --help
for arg in "$@"; do
    case "$arg" in
        -h|--help)
            sed -n '2,24p' "$0"
            exit 0
            ;;
    esac
done

export DIFFVIM_TICK_MS=200        # Animation frame interval (~60fps)
export DIFFVIM_TYPE_DELAY_MS=80   # Delay between typed characters (ms)
export DIFFVIM_DELETE_DELAY_MS=80 # Delay between deleted characters (ms)
export DIFFVIM_MOVE_MIN_MS=100    # Minimum cursor-glide duration (ms)
export DIFFVIM_MOVE_MAX_MS=1500   # Maximum cursor-glide duration (ms)
export DIFFVIM_MOVE_MS_PER_UNIT=6 # Milliseconds per unit of glide distance
export DIFFVIM_HUNK_PAUSE_MS=200  # Pause between hunks (ms)

# When sourced, print the values so the user can confirm. When executed
# directly, print them too (so `./set_config` is informative).
echo "diffvim timing env vars set:"
echo "  DIFFVIM_TICK_MS=$DIFFVIM_TICK_MS"
echo "  DIFFVIM_TYPE_DELAY_MS=$DIFFVIM_TYPE_DELAY_MS"
echo "  DIFFVIM_DELETE_DELAY_MS=$DIFFVIM_DELETE_DELAY_MS"
echo "  DIFFVIM_MOVE_MIN_MS=$DIFFVIM_MOVE_MIN_MS"
echo "  DIFFVIM_MOVE_MAX_MS=$DIFFVIM_MOVE_MAX_MS"
echo "  DIFFVIM_MOVE_MS_PER_UNIT=$DIFFVIM_MOVE_MS_PER_UNIT"
echo "  DIFFVIM_HUNK_PAUSE_MS=$DIFFVIM_HUNK_PAUSE_MS"
