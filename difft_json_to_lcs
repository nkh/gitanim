#!/bin/env perl
# difft_json_to_lcs — Read difftastic JSON (or the HUNK/DEL/ADD/CTX text
# format produced by jq_filter) on stdin and emit the longest common
# subsequence of unchanged "context" lines from the OLD side, joined
# into a single string. diffvim uses this LCS as the diff backbone.
#
# Usage:
#   difft --json old new | difft_json_to_lcs
#   difft --json old new | jq_filter | difft_json_to_lcs   # also accepts text format
#   difft_json_to_lcs -h | --help
#
# Options:
#   -h, --help    Show this help and exit.

use strict;
use warnings;

# Handle -h / --help before reading stdin.
for my $arg (@ARGV) {
    if ($arg eq '-h' || $arg eq '--help') {
        # Print the comment header (lines 2-13 of this file).
        open my $self, '<', $0 or die "cannot open $0: $!";
        my @lines = <$self>;
        close $self;
        for my $i (1..14) { print $lines[$i-1] if defined $lines[$i-1]; }
        exit 0;
    }
}

# Detect input format: JSON starts with '{' or '[', otherwise treat as
# the HUNK/DEL/ADD/CTX text format from jq_filter.
my $first = do { local $/; <STDIN> };
my @lcs;

if ($first =~ /^\s*[\{\[]/s) {
    # JSON mode
    require JSON::PP;
    my $json = JSON::PP::decode_json($first);
    for my $file (@{$json->{files}}) {
        for my $hunk (@{$file->{hunks}}) {
            for my $line (@{$hunk->{lines}}) {
                push @lcs, $line->{old} if $line->{type} eq 'context';
            }
        }
    }
} else {
    # Text mode: lines like "CTX <oldNum> <newNum> <content>"
    for my $line (split /\n/, $first) {
        if ($line =~ /^CTX\s+\d+\s+\d+\s+(.*)$/) {
            push @lcs, "$1\n";
        }
    }
}

print join("", @lcs), "\n";
