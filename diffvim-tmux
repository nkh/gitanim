#!/usr/bin/env bash
# diffvim-tmux - Animate a code diff as if a human were typing it.
#
# Architecture:
#   - Bash is the orchestrator: computes the diff, manages animation state,
#     handles user input, controls timing.
#   - Vim runs in a tmux pane and displays the buffer + cursor.
#   - Bash sends Ex commands to vim via `tmux send-keys`.
#   - Vim normal-mode mappings write user commands (p/n/b/q/+/=) to a FIFO.
#   - Bash reads the FIFO (non-blocking) between animation steps.
#
# The cursor glides between change locations with ease-in-out acceleration.
# Only the actually-changed characters are deleted and re-typed; surrounding
# text is left untouched (no whole-line rewrites).
#
# Usage:
#   diffvim-tmux [options] <oldfile> <newfile>
#   diffvim-tmux [options] --multi <old1:new1> <old2:new2> ...
#   diffvim-tmux [options] --replay <file> [--from REV] [--to REV]
#
# Options:
#   --speed N                Speed multiplier (0.5=half, 1=normal, 2=double)
#   --output FILE            Write result to FILE after animation
#   --context N              Fold unchanged regions >2N lines, keep N context
#   --max-hunk-chars N       Skip char-by-char for hunks > N changed chars
#   --max-word-chars N       Type short words (<= N chars) instantly
#   --word-pause-ms N        Pause after instant word (default: 150)
#   --scroll zz|zt|zb|none   Cursor scroll position (default: none)
#   --multi                  Treat args as old:new pairs for multi-file
#   --replay                 Animate git history for given file(s)
#   --from REV               Git rev to start replay from (default: HEAD~5)
#   --to REV                 Git rev to end replay at (default: HEAD)
#   --dry-run                Show diff hunk info without launching vim/tmux
#   --word-diff              Enable word-level diff highlighting in engine
#   --step-mode              Pause after each step; Space advances one step
#   --adaptive-timing        Slow down in complex regions (more changes nearby)
#   --sign-column            Show signs in the sign column at hunk locations
#   --git-blame              Show git blame for target line before each hunk
#   --git-rev REV..REV       Shorthand for --replay --from REV --to REV
#   --max-line-len N         Warn if any file has lines longer than N chars
#   --version, -V            Print version and exit
#   --help, -h               Show help
#
# Controls (in vim, during animation):
#   <Space>  pause / resume
#   n        skip current hunk (apply instantly, move to next)
#   b        back to previous hunk (revert and restart)
#   q        stop animation (leave buffer for editing)
#   +        speed up (multiply speed by 1.5)
#   -        slow down (divide speed by 1.5)
#   =        reset speed to 1.0
#
# Requires: bash 4+, tmux 3+, vim 8+, diff, sed, awk. No Python.

set -euo pipefail

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
abs_path() {
    local path="$1"
    local dir base
    dir="$(dirname "$path")"
    base="$(basename "$path")"
    [[ -z "$dir" ]] && dir="."
    local abs_dir
    if [[ "$dir" == /* ]]; then
        abs_dir="$dir"
    else
        abs_dir="$(pwd)/$dir"
    fi
    printf '%s/%s' "$abs_dir" "$base"
}

show_help() {
    cat >&2 <<USAGE
Usage: $(basename "$0") [options] <oldfile> <newfile>
       $(basename "$0") [options] --multi <old1:new1> <old2:new2> ...
       $(basename "$0") [options] --replay <file> [--from REV] [--to REV]

Animate a code diff in vim (inside a tmux pane), as if a human were typing it.

Options:
  --speed N                Speed multiplier: 0.5=half speed, 2=double, 5=5x
  --output FILE            Write result to FILE after animation, then quit
  --context N              Fold unchanged regions >2N lines, keep N context lines
  --max-hunk-chars N       If a hunk has >N changed chars, apply instantly
  --max-word-chars N       Type words <=N chars instantly, pause after
  --word-pause-ms N        Pause after instant word (default: 150)
  --scroll zz|zt|zb|none   Scroll cursor to center/top/bottom/none (default: none)
  --multi                  Treat args as old:new pairs for multi-file animation
  --replay                 Animate git history for given file(s)
  --from REV               Git rev to start replay from (default: HEAD~5)
  --to REV                 Git rev to end replay at (default: HEAD)
  --dry-run                Show diff hunk info without launching vim/tmux
  --word-diff              Enable word-level diff highlighting in the engine
  --step-mode              Pause after each step; Space advances one step
  --adaptive-timing        Slow down in complex regions (more changes nearby)
  --sign-column            Show signs in the sign column at hunk locations
  --git-blame              Show git blame for target line before each hunk
  --git-rev REV..REV       Shorthand for --replay --from REV --to REV
  --max-line-len N         Warn if any file has lines longer than N chars
  --version, -V            Print version and exit
  --help, -h               Show this help

Controls (during animation, in vim normal mode):
  <Space>  pause / resume  (in --step-mode: advance one step)
  n        skip current hunk (apply instantly)
  b        back to previous hunk (revert and restart)
  q        stop animation (leave buffer for editing)
  +        speed up (x1.5)
  -        slow down (x0.67)
  =        reset speed to 1.0

Environment variables:
  DIFFVIM_TICK_MS, DIFFVIM_TYPE_DELAY_MS, DIFFVIM_DELETE_DELAY_MS,
  DIFFVIM_MOVE_MIN_MS, DIFFVIM_MOVE_MAX_MS, DIFFVIM_MOVE_MS_PER_UNIT,
  DIFFVIM_HUNK_PAUSE_MS, DIFFVIM_WORD_PAUSE_MS, DIFFVIM_SPEED
  Feature flags (set by CLI flags, read by the engine vimscript):
  DIFFVIM_WORD_DIFF, DIFFVIM_STEP_MODE, DIFFVIM_ADAPTIVE_TIMING,
  DIFFVIM_SIGN_COLUMN, DIFFVIM_GIT_BLAME
USAGE
}

# ---------------------------------------------------------------------------
# CLI options (default values; env vars may override)
# ---------------------------------------------------------------------------
SPEED_MULT="${DIFFVIM_SPEED:-1.0}"
OUTPUT_FILE=""
CONTEXT_LINES=0
MAX_HUNK_CHARS=0
MAX_WORD_CHARS=0
SCROLL_MODE="none"
MULTI_MODE=0
REPLAY_MODE=0
REPLAY_FROM="HEAD~5"
REPLAY_TO="HEAD"
HELP_FLAG=0
VERSION_FLAG=0
DRY_RUN=0
WORD_DIFF=0
STEP_MODE=0
ADAPTIVE_TIMING=0
SIGN_COLUMN=0
GIT_BLAME=0
GIT_REV_ARG=""
MAX_LINE_LEN=0

# Parse options with getopt (util-linux enhanced getopt supports long options).
PARSED=$(getopt -o hV \
    --long help,version,speed:,output:,context:,max-hunk-chars:,max-word-chars:,word-pause-ms:,scroll:,multi,replay,from:,to:,dry-run,word-diff,step-mode,adaptive-timing,sign-column,git-blame,git-rev:,max-line-len: \
    -n "$(basename "$0")" -- "$@") || {
    echo "Run '$(basename "$0") --help' for details." >&2
    exit 1
}
eval set -- "$PARSED"

while true; do
    case "$1" in
        --help|-h)        HELP_FLAG=1; shift ;;
        --speed)          SPEED_MULT="$2"; shift 2 ;;
        --output)         OUTPUT_FILE="$2"; shift 2 ;;
        --context)        CONTEXT_LINES="$2"; shift 2 ;;
        --max-hunk-chars) MAX_HUNK_CHARS="$2"; shift 2 ;;
        --max-word-chars) MAX_WORD_CHARS="$2"; shift 2 ;;
        --word-pause-ms)  DIFFVIM_WORD_PAUSE_MS="$2"; shift 2 ;;
        --scroll)         SCROLL_MODE="$2"; shift 2 ;;
        --multi)          MULTI_MODE=1; shift ;;
        --replay)         REPLAY_MODE=1; shift ;;
        --from)           REPLAY_FROM="$2"; shift 2 ;;
        --to)             REPLAY_TO="$2"; shift 2 ;;
        --version|-V)     VERSION_FLAG=1; shift ;;
        --dry-run)        DRY_RUN=1; shift ;;
        --word-diff)      WORD_DIFF=1; shift ;;
        --step-mode)      STEP_MODE=1; shift ;;
        --adaptive-timing) ADAPTIVE_TIMING=1; shift ;;
        --sign-column)    SIGN_COLUMN=1; shift ;;
        --git-blame)      GIT_BLAME=1; shift ;;
        --git-rev)        GIT_REV_ARG="$2"; shift 2 ;;
        --max-line-len)   MAX_LINE_LEN="$2"; shift 2 ;;
        --)               shift; break ;;
        *) echo "Internal error: $1" >&2; exit 1 ;;
    esac
done

if [[ $HELP_FLAG -eq 1 ]]; then
    show_help
    exit 0
fi

if [[ $VERSION_FLAG -eq 1 ]]; then
    echo "diffvim-tmux 1.3.0"
    exit 0
fi

# --git-rev REV..REV: shorthand for --replay --from REV --to REV
if [[ -n "$GIT_REV_ARG" ]]; then
    if [[ "$GIT_REV_ARG" == *..* ]]; then
        REPLAY_FROM="${GIT_REV_ARG%%..*}"
        REPLAY_TO="${GIT_REV_ARG#*..}"
        REPLAY_MODE=1
    else
        echo "diffvim-tmux: Error: --git-rev expects REV..REV syntax (got '$GIT_REV_ARG')" >&2
        exit 1
    fi
fi

# Export feature flags so the engine vimscript can read them via $DIFFVIM_*.
# Empty string when off, "1" when on (so vim's !empty($VAR) works correctly).
export DIFFVIM_WORD_DIFF="$([[ $WORD_DIFF -eq 1 ]] && echo 1)"
export DIFFVIM_STEP_MODE="$([[ $STEP_MODE -eq 1 ]] && echo 1)"
export DIFFVIM_ADAPTIVE_TIMING="$([[ $ADAPTIVE_TIMING -eq 1 ]] && echo 1)"
export DIFFVIM_SIGN_COLUMN="$([[ $SIGN_COLUMN -eq 1 ]] && echo 1)"
export DIFFVIM_GIT_BLAME="$([[ $GIT_BLAME -eq 1 ]] && echo 1)"

# Remaining positional args
POSITIONAL_ARGS=("$@")

# Validate scroll mode
case "$SCROLL_MODE" in
    zz|zt|zb|none) ;;
    *) echo "diffvim-tmux: Error: invalid --scroll value '$SCROLL_MODE' (use zz|zt|zb|none)" >&2; exit 1 ;;
esac

# Resolve file pairs based on mode
FILE_PAIRS=()   # array of "oldfile:newfile" strings

if [[ $REPLAY_MODE -eq 1 ]]; then
    [[ ${#POSITIONAL_ARGS[@]} -ge 1 ]] || { echo "Error: --replay requires at least one file path" >&2; exit 1; }
    command -v git >/dev/null 2>&1 || { echo "Error: 'git' not found in PATH" >&2; exit 1; }
    for file in "${POSITIONAL_ARGS[@]}"; do
        abs="$(abs_path "$file")"
        [[ -f "$abs" ]] || { echo "Error: '$abs' not found" >&2; exit 1; }
        # Get commits in range
        commits=()
        while IFS= read -r line; do
            [[ -n "$line" ]] && commits+=("$line")
        done < <(git log --reverse --format=%H "$REPLAY_FROM..$REPLAY_TO" -- "$abs" 2>/dev/null || true)
        # Prepend the "from" commit itself
        from_commit="$(git rev-parse "$REPLAY_FROM" 2>/dev/null || true)"
        if [[ -n "$from_commit" && ${#commits[@]} -gt 0 ]]; then
            commits=("$from_commit" "${commits[@]}")
        fi
        [[ ${#commits[@]} -gt 0 ]] || { echo "Error: no commits found for '$file' in range $REPLAY_FROM..$REPLAY_TO" >&2; exit 1; }
        for (( i=0; i<${#commits[@]}-1; i++ )); do
            old_tmp="${WORKDIR_REPLAY_PRE:-/tmp}/dv_replay_${commits[$i]}_$(basename "$abs")"
            old_tmp="$(mktemp /tmp/dv_replay_old.XXXXXX)"
            new_tmp="$(mktemp /tmp/dv_replay_new.XXXXXX)"
            git show "${commits[$i]}:$abs" > "$old_tmp" 2>/dev/null || { echo "Error: cannot get '$file' at commit '${commits[$i]}'" >&2; exit 1; }
            git show "${commits[$((i+1))]}:$abs" > "$new_tmp" 2>/dev/null || { echo "Error: cannot get '$file' at commit '${commits[$((i+1))]}'" >&2; exit 1; }
            FILE_PAIRS+=("$old_tmp:$new_tmp")
        done
    done
elif [[ $MULTI_MODE -eq 1 ]]; then
    [[ ${#POSITIONAL_ARGS[@]} -ge 1 ]] || { echo "Error: --multi requires at least one old:new pair" >&2; exit 1; }
    for arg in "${POSITIONAL_ARGS[@]}"; do
        if [[ "$arg" == *:* ]]; then
            old_part="${arg%%:*}"
            new_part="${arg#*:}"
            FILE_PAIRS+=("$(abs_path "$old_part"):$(abs_path "$new_part")")
        else
            echo "Error: '$arg' is not in old:new format" >&2; exit 1
        fi
    done
else
    # Single pair: oldfile newfile
    [[ ${#POSITIONAL_ARGS[@]} -eq 2 ]] || { echo "Usage: $(basename "$0") [options] <oldfile> <newfile>" >&2; echo "  Run '$(basename "$0") --help' for details." >&2; exit 1; }
    FILE_PAIRS+=("$(abs_path "${POSITIONAL_ARGS[0]}"):$(abs_path "${POSITIONAL_ARGS[1]}")")
fi

# Validate all files exist
for pair in "${FILE_PAIRS[@]}"; do
    old_part="${pair%%:*}"
    new_part="${pair#*:}"
    [[ -f "$old_part" ]] || { echo "Error: '$old_part' not found" >&2; exit 1; }
    [[ -f "$new_part" ]] || { echo "Error: '$new_part' not found" >&2; exit 1; }
done

# Binary file detection: reject files containing null bytes.
for pair in "${FILE_PAIRS[@]}"; do
    old_part="${pair%%:*}"
    new_part="${pair#*:}"
    for f in "$old_part" "$new_part"; do
        if LC_ALL=C head -c 8192 "$f" 2>/dev/null | od -An -c | grep -qF '\0'; then
            echo "diffvim-tmux: Error: '$f' contains null bytes (binary file)." >&2
            exit 1
        fi
    done
done

# --max-line-len N: warn if any file has lines longer than N chars.
if [[ $MAX_LINE_LEN -gt 0 ]]; then
    for pair in "${FILE_PAIRS[@]}"; do
        old_part="${pair%%:*}"
        new_part="${pair#*:}"
        for f in "$old_part" "$new_part"; do
            max_observed=$(awk '{ if (length > m) m = length } END { print m+0 }' "$f")
            if [[ $max_observed -gt $MAX_LINE_LEN ]]; then
                echo "diffvim-tmux: Warning: '$f' has lines up to $max_observed chars (limit: $MAX_LINE_LEN)" >&2
            fi
        done
    done
fi

# --dry-run: print diff hunk info and exit without launching vim/tmux.
if [[ $DRY_RUN -eq 1 ]]; then
    for pair in "${FILE_PAIRS[@]}"; do
        old_part="${pair%%:*}"
        new_part="${pair#*:}"
        echo "=== diffvim-tmux dry-run: $old_part -> $new_part ==="
        diff -u "$old_part" "$new_part" || true
        hunk_count=$(diff -u "$old_part" "$new_part" 2>/dev/null | grep -c '^@@' || true)
        echo "--- $hunk_count hunk(s) detected ---"
        echo
    done
    exit 0
fi

for cmd in tmux vim diff sed awk; do
    command -v "$cmd" >/dev/null 2>&1 || {
        echo "diffvim-tmux: Error: '$cmd' not found in PATH. Please install it."
        echo "  tmux: apt install tmux  (or: brew install tmux)"
        echo "  vim:  apt install vim   (or: brew install vim)"
        exit 1
    }
done

# Use C locale for byte-level text handling (consistent diff/sed behavior)
export LC_ALL=C

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
TICK_MS=${DIFFVIM_TICK_MS:-16}
TYPE_DELAY_MS=${DIFFVIM_TYPE_DELAY_MS:-35}
DELETE_DELAY_MS=${DIFFVIM_DELETE_DELAY_MS:-25}
MOVE_MIN_MS=${DIFFVIM_MOVE_MIN_MS:-200}
MOVE_MAX_MS=${DIFFVIM_MOVE_MAX_MS:-1400}
MOVE_MS_PER_UNIT=${DIFFVIM_MOVE_MS_PER_UNIT:-6}
HUNK_PAUSE_MS=${DIFFVIM_HUNK_PAUSE_MS:-180}
WORD_PAUSE_MS=${DIFFVIM_WORD_PAUSE_MS:-150}

# ---------------------------------------------------------------------------
# Apply speed multiplier (divide all *_MS values by SPEED_MULT, min 1ms)
# ---------------------------------------------------------------------------
apply_speed_mult() {
    # awk handles float division
    local m
    m=$(awk "BEGIN { printf \"%.6f\", ($SPEED_MULT > 0 ? 1.0 / $SPEED_MULT : 1.0) }")
    TICK_MS=$(awk "BEGIN { v=int($TICK_MS * $m); if (v<1) v=1; printf \"%d\", v }")
    TYPE_DELAY_MS=$(awk "BEGIN { v=int($TYPE_DELAY_MS * $m); if (v<1) v=1; printf \"%d\", v }")
    DELETE_DELAY_MS=$(awk "BEGIN { v=int($DELETE_DELAY_MS * $m); if (v<1) v=1; printf \"%d\", v }")
    MOVE_MIN_MS=$(awk "BEGIN { v=int($MOVE_MIN_MS * $m); if (v<1) v=1; printf \"%d\", v }")
    MOVE_MAX_MS=$(awk "BEGIN { v=int($MOVE_MAX_MS * $m); if (v<1) v=1; printf \"%d\", v }")
    HUNK_PAUSE_MS=$(awk "BEGIN { v=int($HUNK_PAUSE_MS * $m); if (v<1) v=1; printf \"%d\", v }")
    WORD_PAUSE_MS=$(awk "BEGIN { v=int($WORD_PAUSE_MS * $m); if (v<1) v=1; printf \"%d\", v }")
}
apply_speed_mult

# Precompute base sleep durations (avoid repeated awk calls in the hot loop).
# These are the *base* durations; the animation loop divides by runtime_speed.
TICK_SEC=$(awk "BEGIN { printf \"%.4f\", $TICK_MS / 1000 }")
TYPE_SEC=$(awk "BEGIN { printf \"%.4f\", $TYPE_DELAY_MS / 1000 }")
DELETE_SEC=$(awk "BEGIN { printf \"%.4f\", $DELETE_DELAY_MS / 1000 }")
HUNK_PAUSE_SEC=$(awk "BEGIN { printf \"%.4f\", $HUNK_PAUSE_MS / 1000 }")
WORD_PAUSE_SEC=$(awk "BEGIN { printf \"%.4f\", $WORD_PAUSE_MS / 1000 }")

# Sleep helper: divides a base duration (seconds) by runtime_speed.
sleep_div() {
    # $1 = base duration in seconds (e.g. 0.035)
    sleep $(awk -v b="$1" -v s="$runtime_speed" \
        "BEGIN { r = b / s; if (r < 0.001) r = 0.001; printf \"%.4f\", r }")
}

# Sleep helper: base duration * multiplier / runtime_speed (for --adaptive-timing).
sleep_div_mult() {
    # $1 = base duration in seconds, $2 = multiplier (e.g. 1.5)
    sleep $(awk -v b="$1" -v m="$2" -v s="$runtime_speed" \
        "BEGIN { r = b * m / s; if (r < 0.001) r = 0.001; printf \"%.4f\", r }")
}

# ---------------------------------------------------------------------------
# Workspace
# ---------------------------------------------------------------------------
WORKDIR=$(mktemp -d /tmp/diffvim.XXXXXX)
CTRL_FIFO="$WORKDIR/ctrl.fifo"
ENGINE_VIM="$WORKDIR/engine.vim"
SNAP_DIR="$WORKDIR/snaps"
mkdir -p "$SNAP_DIR"

mkfifo "$CTRL_FIFO"
# Open FIFO read+write so it stays open (prevents EOF when writers close)
exec 3<>"$CTRL_FIFO"

# ---------------------------------------------------------------------------
# State (global, used by animation function)
# ---------------------------------------------------------------------------
SESSION=""
TARGET=""          # tmux target (session:window.pane)
ATTACHED=0         # 1 if we're inside an existing tmux session
ANIM_PID=0
VIM_READY=0

phase="idle"       # idle | moving | typing | done
hunk_idx=0
op_idx=0
cur_l=1
cur_c=1
line_offset=0
paused=0
stopped=0
snap_count=0
pair_idx=0
runtime_speed=1.0

declare -a MOVE_L MOVE_C
MOVE_IDX=0

# Hunk data (parallel arrays)
declare -a HUNK_TARGET HUNK_OPS HUNK_DEL HUNK_INS HUNK_END_INS HUNK_END_DEL
HUNK_COUNT=0

# Snapshot metadata
declare -a SNAP_CUR_L SNAP_CUR_C SNAP_OFFSET

# Buffer tracking
BUF_LINES=0

# OLD/NEW for current pair (set by animate_pair)
OLD=""
NEW=""

# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------
cleanup() {
    # Kill animation subshell if still running
    if [[ $ANIM_PID -gt 0 ]] && kill -0 "$ANIM_PID" 2>/dev/null; then
        kill "$ANIM_PID" 2>/dev/null || true
        wait "$ANIM_PID" 2>/dev/null || true
    fi
    # Close FIFO fd
    exec 3>&- 2>/dev/null || true
    # Kill tmux session if we created it
    if [[ -n "$SESSION" && "$ATTACHED" -eq 0 ]]; then
        tmux kill-session -t "$SESSION" 2>/dev/null || true
    fi
    # Clean temp files
    rm -rf "$WORKDIR"
}
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------------------
# Vimscript engine (loaded into vim at startup)
# ---------------------------------------------------------------------------
write_engine() {
    cat > "$ENGINE_VIM" <<VIMEOF
" diffvim engine - buffer manipulation helpers driven by bash via tmux.

let g:dv_ctrl = '$CTRL_FIFO'
let g:dv_scroll = '$SCROLL_MODE'

" Feature flags read from the environment (set by bash CLI options).
" Empty string = off, "1" = on; use !empty($VAR) to test.
let g:dv_word_diff = \$DIFFVIM_WORD_DIFF
let g:dv_step_mode = \$DIFFVIM_STEP_MODE
let g:dv_adaptive_timing = \$DIFFVIM_ADAPTIVE_TIMING
let g:dv_sign_column = \$DIFFVIM_SIGN_COLUMN
let g:dv_git_blame = \$DIFFVIM_GIT_BLAME

" --sign-column: define signs and keep the sign column visible.
if !empty(g:dv_sign_column)
    sign define dv_changed text=>> texthl=Search linehl=Search
    sign define dv_added   text=+> texthl=DiffAdd linehl=DiffAdd
    sign define dv_deleted text=-> texthl=DiffDelete linehl=DiffDelete
    set signcolumn=yes
endif

" Logical cursor position (can exceed line length for "past end" state).
" Vim's real cursor (normal mode) is clamped to len(line); we track the
" logical position separately so insert/delete at end-of-line works.
let s:dv_l = 1
let s:dv_c = 1

function! s:DvPlace() abort
    let l = s:dv_l
    if l < 1 | let l = 1 | endif
    if l > line('\$') | let l = line('\$') | endif
    let len = len(getline(l))
    let c = s:dv_c
    if c > len + 1 | let c = len + 1 | endif
    if c < 1 | let c = 1 | endif
    call cursor(l, c)
    if g:dv_scroll ==# 'zz'
        normal! zz
    elseif g:dv_scroll ==# 'zt'
        normal! zt
    elseif g:dv_scroll ==# 'zb'
        normal! zb
    endif
endfunction

function! DvSetPos(l, c) abort
    let s:dv_l = a:l
    let s:dv_c = a:c
    call s:DvPlace()
endfunction

function! DvKeep(code) abort
    if a:code == 10
        let s:dv_l += 1
        if s:dv_l > line('\$') | let s:dv_l = line('\$') | endif
        let s:dv_c = 1
    else
        let s:dv_c += 1
    endif
    call s:DvPlace()
endfunction

function! DvInsert(code) abort
    let line = getline(s:dv_l)
    let before = strpart(line, 0, s:dv_c - 1)
    let after = strpart(line, s:dv_c - 1)
    if a:code == 10
        call setline(s:dv_l, before)
        call append(s:dv_l, after)
        let s:dv_l += 1
        let s:dv_c = 1
    else
        call setline(s:dv_l, before . nr2char(a:code) . after)
        let s:dv_c += 1
    endif
    call s:DvPlace()
endfunction

function! DvInsertBatch(codes) abort
    for code in a:codes
        call DvInsert(code)
    endfor
endfunction

function! DvDelete() abort
    let line = getline(s:dv_l)
    let line_len = len(line)
    if s:dv_c > line_len
        if s:dv_l < line('\$')
            let next = getline(s:dv_l + 1)
            call setline(s:dv_l, line . next)
            execute (s:dv_l + 1) . 'delete _'
        endif
    else
        let before = strpart(line, 0, s:dv_c - 1)
        let after = strpart(line, s:dv_c)
        call setline(s:dv_l, before . after)
    endif
    call s:DvPlace()
endfunction

function! DvSaveSnap(path) abort
    call writefile(getline(1, '\$'), a:path)
endfunction

function! DvLoadSnap(path) abort
    silent %delete _
    let lines = readfile(a:path)
    if empty(lines)
        call setline(1, '')
    else
        call setline(1, lines)
    endif
    redraw
endfunction

" Get the end-of-line position for a given line (for move targets).
function! DvGetEol(l) abort
    let l = a:l
    if l < 1 | let l = 1 | endif
    if l > line('\$') | let l = line('\$') | endif
    return l . ' ' . (len(getline(l)) + 1)
endfunction

" Get the last line number.
function! DvGetLastLine() abort
    return line('\$')
endfunction

" Write a value to a file (for bash to read).
function! DvReport(expr, path) abort
    call writefile([string(eval(a:expr))], a:path)
endfunction

" --git-blame: run git blame for a single line and echo the result.
function! DvGitBlame(path, line) abort
    if empty(g:dv_git_blame) | return | endif
    if !executable('git') | return | endif
    let l:cmd = 'git blame -L ' . shellescape(a:line . ',' . a:line) .
        \ ' -- ' . shellescape(a:path) . ' 2>/dev/null | head -1'
    let l:out = system(l:cmd)
    let l:out = substitute(l:out, '\n\+$', '', '')
    if !empty(l:out)
        echo 'git blame:' l:out
    endif
endfunction

" User input mappings - write single-char commands to the control FIFO.
if !empty(g:dv_step_mode)
    nnoremap <buffer> <silent> <Space> :call writefile(['s'], g:dv_ctrl, 'a')<CR>
else
    nnoremap <buffer> <silent> <Space> :call writefile(['p'], g:dv_ctrl, 'a')<CR>
endif
nnoremap <buffer> <silent> n       :call writefile(['n'], g:dv_ctrl, 'a')<CR>
nnoremap <buffer> <silent> b       :call writefile(['b'], g:dv_ctrl, 'a')<CR>
nnoremap <buffer> <silent> q       :call writefile(['q'], g:dv_ctrl, 'a')<CR>
nnoremap <buffer> <silent> +       :call writefile(['+'], g:dv_ctrl, 'a')<CR>
nnoremap <buffer> <silent> -       :call writefile(['-'], g:dv_ctrl, 'a')<CR>
nnoremap <buffer> <silent> =       :call writefile(['='], g:dv_ctrl, 'a')<CR>

" Signal bash when vim exits.
autocmd VimLeave * call writefile(['vimleft'], g:dv_ctrl, 'a')
VIMEOF
}

# ---------------------------------------------------------------------------
# tmux setup
# ---------------------------------------------------------------------------
setup_tmux() {
    local old_file="$1"
    write_engine

    if [[ -n "${TMUX:-}" ]]; then
        # Inside tmux: create a new window in the current session
        ATTACHED=1
        local cur_session
        cur_session=$(tmux display-message -p '#S')
        SESSION="$cur_session"
        tmux new-window -t "$SESSION:" -n diffvim \
            "vim -N -u NONE -c 'source $ENGINE_VIM' '$old_file'"
        TARGET=$(tmux display-message -p -t "$SESSION:" '#{pane_id}')
    else
        # Outside tmux: create a new detached session
        ATTACHED=0
        SESSION="diffvim-$$"
        tmux new-session -d -s "$SESSION" -n main \
            -x "${COLUMNS:-80}" -y "${LINES:-24}" \
            "vim -N -u NONE -c 'source $ENGINE_VIM' '$old_file'"
        TARGET=$(tmux list-panes -t "$SESSION" -F '#{pane_id}' | head -1)
    fi
}

# ---------------------------------------------------------------------------
# Helpers: send Ex commands to vim
# ---------------------------------------------------------------------------
send_ex() {
    # Send an Ex command to vim via tmux send-keys.
    # Uses -l for the command text (literal, no key name lookup),
    # then a separate Enter key.
    tmux send-keys -l -t "$TARGET" ":$1"
    tmux send-keys -t "$TARGET" Enter
}

send_ex_redraw() {
    tmux send-keys -l -t "$TARGET" ":$1 | redraw"
    tmux send-keys -t "$TARGET" Enter
}

# Query vim for a value (writes to a file, bash reads it).
# Usage: query_vim "line('$')" -> prints result
# The expression is passed to vim's eval() inside double quotes, so
# single quotes in the expression (like line('$')) work correctly.
query_vim() {
    local expr="$1"
    local qfile="$WORKDIR/query"
    : > "$qfile"
    # Use double quotes in vim for the expression string, and escape any
    # double quotes inside the expression.
    local escaped_expr="${expr//\"/\\\"}"
    send_ex "call DvReport(\"$escaped_expr\", '$qfile')"
    # Wait for vim to process and write
    local tries=0
    while [[ ! -s "$qfile" && $tries -lt 100 ]]; do
        sleep 0.01
        tries=$((tries + 1))
    done
    # Vim's string() wraps string values in single quotes; strip them.
    local result
    result=$(cat "$qfile")
    # Remove surrounding single quotes if present
    result="${result#\'}"
    result="${result%\'}"
    printf '%s' "$result"
}

# ---------------------------------------------------------------------------
# Diff computation
# ---------------------------------------------------------------------------

# Line-level diff. Output format: K<line> | D<line> | I<line>
line_diff_raw() {
    diff --old-line-format='D%L' --new-line-format='I%L' \
         --unchanged-line-format='K%L' "$OLD" "$NEW" || true
}

# Char-level diff between two strings. Output format: K<char> | D<char> | I<char>
# Newlines in the text are represented as empty lines (empty content after prefix).
char_diff_raw() {
    local old_text="$1" new_text="$2"
    local old_file new_file
    old_file=$(mktemp "$WORKDIR/cd_old.XXXXXX")
    new_file=$(mktemp "$WORKDIR/cd_new.XXXXXX")
    # sed 's/./&\n/g' splits each char onto its own line.
    # Newlines in the text become empty lines (correct representation).
    printf '%s' "$old_text" | sed 's/./&\n/g' > "$old_file"
    printf '%s' "$new_text" | sed 's/./&\n/g' > "$new_file"
    diff --old-line-format='D%L' --new-line-format='I%L' \
         --unchanged-line-format='K%L' "$old_file" "$new_file" || true
    rm -f "$old_file" "$new_file"
}

# Current hunk being built (globals)
declare -a CUR_OLD CUR_NEW
CUR_TARGET=1
CUR_HAS_HUNK=0

build_hunks() {
    HUNK_COUNT=0
    HUNK_TARGET=()
    HUNK_OPS=()
    HUNK_DEL=()
    HUNK_INS=()
    HUNK_END_INS=()
    HUNK_END_DEL=()

    local line_num=0
    local old_line_count
    old_line_count=$(wc -l < "$OLD")
    # Account for file without trailing newline
    if [[ -s "$OLD" ]] && ! tail -c1 "$OLD" | od -An -tx1 | grep -q '0a'; then
        old_line_count=$((old_line_count + 1))
    fi

    CUR_OLD=()
    CUR_NEW=()
    CUR_TARGET=1
    CUR_HAS_HUNK=0

    while IFS= read -r line; do
        local op="${line:0:1}"
        local rest="${line:1}"
        case "$op" in
            K)
                if [[ $CUR_HAS_HUNK -eq 1 ]]; then
                    flush_hunk "$old_line_count"
                fi
                line_num=$((line_num + 1))
                CUR_TARGET=$((line_num + 1))
                ;;
            D)
                if [[ $CUR_HAS_HUNK -eq 0 ]]; then
                    CUR_TARGET=$((line_num + 1))
                    CUR_HAS_HUNK=1
                fi
                CUR_OLD+=("$rest")
                line_num=$((line_num + 1))
                ;;
            I)
                if [[ $CUR_HAS_HUNK -eq 0 ]]; then
                    CUR_TARGET=$((line_num + 1))
                    CUR_HAS_HUNK=1
                fi
                CUR_NEW+=("$rest")
                ;;
        esac
    done < <(line_diff_raw)

    if [[ $CUR_HAS_HUNK -eq 1 ]]; then
        flush_hunk "$old_line_count"
    fi
}

flush_hunk() {
    local old_lc=$1
    local del_count=${#CUR_OLD[@]}
    local ins_count=${#CUR_NEW[@]}

    local old_text="" new_text=""
    if [[ $del_count -gt 0 ]]; then
        old_text=$(printf '%s\n' "${CUR_OLD[@]}")
        old_text="${old_text%$'\n'}"
    fi
    if [[ $ins_count -gt 0 ]]; then
        new_text=$(printf '%s\n' "${CUR_NEW[@]}")
        new_text="${new_text%$'\n'}"
    fi

    local is_end_ins=0 is_end_del=0

    if [[ $del_count -eq 0 ]]; then
        # Pure insertion: need a trailing/leading \n so content becomes
        # a separate line instead of merging into the adjacent line.
        # Exception: if the old file is empty (old_lc == 0), there's no
        # existing line to separate from, so no extra \n is needed.
        old_text=""
        if [[ $old_lc -eq 0 ]]; then
            is_end_ins=0
        elif [[ $CUR_TARGET -gt $old_lc ]]; then
            new_text=$'\n'"$new_text"
            is_end_ins=1
        else
            new_text="$new_text"$'\n'
            is_end_ins=0
        fi
    elif [[ $ins_count -eq 0 ]]; then
        # Pure deletion: need to also remove a \n so the line vanishes.
        new_text=""
        if [[ $((CUR_TARGET + del_count - 1)) -ge $old_lc ]]; then
            old_text=$'\n'"$old_text"
            is_end_del=1
        else
            old_text="$old_text"$'\n'
            is_end_del=0
        fi
    fi

    # Compute char-level diff
    local ops=""
    local cline cop crest code
    while IFS= read -r cline; do
        [[ -z "$cline" ]] && continue
        cop="${cline:0:1}"
        crest="${cline:1}"
        if [[ -z "$crest" ]]; then
            code=10   # newline
        else
            code=$(printf '%d' "'$crest")
        fi
        ops+="${cop}${code};"
    done < <(char_diff_raw "$old_text" "$new_text")

    HUNK_TARGET[$HUNK_COUNT]=$CUR_TARGET
    HUNK_OPS[$HUNK_COUNT]="$ops"
    HUNK_DEL[$HUNK_COUNT]=$del_count
    HUNK_INS[$HUNK_COUNT]=$ins_count
    HUNK_END_INS[$HUNK_COUNT]=$is_end_ins
    HUNK_END_DEL[$HUNK_COUNT]=$is_end_del
    HUNK_COUNT=$((HUNK_COUNT + 1))

    CUR_OLD=()
    CUR_NEW=()
    CUR_HAS_HUNK=0
}

# ---------------------------------------------------------------------------
# Buffer tracking
# ---------------------------------------------------------------------------
init_buffer_lines() {
    BUF_LINES=0
    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
        BUF_LINES=$((BUF_LINES + 1))
    done < "$OLD"
    if [[ $BUF_LINES -lt 1 ]]; then BUF_LINES=1; fi
}

# ---------------------------------------------------------------------------
# Easing and move precomputation
# ---------------------------------------------------------------------------
precompute_move() {
    local sl=$1 sc=$2 el=$3 ec=$4
    local dl=$(( el - sl ))
    local dc=$(( ec - sc ))
    local dist=$(( dl * 80 + dc ))
    # Use absolute value for dist computation safety
    [[ $dist -lt 0 ]] && dist=$((-dist))
    local dur=$(( dist * MOVE_MS_PER_UNIT ))
    [[ $dur -lt $MOVE_MIN_MS ]] && dur=$MOVE_MIN_MS
    [[ $dur -gt $MOVE_MAX_MS ]] && dur=$MOVE_MAX_MS
    local steps=$(( (dur + TICK_MS - 1) / TICK_MS ))
    [[ $steps -lt 1 ]] && steps=1

    # Single awk call computes all intermediate positions with ease-in-out cubic.
    local output
    output=$(awk -v sl="$sl" -v sc="$sc" -v dl="$dl" -v dc="$dc" -v n="$steps" 'BEGIN {
        for (i = 0; i < n; i++) {
            t = (n > 1) ? i / (n - 1) : 1.0
            if (t < 0.5) e = 4.0 * t * t * t
            else { f = -2.0 * t + 2.0; e = 1.0 - (f * f * f) / 2.0 }
            printf "%d %d\n", int(sl + dl * e + 0.5), int(sc + dc * e + 0.5)
        }
    }')

    MOVE_L=()
    MOVE_C=()
    local l c
    while IFS=' ' read -r l c; do
        MOVE_L+=("$l")
        MOVE_C+=("$c")
    done <<< "$output"
    MOVE_IDX=0
}

# ---------------------------------------------------------------------------
# Snapshots
# ---------------------------------------------------------------------------
save_snapshot() {
    send_ex "call DvSaveSnap('$SNAP_DIR/$snap_count')"
    SNAP_CUR_L[$snap_count]=$cur_l
    SNAP_CUR_C[$snap_count]=$cur_c
    SNAP_OFFSET[$snap_count]=$line_offset
    snap_count=$((snap_count + 1))
    # Give vim a moment to write the file
    sleep 0.03
}

restore_snapshot() {
    local idx=$1
    send_ex "call DvLoadSnap('$SNAP_DIR/$idx')"
    cur_l=${SNAP_CUR_L[$idx]}
    cur_c=${SNAP_CUR_C[$idx]}
    line_offset=${SNAP_OFFSET[$idx]}
    send_ex "call DvSetPos($cur_l, $cur_c)"
    # Restore BUF_LINES from the snapshot
    BUF_LINES=$(query_vim "line('$')")
    sleep 0.03
}

# ---------------------------------------------------------------------------
# Progress display
# ---------------------------------------------------------------------------
update_progress() {
    [[ $HUNK_COUNT -eq 0 ]] && return
    local total=$HUNK_COUNT
    local current=$((hunk_idx + 1))
    [[ $current -gt $total ]] && current=$total
    local pct
    pct=$(awk -v c="$current" -v t="$total" 'BEGIN { printf "%d", (t > 0 ? c / t * 100 : 100) }')
    local msg="diffvim: hunk $current/$total ($pct%)"
    if [[ ${#FILE_PAIRS[@]} -gt 1 ]]; then
        msg="$msg | pair $((pair_idx + 1))/${#FILE_PAIRS[@]}"
    fi
    local speed_diff
    speed_diff=$(awk -v s="$runtime_speed" 'BEGIN { printf "%.4f", (s - 1.0) > 0 ? (s - 1.0) : -(s - 1.0) }')
    if awk -v d="$speed_diff" 'BEGIN { exit !(d > 0.01) }'; then
        local spd
        spd=$(awk -v s="$runtime_speed" 'BEGIN { printf "%.1f", s }')
        msg="$msg | speed ${spd}x"
    fi
    [[ $paused -eq 1 ]] && msg="$msg | PAUSED"
    send_ex "echo '$msg'"
}

# ---------------------------------------------------------------------------
# Animation functions
# ---------------------------------------------------------------------------
apply_hunk_instantly() {
    local ops="${HUNK_OPS[$hunk_idx]}"
    local -a parts
    IFS=';' read -ra parts <<< "$ops"
    local i part op code
    for (( i=op_idx; i<${#parts[@]}; i++ )); do
        part="${parts[$i]}"
        [[ -z "$part" ]] && continue
        op="${part:0:1}"
        code="${part:1}"
        case "$op" in
            K) send_ex "call DvKeep($code)" ;;
            D) send_ex "call DvDelete()" ;;
            I) send_ex "call DvInsert($code)" ;;
        esac
    done
    send_ex "redraw"
    line_offset=$(( line_offset + HUNK_INS[$hunk_idx] - HUNK_DEL[$hunk_idx] ))
    BUF_LINES=$(( BUF_LINES + HUNK_INS[$hunk_idx] - HUNK_DEL[$hunk_idx] ))
    hunk_idx=$((hunk_idx + 1))
    phase="idle"
}

start_next_hunk() {
    if [[ $hunk_idx -ge $HUNK_COUNT ]]; then
        phase="done"
        return
    fi

    save_snapshot
    update_progress

    local target=${HUNK_TARGET[$hunk_idx]}
    local target_line=$(( target + line_offset ))
    local end_ins=${HUNK_END_INS[$hunk_idx]}
    local end_del=${HUNK_END_DEL[$hunk_idx]}

    # --git-blame: show git blame for the target line in the OLD file.
    if [[ $GIT_BLAME -eq 1 ]]; then
        local blame_line=$target
        [[ $blame_line -lt 1 ]] && blame_line=1
        local old_vim="${OLD//\'/\'\'}"
        send_ex "call DvGitBlame('$old_vim', $blame_line)"
    fi

    # --sign-column: place a sign at the hunk target line in the buffer.
    if [[ $SIGN_COLUMN -eq 1 ]]; then
        local sign_line=$target_line
        [[ $sign_line -lt 1 ]] && sign_line=1
        local sign_id=$((hunk_idx + 1))
        send_ex "execute 'sign place ' . $sign_id . ' line=' . $sign_line . ' name=dv_changed buffer=' . bufnr('%')"
    fi

    # --max-hunk-chars: if hunk has too many changed chars, apply instantly
    if [[ $MAX_HUNK_CHARS -gt 0 ]]; then
        local ops="${HUNK_OPS[$hunk_idx]}"
        local -a parts
        IFS=';' read -ra parts <<< "$ops"
        local changed=0
        local i part op
        for (( i=0; i<${#parts[@]}; i++ )); do
            part="${parts[$i]}"
            [[ -z "$part" ]] && continue
            op="${part:0:1}"
            [[ "$op" != "K" ]] && changed=$((changed + 1))
        done
        if [[ $changed -gt $MAX_HUNK_CHARS ]]; then
            send_ex "echo 'diffvim: hunk $((hunk_idx + 1)) has $changed changed chars (> $MAX_HUNK_CHARS), applying instantly'"
            op_idx=0
            apply_hunk_instantly
            return
        fi
    fi

    local ml mc

    if [[ $end_ins -eq 1 ]]; then
        # End-of-file insertion: target end of last line
        local pos
        pos=$(query_vim "DvGetEol(line('$'))")
        ml="${pos% *}"
        mc="${pos#* }"
    elif [[ $end_del -eq 1 ]]; then
        # End-of-file deletion: target end of previous line
        local prev=$(( target_line - 1 ))
        [[ $prev -lt 1 ]] && prev=1
        local pos
        pos=$(query_vim "DvGetEol($prev)")
        ml="${pos% *}"
        mc="${pos#* }"
    else
        ml=$target_line
        mc=1
        [[ $ml -lt 1 ]] && ml=1
        local last_line
        last_line=$(query_vim "line('$')")
        [[ -z "$last_line" ]] && last_line=$BUF_LINES
        [[ -n "$last_line" && $ml -gt $last_line ]] && ml=$last_line
    fi

    precompute_move "$cur_l" "$cur_c" "$ml" "$mc"
    phase="moving"
}

move_step() {
    if [[ $MOVE_IDX -ge ${#MOVE_L[@]} ]]; then
        # Move complete
        cur_l=${MOVE_L[-1]}
        cur_c=${MOVE_C[-1]}
        send_ex "call DvSetPos($cur_l, $cur_c)"
        phase="typing"
        op_idx=0
        sleep_div "$HUNK_PAUSE_SEC"
        return
    fi
    cur_l=${MOVE_L[$MOVE_IDX]}
    cur_c=${MOVE_C[$MOVE_IDX]}
    send_ex_redraw "call DvSetPos($cur_l, $cur_c)"
    MOVE_IDX=$((MOVE_IDX + 1))
    sleep_div "$TICK_SEC"
}

# Look ahead from current op_idx to find a "word": contiguous insert or delete ops
# (not mixed) where chars are non-space (code != 10 newline, code != 32 space),
# terminated by a space, newline, op change to keep, or end of ops.
# Returns the length of the word (0 if not a word boundary).
# Reads globals: HUNK_OPS[$hunk_idx], op_idx. Prints length to stdout.
lookahead_word_length() {
    local ops="${HUNK_OPS[$hunk_idx]}"
    local -a parts
    IFS=';' read -ra parts <<< "$ops"
    local n=${#parts[@]}
    [[ $op_idx -ge $n ]] && { printf '0'; return; }
    local first="${parts[$op_idx]}"
    local first_op="${first:0:1}"
    [[ "$first_op" == "K" ]] && { printf '0'; return; }
    local len=0
    local i part op code
    for (( i=op_idx; i<n; i++ )); do
        part="${parts[$i]}"
        [[ -z "$part" ]] && break
        op="${part:0:1}"
        code="${part:1}"
        [[ "$op" != "$first_op" ]] && break
        # Newline (10) or space (32) terminates a word
        [[ "$code" == "10" || "$code" == "32" ]] && break
        len=$((len + 1))
    done
    # Word must be terminated by a space/newline/keep/end to be a "word"
    local end_idx=$((op_idx + len))
    if [[ $end_idx -lt $n ]]; then
        local next_part="${parts[$end_idx]}"
        local next_op="${next_part:0:1}"
        local next_code="${next_part:1}"
        if [[ "$next_op" == "K" || "$next_code" == "10" || "$next_code" == "32" ]]; then
            printf '%d' "$len"
            return
        fi
        printf '0'
        return
    else
        # End of ops
        printf '%d' "$len"
        return
    fi
}

# Apply a whole word instantly. Args: $1=length.
apply_word_instantly() {
    local len=$1
    local ops="${HUNK_OPS[$hunk_idx]}"
    local -a parts
    IFS=';' read -ra parts <<< "$ops"
    local i part op code
    for (( i=op_idx; i<op_idx+len; i++ )); do
        part="${parts[$i]}"
        [[ -z "$part" ]] && continue
        op="${part:0:1}"
        code="${part:1}"
        case "$op" in
            I) send_ex "call DvInsert($code)" ;;
            D) send_ex "call DvDelete()" ;;
        esac
    done
    send_ex "redraw"
}

type_step() {
    local ops="${HUNK_OPS[$hunk_idx]}"

    # Parse the op at op_idx from the semicolon-separated list.
    # Format: "K97;D98;I99;..."
    local -a parts
    IFS=';' read -ra parts <<< "$ops"
    if [[ $op_idx -ge ${#parts[@]} ]]; then
        # Hunk complete
        line_offset=$(( line_offset + HUNK_INS[$hunk_idx] - HUNK_DEL[$hunk_idx] ))
        BUF_LINES=$(( BUF_LINES + HUNK_INS[$hunk_idx] - HUNK_DEL[$hunk_idx] ))
        hunk_idx=$((hunk_idx + 1))
        phase="idle"
        sleep_div "$HUNK_PAUSE_SEC"
        return
    fi

    local found="${parts[$op_idx]}"
    local op="${found:0:1}"
    local code="${found:1}"

    # --max-word-chars: if a contiguous sequence of modified (non-space)
    # characters is LONGER than MAX_WORD_CHARS, apply the whole sequence
    # in one shot with a pause, so the user can read the change.
    # Sequences <= MAX_WORD_CHARS are animated character by character.
    if [[ $MAX_WORD_CHARS -gt 0 && ( "$op" == "I" || "$op" == "D" ) ]]; then
        local word_len
        word_len=$(lookahead_word_length)
        if [[ $word_len -gt $MAX_WORD_CHARS ]]; then
            apply_word_instantly "$word_len"
            op_idx=$((op_idx + word_len))
            sleep_div "$WORD_PAUSE_SEC"
            return
        fi
    fi

    # --adaptive-timing: count non-keep ops in a +/-10 window around the
    # current op and multiply the per-char delay by (1 + complexity * 0.5),
    # so dense change regions animate more deliberately.
    local delay_mult=1.0
    if [[ $ADAPTIVE_TIMING -eq 1 ]]; then
        local total=${#parts[@]}
        local win_start=$((op_idx - 10))
        [[ $win_start -lt 0 ]] && win_start=0
        local win_end=$((op_idx + 10))
        [[ $win_end -ge $total ]] && win_end=$((total - 1))
        local complexity=0
        local j part_j op_j
        for (( j=win_start; j<=win_end; j++ )); do
            part_j="${parts[$j]}"
            [[ -z "$part_j" ]] && continue
            op_j="${part_j:0:1}"
            [[ "$op_j" != "K" ]] && complexity=$((complexity + 1))
        done
        delay_mult=$(awk -v c="$complexity" 'BEGIN { printf "%.4f", 1.0 + c * 0.5 }')
    fi

    case "$op" in
        K)
            send_ex "call DvKeep($code)"
            # Keeps are fast - no visible delay
            sleep 0.001
            ;;
        D)
            send_ex_redraw "call DvDelete()"
            if [[ $ADAPTIVE_TIMING -eq 1 ]]; then
                sleep_div_mult "$DELETE_SEC" "$delay_mult"
            else
                sleep_div "$DELETE_SEC"
            fi
            ;;
        I)
            send_ex_redraw "call DvInsert($code)"
            if [[ $ADAPTIVE_TIMING -eq 1 ]]; then
                sleep_div_mult "$TYPE_SEC" "$delay_mult"
            else
                sleep_div "$TYPE_SEC"
            fi
            ;;
    esac
    op_idx=$((op_idx + 1))
}

# ---------------------------------------------------------------------------
# User input handling
# ---------------------------------------------------------------------------
handle_user_input() {
    local cmd
    # Non-blocking read: drain all pending commands from the FIFO.
    while IFS= read -t 0.001 -u 3 -r cmd; do
        case "$cmd" in
            p)
                paused=$(( 1 - paused ))
                if [[ $paused -eq 1 ]]; then
                    tmux send-keys -l -t "$TARGET" ":echo 'diffvim: PAUSED (Space=resume n=skip b=back q=quit)'" Enter
                else
                    tmux send-keys -l -t "$TARGET" ":echo 'diffvim: resumed'" Enter
                fi
                update_progress
                ;;
            s)
                # Step mode: advance exactly one operation, then re-pause.
                paused=0
                case "$phase" in
                    idle)   start_next_hunk ;;
                    moving) move_step ;;
                    typing) type_step ;;
                esac
                if [[ $STEP_MODE -eq 1 ]]; then
                    paused=1
                fi
                ;;
            n)
                skip_current
                ;;
            b)
                go_back
                ;;
            q)
                stopped=1
                tmux send-keys -l -t "$TARGET" ":echo 'diffvim: animation stopped. Buffer left for editing.'" Enter
                ;;
            +)
                runtime_speed=$(awk -v s="$runtime_speed" 'BEGIN { printf "%.4f", s * 1.5 }')
                local spd
                spd=$(awk -v s="$runtime_speed" 'BEGIN { printf "%.1f", s }')
                tmux send-keys -l -t "$TARGET" ":echo 'diffvim: speed ${spd}x'" Enter
                ;;
            -)
                runtime_speed=$(awk -v s="$runtime_speed" 'BEGIN { printf "%.4f", s / 1.5 }')
                local spd
                spd=$(awk -v s="$runtime_speed" 'BEGIN { printf "%.1f", s }')
                tmux send-keys -l -t "$TARGET" ":echo 'diffvim: speed ${spd}x'" Enter
                ;;
            =)
                runtime_speed=1.0
                tmux send-keys -l -t "$TARGET" ":echo 'diffvim: speed reset to 1.0x'" Enter
                ;;
            vimleft)
                stopped=1
                ;;
        esac
    done
}

skip_current() {
    if [[ $phase == "done" || $phase == "idle" ]]; then return; fi
    paused=0

    if [[ $phase == "moving" ]]; then
        # Jump to end of move
        cur_l=${MOVE_L[-1]}
        cur_c=${MOVE_C[-1]}
        send_ex "call DvSetPos($cur_l, $cur_c)"
        phase="typing"
        op_idx=0
    fi

    if [[ $phase == "typing" ]]; then
        apply_hunk_instantly
    fi
    update_progress
}

go_back() {
    if [[ $hunk_idx -eq 0 && $snap_count -eq 0 ]]; then return; fi

    if [[ $hunk_idx -gt 0 ]]; then
        hunk_idx=$((hunk_idx - 1))
    fi

    # Restore the snapshot taken before this hunk started.
    # Snapshot indices correspond to hunk indices (snapshot N = before hunk N).
    local target_snap=$hunk_idx
    if [[ $target_snap -ge $snap_count ]]; then
        target_snap=$((snap_count - 1))
    fi
    [[ $target_snap -lt 0 ]] && target_snap=0

    restore_snapshot "$target_snap"
    phase="idle"
    op_idx=0
    update_progress
}

# ---------------------------------------------------------------------------
# Animation loop (runs in a background subshell)
# ---------------------------------------------------------------------------
animate() {
    # Wait for vim to be ready
    sleep 0.5

    # Show active config so the user can verify env vars are read
    local config_msg="diffvim config: tick=${TICK_MS}ms type=${TYPE_DELAY_MS}ms del=${DELETE_DELAY_MS}ms move=${MOVE_MIN_MS}-${MOVE_MAX_MS}ms hunk_pause=${HUNK_PAUSE_MS}ms"
    local speed_diff
    speed_diff=$(awk -v s="$runtime_speed" 'BEGIN { printf "%.4f", (s - 1.0) > 0 ? (s - 1.0) : -(s - 1.0) }')
    if awk -v d="$speed_diff" 'BEGIN { exit !(d > 0.01) }'; then
        local spd
        spd=$(awk -v s="$runtime_speed" 'BEGIN { printf "%.1f", s }')
        config_msg="$config_msg speed=${spd}x"
    fi
    [[ "$SCROLL_MODE" != "none" ]] && config_msg="$config_msg scroll=$SCROLL_MODE"
    [[ $MAX_HUNK_CHARS -gt 0 ]] && config_msg="$config_msg max_hunk=$MAX_HUNK_CHARS"
    [[ $MAX_WORD_CHARS -gt 0 ]] && config_msg="$config_msg max_word=$MAX_WORD_CHARS"
    tmux send-keys -l -t "$TARGET" ":echo '$config_msg'" Enter

    # Show help
    tmux send-keys -l -t "$TARGET" ":echo 'diffvim: Space=pause n=skip b=back q=quit +/-=speed | hunk 1/$HUNK_COUNT'" Enter

    # --step-mode: start paused so the user advances with Space one op at a time.
    if [[ $STEP_MODE -eq 1 ]]; then
        paused=1
        tmux send-keys -l -t "$TARGET" ":echo 'diffvim: STEP MODE - press Space to advance (n=skip b=back q=quit)'" Enter
    fi

    # Brief pause so user can see the original
    sleep 0.3

    # Main animation loop
    while [[ $stopped -eq 0 && $phase != "done" ]]; do
        handle_user_input
        if [[ $paused -eq 1 ]]; then
            sleep 0.05
            continue
        fi
        case "$phase" in
            idle)   start_next_hunk ;;
            moving) move_step ;;
            typing) type_step ;;
        esac
    done

    # If --output was specified, write the buffer to the output file.
    # In multi-pair mode, only write on the LAST pair; otherwise vim exits
    # before subsequent pairs can run.
    local is_last_pair=1
    [[ ${#FILE_PAIRS[@]} -gt 1 && $((pair_idx + 1)) -lt ${#FILE_PAIRS[@]} ]] && is_last_pair=0
    if [[ -n "$OUTPUT_FILE" && $stopped -eq 0 && $is_last_pair -eq 1 ]]; then
        send_ex "w! $OUTPUT_FILE"
        sleep 0.5
        send_ex "echo 'diffvim: result written to $OUTPUT_FILE'"
        sleep 1
        send_ex "qa!"
        sleep 0.5
    fi

    # If animation is done but vim is still running, wait for vim exit.
    # (User can continue editing, or :q to exit.)
    # In multi-pair mode (not last pair), skip this wait so the next pair
    # can proceed; the loop above already broke on phase=done.
    if [[ $is_last_pair -eq 1 ]]; then
        while [[ $stopped -eq 0 ]]; do
            if IFS= read -t 0.1 -u 3 -r cmd; then
                case "$cmd" in
                    q)       stopped=1 ;;
                    vimleft) stopped=1 ;;
                    *)       ;;  # ignore other commands
                esac
            fi
        done
    fi
}

# ---------------------------------------------------------------------------
# Animate a single pair (OLD/NEW already set globally)
# ---------------------------------------------------------------------------
animate_pair() {
    # Reset state for this pair
    phase="idle"
    hunk_idx=0
    op_idx=0
    cur_l=1
    cur_c=1
    line_offset=0
    paused=0
    stopped=0
    snap_count=0
    runtime_speed=1.0

    # Reset snapshot arrays
    SNAP_CUR_L=()
    SNAP_CUR_C=()
    SNAP_OFFSET=()

    build_hunks
    init_buffer_lines

    if [[ $HUNK_COUNT -eq 0 ]]; then
        echo "diffvim: pair $((pair_idx + 1))/${#FILE_PAIRS[@]}: files identical, skipping."
        return
    fi

    echo "diffvim: pair $((pair_idx + 1))/${#FILE_PAIRS[@]}: $HUNK_COUNT hunk(s) to animate."

    if [[ $pair_idx -eq 0 ]]; then
        setup_tmux "$OLD"
    else
        # Switch buffer to new file
        send_ex "edit! $OLD"
        sleep 0.5
        local obase nbase
        obase="$(basename "$OLD")"
        nbase="$(basename "$NEW")"
        send_ex "echo 'diffvim: next file: $obase -> $nbase'"
        sleep 1
    fi

    # Run animation (foreground; main handles attach if needed)
    animate
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
    if [[ ${#FILE_PAIRS[@]} -eq 1 ]]; then
        pair_idx=0
        pair="${FILE_PAIRS[0]}"
        OLD="${pair%%:*}"
        NEW="${pair#*:}"
        build_hunks
        init_buffer_lines

        if [[ $HUNK_COUNT -eq 0 ]]; then
            echo "diffvim: files are identical, nothing to animate."
            # Still open vim so the user can see the file
            setup_tmux "$OLD"
            sleep 0.5
            tmux send-keys -l -t "$TARGET" ":echo 'diffvim: files are identical.'" Enter
            if [[ $ATTACHED -eq 0 ]]; then
                tmux attach-session -t "$SESSION"
            fi
            return
        fi

        echo "diffvim: $HUNK_COUNT hunk(s) to animate. Launching vim in tmux..."

        # Set up tmux and launch vim
        setup_tmux "$OLD"

        # Start animation in background
        animate &
        ANIM_PID=$!

        # Attach to tmux (foreground, blocks until session ends or user detaches).
        # When not attached (or attach fails, e.g. no tty), wait for the
        # animation subshell to finish so we don't exit immediately and
        # tear everything down via the EXIT trap.
        if [[ $ATTACHED -eq 0 ]]; then
            tmux attach-session -t "$SESSION" 2>/dev/null || true
            # attach returned (detached or failed); keep the process alive
            # until the animation finishes or vim exits.
            while kill -0 "$ANIM_PID" 2>/dev/null; do
                sleep 0.2
            done
        else
            # Inside tmux: the new window is already focused.
            # Wait for the animation to finish (or user to switch away).
            while kill -0 "$ANIM_PID" 2>/dev/null; do
                sleep 0.5
            done
        fi
    else
        # Multi-pair animation
        for (( pair_idx=0; pair_idx<${#FILE_PAIRS[@]}; pair_idx++ )); do
            pair="${FILE_PAIRS[$pair_idx]}"
            OLD="${pair%%:*}"
            NEW="${pair#*:}"
            animate_pair
        done
    fi

    # Animation/vim has ended. Cleanup will be handled by trap.
}

main "$@"
