"   type_delay_ms      - delay between typed characters
"   delete_delay_ms    - delay between deleted characters
"   move_min_ms        - minimum cursor-glide duration
"   move_max_ms        - maximum cursor-glide duration
"   move_ms_per_unit   - ms per unit of distance, capped by max
"   hunk_pause_ms      - pause between hunks
"   tick_ms            - animation frame interval (~60fps)

" --- Timed Op Stream Reader (v2 TSV) -----------------------------------------
" When DIFFVIM_TIMED_OPS is set (by the bash launcher running the external
" pipeline), this section reads and applies the pre-computed timed op stream.
" This bypasses ALL the in-vim compute/postprocess/pace code below — the
" vimscript engine only handles the ANIMATE stage.
"
" The timed op stream format (v2 TSV, tab-separated, 1-indexed line/col):
"   keep\t<line>\t<col>\t<code>\t<char_repr>     — keep a char (advance cursor)
"   delete\t<line>\t<col>\t<code>\t<char_repr>   — delete a char (\n joins lines)
"   insert\t<line>\t<col>\t<code>\t<char_repr>   — insert a char (\n splits line)
"   delay\t<ms>\t<type>                          — wait ms (type for instrumentation)
"   HUNK\t<target>\t<del>\t<ins>\t<end_ins>\t<end_del>  — hunk metadata
"   HUNK_END                                     — hunk end metadata
"   snapshot\t<file>                             — write buffer to file
"   done                                         — end of stream
"
" Anti-flash design:
"   1. keep ops don't render — only advance cursor
"   2. delete/insert ops set s:needs_redraw=1 but DON'T redraw immediately
"   3. Process all ops between delays in one pass, then redraw ONCE
"   4. Single timer per delay, no polling loop

if exists('$DIFFVIM_TIMED_OPS') && !empty($DIFFVIM_TIMED_OPS) && filereadable($DIFFVIM_TIMED_OPS)

let s:timed_ops = []
let s:timed_idx = 0
let s:cur_l = 1
let s:cur_c = 1
let s:timed_stopped = 0
let s:timed_speed = 1.0
" Read speed from DIFFVIM_SPEED env var (set by --speed flag)
if exists('$DIFFVIM_SPEED') && !empty($DIFFVIM_SPEED)
    let s:timed_speed = str2float($DIFFVIM_SPEED)
    if s:timed_speed <= 0 | let s:timed_speed = 1.0 | endif
endif
let s:timed_timer = -1
let s:needs_redraw = 0

" --- Read config from env vars ---
let s:scroll_mode = 'zz'
if exists('$DIFFVIM_SCROLL') && !empty($DIFFVIM_SCROLL)
    let s:scroll_mode = $DIFFVIM_SCROLL
endif

let s:step_mode = 0
if exists('$DIFFVIM_STEP_MODE') && !empty($DIFFVIM_STEP_MODE) && $DIFFVIM_STEP_MODE !=# '0'
    let s:step_mode = 1
endif

let s:startup_pause = 0
if exists('$DIFFVIM_STARTUP_PAUSE') && !empty($DIFFVIM_STARTUP_PAUSE) && $DIFFVIM_STARTUP_PAUSE !=# '0'
    let s:startup_pause = 1
endif

let s:theme = ''
if exists('$DIFFVIM_THEME') && !empty($DIFFVIM_THEME)
    let s:theme = $DIFFVIM_THEME
endif

" --- Apply theme ---
function! s:ApplyTheme() abort
    if s:theme ==# 'dark'
        highlight DiffAdd ctermbg=22 guibg=#1a3a1a
        highlight DiffDelete ctermbg=52 guibg=#3a1a1a
        highlight DiffChange ctermbg=17 guibg=#1a1a3a
    elseif s:theme ==# 'light'
        highlight DiffAdd ctermbg=194 guibg=#ddffdd
        highlight DiffDelete ctermbg=217 guibg=#ffdddd
        highlight DiffChange ctermbg=189 guibg=#ddddff
    elseif s:theme ==# 'high-contrast'
        highlight DiffAdd ctermbg=2 ctermfg=0 guibg=#00ff00 guifg=#000000
        highlight DiffDelete ctermbg=1 ctermfg=0 guibg=#ff0000 guifg=#000000
        highlight DiffChange ctermbg=4 ctermfg=0 guibg=#0000ff guifg=#ffffff
    endif
endfunction

" --- Startup pause ---
function! s:ShowStartup() abort
    if !s:startup_pause | return | endif
    echo "diffvim: press Enter to start animation..."
    call getchar()
    echo ""
endfunction

function! s:LoadTimedOps() abort
    let s:timed_ops = readfile($DIFFVIM_TIMED_OPS)
    let s:timed_idx = 0
endfunction

function! s:TimedPlaceCursor() abort
    let l:ll = s:cur_l
    let l:lc = s:cur_c
    if l:ll < 1 | let l:ll = 1 | endif
    if l:ll > line('$') | let l:ll = line('$') | endif
    let l:line = getline(l:ll)
    let l:len = strchars(l:line)
    if l:lc > l:len + 1 | let l:lc = l:len + 1 | endif
    if l:lc < 1 | let l:lc = 1 | endif
    let l:byte_col = byteidx(l:line, l:lc - 1) + 1
    if l:byte_col < 1 | let l:byte_col = strlen(l:line) + 1 | endif
    call cursor(l:ll, l:byte_col)
    let l:win_top = line('w0')
    let l:win_bot = line('w$')
    " Scroll based on --scroll mode
    if l:ll < l:win_top + 3 || l:ll > l:win_bot - 3
        if s:scroll_mode ==# 'zz'
            normal! zz
        elseif s:scroll_mode ==# 'zt'
            normal! zt
        elseif s:scroll_mode ==# 'zb'
            normal! zb
        elseif s:scroll_mode ==# 'none'
            " no scroll
        else
            normal! zz
        endif
    endif
endfunction

function! s:TimedSetCursor(line, col) abort
    let s:cur_l = a:line
    let s:cur_c = a:col
    if s:cur_l < 1 | let s:cur_l = 1 | endif
    if s:cur_l > line('$')
        let s:cur_l = line('$')
        let s:cur_c = strchars(getline(line('$'))) + 1
        return
    endif
    let l:max_col = strchars(getline(s:cur_l)) + 1
    if s:cur_c > l:max_col | let s:cur_c = l:max_col | endif
    if s:cur_c < 1 | let s:cur_c = 1 | endif
endfunction

function! s:TimedInsertChar(code) abort
    if a:code == 10
        let l:line = getline(s:cur_l)
        let l:byte = byteidx(l:line, s:cur_c - 1)
        if l:byte < 0 | let l:byte = strlen(l:line) | endif
        let l:before = l:byte > 0 ? strpart(l:line, 0, l:byte) : ''
        let l:after = strpart(l:line, l:byte)
        call setline(s:cur_l, l:before)
        call append(s:cur_l, l:after)
        let s:cur_l += 1
        let s:cur_c = 1
    else
        let l:ch = nr2char(a:code)
        let l:line = getline(s:cur_l)
        let l:byte = byteidx(l:line, s:cur_c - 1)
        if l:byte < 0 | let l:byte = strlen(l:line) | endif
        let l:before = l:byte > 0 ? strpart(l:line, 0, l:byte) : ''
        let l:after = strpart(l:line, l:byte)
        call setline(s:cur_l, l:before . l:ch . l:after)
        let s:cur_c += 1
    endif
    let s:needs_redraw = 1
endfunction

function! s:TimedDeleteChar(code) abort
    if a:code == 10
        " Delete \n — join current line with the next line.
        " Natural result of removing a newline from a line-based buffer.
        " No special cases. If there is no next line, the op is a no-op —
        " the postprocess must not emit delete-\n at the last line.
        if s:cur_l < line('$')
            let l:cur = getline(s:cur_l)
            let l:next = getline(s:cur_l + 1)
            call setline(s:cur_l, l:cur . l:next)
            execute s:cur_l + 1 . 'delete _'
        endif
    else
        let l:line = getline(s:cur_l)
        let l:byte = byteidx(l:line, s:cur_c - 1)
        if l:byte < 0 | let l:byte = strlen(l:line) | endif
        if l:byte < strlen(l:line)
            let l:next = byteidx(l:line, s:cur_c)
            if l:next < 0 | let l:next = strlen(l:line) | endif
            let l:before = l:byte > 0 ? strpart(l:line, 0, l:byte) : ''
            let l:after = strpart(l:line, l:next)
            call setline(s:cur_l, l:before . l:after)
        endif
    endif
    let s:needs_redraw = 1
endfunction

function! s:TimedKeepChar(code) abort
    if a:code == 10
        let s:cur_l += 1
        if s:cur_l > line('$') | let s:cur_l = line('$') | endif
        let s:cur_c = 1
    else
        let s:cur_c += 1
    endif
endfunction

" Process ops until a delay is hit or stream ends.
" In step mode: starts paused, Space advances one op at a time.
function! s:TimedProcessBatch() abort
    let l:n = len(s:timed_ops)
    let l:safety = 0

    while s:timed_idx < l:n && l:safety < 50000
        let l:safety += 1
        let l:line = s:timed_ops[s:timed_idx]
        let s:timed_idx += 1

        if l:line ==# '' || l:line[0] ==# '#'
            continue
        endif

        let l:parts = split(l:line, "\t", 1)
        let l:cmd = l:parts[0]

        " v2 format: keep/delete/insert directly (no "op" prefix)
        if l:cmd ==# 'keep' && len(l:parts) >= 4
            call s:TimedSetCursor(str2nr(l:parts[1]), str2nr(l:parts[2]))
            call s:TimedKeepChar(str2nr(l:parts[3]))
            " keep ops don't render

        elseif l:cmd ==# 'delete' && len(l:parts) >= 4
            " For \n deletes (code 10), DON'T move the visual cursor —
            " the join happens at the internal cursor, but the displayed
            " cursor stays where the previous content op left it. This
            " prevents the cursor from jumping UP to the preserved line
            " above during \n deletes."
            let l:del_code = str2nr(l:parts[3])
            if l:del_code != 10
                call s:TimedSetCursor(str2nr(l:parts[1]), str2nr(l:parts[2]))
            endif
            call s:TimedDeleteChar(l:del_code)

        elseif l:cmd ==# 'insert' && len(l:parts) >= 4
            call s:TimedSetCursor(str2nr(l:parts[1]), str2nr(l:parts[2]))
            call s:TimedInsertChar(str2nr(l:parts[3]))

        elseif l:cmd ==# 'delay' && len(l:parts) >= 3
            " delay\t<ms>\t<type> — render now, then return delay
            if s:needs_redraw
                call s:TimedPlaceCursor()
                redraw
                let s:needs_redraw = 0
            endif
            let l:ms = str2nr(l:parts[1])
            let l:ms = float2nr(l:ms / s:timed_speed)
            return l:ms

        elseif l:cmd ==# 'HUNK' || l:cmd ==# 'HUNK_END'
            " metadata — skip

        elseif l:cmd ==# 'highlight' && len(l:parts) >= 7
            " highlight\t<sl>\t<sc>\t<el>\t<ec>\t<type>\t<dur>
            " In vim: use matchadd to highlight the region
            let l:sl = str2nr(l:parts[1])
            let l:sc = str2nr(l:parts[2])
            let l:el = str2nr(l:parts[3])
            let l:ec = str2nr(l:parts[4])
            let l:htype = l:parts[5]
            let l:dur = str2nr(l:parts[6])
            " Build match pattern
            let l:hi_group = l:htype ==# 'insert' ? 'DiffAdd' : l:htype ==# 'delete' ? 'DiffDelete' : 'DiffChange'
            let l:pattern = printf('\%%%dl\%%>%dc.*\%%%dl\%%<%dc', l:sl, l:sc-1, l:el, l:ec+1)
            let l:match_id = matchadd(l:hi_group, l:pattern)
            if s:needs_redraw
                call s:TimedPlaceCursor()
                redraw
                let s:needs_redraw = 0
            endif
            " Schedule removal after duration (simplified: remove on next delay)
            " Store match ID for later removal
            let s:highlight_ids = get(s:, 'highlight_ids', [])
            call add(s:highlight_ids, l:match_id)

        elseif l:cmd ==# 'dim' && len(l:parts) >= 4
            " dim\t<sl>\t<el>\t<pct>
            " In vim: use matchadd with a dim color
            let l:sl = str2nr(l:parts[1])
            let l:el = str2nr(l:parts[2])
            let l:pct = str2nr(l:parts[3])
            let l:pattern = printf('\%%%dl\|\%%%dl', l:sl, l:el)
            call matchadd('Comment', l:pattern)

        elseif l:cmd ==# 'fold' && len(l:parts) >= 3
            " fold\t<sl>\t<el>
            " In vim: fold the line range
            let l:sl = str2nr(l:parts[1])
            let l:el = str2nr(l:parts[2])
            execute l:sl . ',' . l:el . 'fold'

        elseif l:cmd ==# 'sign' && len(l:parts) >= 3
            " sign\t<line>\t<type>
            " In vim: place a sign
            let l:line = str2nr(l:parts[1])
            let l:sign_type = l:parts[2]
            if !exists('s:sign_counter')
                let s:sign_counter = 100
                sign define diffvim_add text=+ texthl=DiffAdd
                sign define diffvim_del text=- texthl=DiffDelete
            endif
            let s:sign_counter += 1
            if l:sign_type ==# 'add'
                execute 'sign place ' . s:sign_counter . ' line=' . l:line . ' name=diffvim_add buffer=' . bufnr('')
            elseif l:sign_type ==# 'del'
                execute 'sign place ' . s:sign_counter . ' line=' . l:line . ' name=diffvim_del buffer=' . bufnr('')
            endif

        elseif l:cmd ==# 'marker' && len(l:parts) >= 4
            " marker\t<line>\t<col>\t<text>
            " In vim: echo the marker text
            let l:marker_text = join(l:parts[3:], "\t")
            echo l:marker_text

        elseif l:cmd ==# 'skip_hunk'
            " skip_hunk — apply remaining ops in current hunk instantly
            let s:timed_skip_hunk = 1

        elseif l:cmd ==# 'glide' && len(l:parts) >= 5
            " glide\t<from_line>\t<to_line>\t<duration_ms>\t<show_intermediate>
            " Animate cursor moving from from_line to to_line.
            " In vimscript: just set cursor to to_line (no smooth animation
            " in vimscript — the timer-based tick already provides smoothness).
            " If show_intermediate is 0, don't redraw during the glide.
            let s:cur_l = str2nr(l:parts[2])
            let s:cur_c = 1
            let s:needs_redraw = 1

        elseif l:cmd ==# 'snapshot' && len(l:parts) >= 2
            if !empty(g:diffvim.output_file)
                execute 'w! ' . g:diffvim.output_file
            endif

        elseif l:cmd ==# 'done'
            let s:timed_stopped = 1
            if s:needs_redraw
                call s:TimedPlaceCursor()
                redraw
                let s:needs_redraw = 0
            endif
            return -1
        endif
    endwhile

    let s:timed_stopped = 1
    if s:needs_redraw
        call s:TimedPlaceCursor()
        redraw
        let s:needs_redraw = 0
    endif
    return -1
endfunction

function! s:TimedWriteOutput() abort
    if empty(g:diffvim.output_file)
        return
    endif
    " Handle the empty-buffer case (all content was deleted): write an
    " empty file rather than a file containing just a newline.
    if line('$') == 1 && getline(1) ==# ''
        " Delete the only line so the buffer is truly empty, then write
        " with noeol to produce a 0-byte file.
        1,$delete _
        call setline(1, '')
        setlocal noeol nomodified
        call writefile([], g:diffvim.output_file, 'b')
        return
    endif
    " Otherwise: respect the new file's trailing-newline convention.
    let l:bytes = readfile(g:diffvim_new_file, 'b')
    if !empty(l:bytes)
        let l:last = l:bytes[-1]
        if l:last !~# "\\n$" && l:last !~# "\\r$"
            setlocal noeol
        endif
    endif
    execute 'w! ' . g:diffvim.output_file
endfunction

function! s:TimedTick(timer) abort
    if s:timed_stopped
        call timer_stop(s:timed_timer)
        let s:timed_timer = -1
        call s:TimedWriteOutput()
        return
    endif

    " Pause: keep polling but don't process ops
    if get(s:, 'timed_paused', 0)
        let s:timed_timer = timer_start(50, function('s:TimedTick'))
        return
    endif

    " Skip to next hunk: process ops without rendering until we hit HUNK_END
    if get(s:, 'timed_skip_hunk', 0)
        let s:timed_skip_hunk = 0
        let l:safety = 0
        while l:safety < 50000
            let l:safety += 1
            if s:timed_idx >= len(s:timed_ops)
                break
            endif
            let l:line = s:timed_ops[s:timed_idx]
            let s:timed_idx += 1
            if l:line ==# '' || l:line[0] ==# '#'
                continue
            endif
            let l:parts = split(l:line, "\t", 1)
            let l:cmd = l:parts[0]
            if l:cmd ==# 'HUNK_END'
                break
            endif
            if l:cmd ==# 'keep' && len(l:parts) >= 4
                call s:TimedSetCursor(str2nr(l:parts[1]), str2nr(l:parts[2]))
                call s:TimedKeepChar(str2nr(l:parts[3]))
            elseif l:cmd ==# 'delete' && len(l:parts) >= 4
                call s:TimedSetCursor(str2nr(l:parts[1]), str2nr(l:parts[2]))
                call s:TimedDeleteChar(str2nr(l:parts[3]))
            elseif l:cmd ==# 'insert' && len(l:parts) >= 4
                call s:TimedSetCursor(str2nr(l:parts[1]), str2nr(l:parts[2]))
                call s:TimedInsertChar(str2nr(l:parts[3]))
            endif
        endwhile
        let s:needs_redraw = 1
        call s:TimedPlaceCursor()
        redraw
        let s:needs_redraw = 0
    endif

    let l:delay = s:TimedProcessBatch()

    if l:delay == -1
        call timer_stop(s:timed_timer)
        let s:timed_timer = -1
        call s:TimedWriteOutput()
        " Mark buffer as not modified so :q quits cleanly (unless --keep-dirty)
        if !get(g:diffvim, 'keep_dirty', 0)
            setlocal nomodified
        endif
        return
    endif

    let l:delay = l:delay < 1 ? 1 : l:delay
    let s:timed_timer = timer_start(l:delay, function('s:TimedTick'))
endfunction

function! s:StartTimedAnimation() abort
    " Apply theme before starting
    call s:ApplyTheme()

    " Startup pause (wait for user to press Enter)
    call s:ShowStartup()

    call s:LoadTimedOps()
    if empty(s:timed_ops)
        echoerr 'diffvim: timed op stream is empty'
        return
    endif

    " Step mode: start paused, Space advances one op
    if s:step_mode
        let s:timed_paused = 1
        echo "Step mode: press Space to advance, q to quit"
    endif

    " --sync mode: run without timers (for testing/headless use)
    if exists('$DIFFVIM_SYNC') && !empty($DIFFVIM_SYNC) && $DIFFVIM_SYNC !=# '0'
        let s:timed_speed = 1000000.0
        while 1
            let l:delay = s:TimedProcessBatch()
            if l:delay == -1
                break
            endif
        endwhile
        call s:TimedWriteOutput()
        qa!
        return
    endif
    let s:timed_timer = timer_start(100, function('s:TimedTick'))
endfunction

nnoremap <buffer> <silent> q :call <SID>TimedQuit()<CR>
nnoremap <buffer> <silent> + :let s:timed_speed = s:timed_speed * 1.5<CR>:echo "speed: " . string(s:timed_speed)<CR>
nnoremap <buffer> <silent> - :let s:timed_speed = s:timed_speed / 1.5<CR>:echo "speed: " . string(s:timed_speed)<CR>
nnoremap <buffer> <silent> = :let s:timed_speed = 1.0<CR>:echo "speed: 1.0"<CR>
nnoremap <buffer> <silent> <Space> :let s:timed_paused = !get(s:, 'timed_paused', 0)<CR>:echo get(s:, 'timed_paused', 0) ? 'PAUSED' : 'RESUMED'<CR>
nnoremap <buffer> <silent> p :let s:timed_paused = !get(s:, 'timed_paused', 0)<CR>:echo get(s:, 'timed_paused', 0) ? 'PAUSED' : 'RESUMED'<CR>
nnoremap <buffer> <silent> n :let s:timed_skip_hunk = 1<CR>:echo 'Skipping to next hunk...'<CR>
nnoremap <buffer> <silent> ? :echo 'q=quit Space=pause n=next-hunk +=faster -=slower ==reset'<CR>

" Also map in terminal mode (for neovim terminal buffers)
if has('terminal')
    tnoremap <buffer> <silent> <Space> <C-\><C-n>:let s:timed_paused = !get(s:, 'timed_paused', 0)<CR>:echo get(s:, 'timed_paused', 0) ? 'PAUSED' : 'RESUMED'<CR>
    tnoremap <buffer> <silent> q <C-\><C-n>:call <SID>TimedQuit()<CR>
endif

" Quit handler: stop animation, write output, quit vim
function! s:TimedQuit() abort
    let s:timed_stopped = 1
    if s:timed_timer != -1
        call timer_stop(s:timed_timer)
        let s:timed_timer = -1
    endif
    call s:TimedWriteOutput()
    " Mark buffer as not modified so :q quits cleanly (unless --keep-dirty)
    if !get(g:diffvim, 'keep_dirty', 0)
        setlocal nomodified
    endif
    " Restore cursor visibility
    echo ""
    quit!
endfunction

call s:StartTimedAnimation()

finish
endif

__DIFFVIM_VIMSCRIPT_EOF__

# The external pipeline (diffvim-compute-cpp, diffvim-postprocess, diffvim-pace)
# now handles all diff computation. This engine only animates the result.

# Find vim runtime directory for syntax files (used in --no-vimrc mode)
VIM_RUNTIME=""
for d in $(vim --version 2>/dev/null | grep -o '/usr/share/vim/vim[0-9]*' | head -1) \
         /usr/share/vim/vim91 /usr/share/vim/vim90 /usr/share/vim/vim82 \
         /usr/share/vim/vim81 /usr/local/share/vim/vim91 /usr/local/share/vim/vim90; do
    if [[ -d "$d/syntax" ]]; then
        VIM_RUNTIME="$d"
        break
    fi
done

# Build the file-pairs vimscript command for multi-file navigation (]/[ keys)
FILE_PAIRS_VIM=""
if [[ ${#FILE_PAIRS[@]} -gt 1 ]]; then
    FILE_PAIRS_VIM="call s:SetFilePairs(["
    for pair in "${FILE_PAIRS[@]}"; do
        old_p="${pair%%:*}"
        new_p="${pair##*:}"
        FILE_PAIRS_VIM+="['$old_p','$new_p'],"
    done
    FILE_PAIRS_VIM+="])"
fi

if [[ $NO_VIMRC -eq 1 ]]; then
    # --no-vimrc: use an isolated mini vimrc (no user config loaded).
    MINI_VIMRC="$WORKDIR/minirc.vim"
    cat > "$MINI_VIMRC" <<MINIRC
set nocp nomore noswapfile
${VIM_RUNTIME:+let &runtimepath = '$VIM_RUNTIME'}
syntax enable
MINIRC

    exec vim -f -n -u "$MINI_VIMRC" -U NONE \
        "$OLD" \
        -c "let g:diffvim_new_file = '$NEW'" \
        -c "source $VIMSCRIPT" \
        ${FILE_PAIRS_VIM:+-c "$FILE_PAIRS_VIM"}
else
    # Default: load the user's vimrc (~/.vimrc or $MYVIMRC).
    exec vim -f -n -U NONE \
        "$OLD" \
        -c "set nomore noswapfile shortmess+=A" \
        -c "syntax enable" \
        -c "let g:diffvim_new_file = '$NEW'" \
        -c "source $VIMSCRIPT" \
        ${FILE_PAIRS_VIM:+-c "$FILE_PAIRS_VIM"}
fi
