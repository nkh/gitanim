#!/usr/bin/env bash
# diffvim - Animate a code diff as if a human were typing it.
#
# Usage:
#   diffvim [options] <oldfile> <newfile>
#   diffvim [options] --multi <old1:new1> <old2:new2> ...
#   diffvim [options] --replay <file>
#   diffvim [options] --git-rev REV..REV <file> [<file> ...]
#
# Opens <oldfile> in vim and animates the transformation into <newfile>.
# The cursor glides between change locations with ease-in-out acceleration
# and deceleration. Only the actually-changed characters are deleted and
# re-typed; surrounding text is left untouched (no whole-line rewrites).
#
# By default, the buffer is marked as not modified after animation so ':q'
# quits cleanly. Use --keep-dirty to leave the buffer modified (':q!' then
# required to quit).
#
# Unified option selectors (run 'diffvim --help' for full list):
#   --op-order MODE          Op reordering (natural|optimize|left-to-right|...)
#   --delete-pacing MODE     Deletion strategy (char|rapid-eol|word|instant|...)
#   --insert-pacing MODE     Insertion strategy (char|word|accel)
#   --pacing MODE            Timing mode (uniform|adaptive|gaussian|review)
#   --highlight MODE         Highlight mode (none|inline|word|hunk)
#
# Controls (normal mode, active during animation):
#   <Space>   pause / resume
#   n         skip current hunk (apply instantly, move to next)
#   b         back to previous hunk (revert and restart it)
#   q         stop animation (leave buffer in current state)
#   +         speed up (x1.5)
#   -         slow down (x0.67)
#   =         reset speed to 1.0
#   ?         show help
#
# Requires: vim 8+ with +timers and +float. No Python, no tmux.

set -euo pipefail

# ---------------------------------------------------------------------------
# Defaults (can be overridden by env vars or --speed)
# ---------------------------------------------------------------------------
export DIFFVIM_TICK_MS=${DIFFVIM_TICK_MS:-16}
export DIFFVIM_TYPE_DELAY_MS=${DIFFVIM_TYPE_DELAY_MS:-50}
export DIFFVIM_DELETE_DELAY_MS=${DIFFVIM_DELETE_DELAY_MS:-40}
export DIFFVIM_MOVE_MIN_MS=${DIFFVIM_MOVE_MIN_MS:-200}
export DIFFVIM_MOVE_MAX_MS=${DIFFVIM_MOVE_MAX_MS:-2000}
export DIFFVIM_MOVE_MS_PER_UNIT=${DIFFVIM_MOVE_MS_PER_UNIT:-1}
export DIFFVIM_HUNK_PAUSE_MS=${DIFFVIM_HUNK_PAUSE_MS:-250}
export DIFFVIM_WORD_PAUSE_MS=${DIFFVIM_WORD_PAUSE_MS:-150}
export DIFFVIM_RAPID_EOL_DELAY_MS=${DIFFVIM_RAPID_EOL_DELAY_MS:-80}
export DIFFVIM_RAPID_EOL_MIN_CHARS=${DIFFVIM_RAPID_EOL_MIN_CHARS:-3}

# ---------------------------------------------------------------------------
# Parse CLI options
# ---------------------------------------------------------------------------
SPEED_MULT=${DIFFVIM_SPEED:-1.0}
OUTPUT_FILE=""
CONTEXT_LINES=0
MAX_HUNK_CHARS=0
MAX_WORD_CHARS=0
SCROLL_MODE="${DIFFVIM_SCROLL:-zz}"
LANGUAGE="${DIFFVIM_LANGUAGE:-auto}"
MULTI_MODE=0
REPLAY_MODE=0
REPLAY_FROM="HEAD~5"
REPLAY_TO="HEAD"
HELP=0
VERSION=0
DRY_RUN=0
SYNC_MODE=0
WORD_DIFF=0
STEP_MODE=0
ADAPTIVE_TIMING=0
ADAPTIVE_MODE=0
ADAPTIVE_START_DELAY_MS="${DIFFVIM_ADAPTIVE_START_MS:-80}"
ADAPTIVE_MAX_DELAY_MS="${DIFFVIM_ADAPTIVE_MAX_MS:-30}"
ADAPTIVE_ACCEL="${DIFFVIM_ADAPTIVE_ACCEL:-0.92}"
ADAPTIVE_PAUSE_LINES="${DIFFVIM_ADAPTIVE_PAUSE_LINES:-15}"
ADAPTIVE_PAUSE_MS="${DIFFVIM_ADAPTIVE_PAUSE_MS:-500}"
NO_STARTUP_PAUSE=0
SIGN_COLUMN=0
GIT_BLAME=0
HIGHLIGHT_HUNK=0
# --highlight: unified highlight mode selector.
# Replaces --highlight-word, --highlight-hunk, --highlight-inline.
# Old flags still work and override this.
HIGHLIGHT_MODE="${DIFFVIM_HIGHLIGHT:-none}"
HIGHLIGHT_COLOR="${DIFFVIM_HIGHLIGHT_COLOR:-DiffChange}"
HIGHLIGHT_DURATION_MS="${DIFFVIM_HIGHLIGHT_DURATION_MS:-1000}"
HIGHLIGHT_MIN_CHARS="${DIFFVIM_HIGHLIGHT_MIN_CHARS:-10}"
GIT_REV=""
MAX_LINE_LEN=0
# --delete-pacing: unified deletion strategy selector.
# Replaces --rapid-eol-delete, --rapid-identical-chars, --accel-delete,
# --adaptive-word-delete. Old flags still work and override this.
DELETE_PACING="${DIFFVIM_DELETE_PACING:-word}"
# --delete-speed: speed multiplier for deletes (slow|normal|fast|instant)
DELETE_SPEED="${DIFFVIM_DELETE_SPEED:-normal}"
# --delete-threshold: min chars to trigger rapid/word modes (was rapid_eol_min_chars)
DELETE_THRESHOLD="${DIFFVIM_DELETE_THRESHOLD:-3}"
RAPID_EOL_DELETE=1
RAPID_EOL_DELAY_MS="${DIFFVIM_RAPID_EOL_DELAY_MS:-80}"
RAPID_EOL_MIN_CHARS="${DIFFVIM_RAPID_EOL_MIN_CHARS:-3}"
KEEP_DIRTY=0
NO_VIMRC=0
PRECOMPUTED_FILE=""
# C++ compute is the default. AUTO_PRECOMPUTE defaults to 1 — diffvim will
# always try the external compute tool first, and fall back to the
# embedded vimscript LCS (s:LineDiff / s:CharDiff) if the binary is missing.
AUTO_PRECOMPUTE="${DIFFVIM_AUTO_PRECOMPUTE:-1}"
STARTUP_PAUSE=0
ALGORITHM="${DIFFVIM_ALGORITHM:-lcs}"
SEMANTIC_CLEANUP=0
INDENT_AWARE=0
HIGHLIGHT_WORD=0
HIGHLIGHT_WORD_COLOR="${DIFFVIM_HIGHLIGHT_WORD_COLOR:-Search}"
HIGHLIGHT_WORD_DURATION_MS="${DIFFVIM_HIGHLIGHT_WORD_DURATION_MS:-300}"
HIGHLIGHT_WORD_MIN_CHARS="${DIFFVIM_HIGHLIGHT_WORD_MIN_CHARS:-2}"
# Accelerated multi-line deletion: delete first lines slowly, accelerate,
# then decelerate. Prevents large blocks from vanishing in one shot.
ACCEL_DELETE=0
ACCEL_DELETE_START_MS="${DIFFVIM_ACCEL_DELETE_START_MS:-80}"
ACCEL_DELETE_MIN_MS="${DIFFVIM_ACCEL_DELETE_MIN_MS:-10}"
ACCEL_DELETE_ACCEL="${DIFFVIM_ACCEL_DELETE_ACCEL:-0.85}"
# Overwrite mode: when a word replaces another, overwrite in place rather
# than delete-all-then-insert-all. Shorter=overwrite+delete-extra;
# same=overwrite-only; longer=overwrite+insert-remainder.
OVERWRITE_MODE=0
# Indent-last: delete leading whitespace last when deleting a whole line
INDENT_LAST="${DIFFVIM_INDENT_LAST:-0}"
# Flash mode: highlight whole line, pause, delete in one shot
FLASH_PAUSE_MS="${DIFFVIM_FLASH_PAUSE_MS:-400}"
FLASH_HIGHLIGHT_MS="${DIFFVIM_FLASH_HIGHLIGHT_MS:-300}"
# Cursor glide: ease-in-out interpolation between hunks
CURSOR_GLIDE_MS="${DIFFVIM_CURSOR_GLIDE_MS:-0}"
CURSOR_GLIDE_SHOW_INTERMEDIATE="${DIFFVIM_CURSOR_GLIDE_SHOW_INTERMEDIATE:-1}"
# Distance-based speed: adaptive speed based on hunk distance
DISTANCE_SPEED="${DIFFVIM_DISTANCE_SPEED:-off}"
DISTANCE_THRESHOLD="${DIFFVIM_DISTANCE_THRESHOLD:-10}"
DISTANCE_FAST_MULT="${DIFFVIM_DISTANCE_FAST_MULT:-3.0}"
DISTANCE_SLOW_MULT="${DIFFVIM_DISTANCE_SLOW_MULT:-0.5}"
# Delete-end-before-insert: when a line has both inserts and end-deletes,
# delete the end first, then insert.
DELETE_END_FIRST=0
DELETE_END_FIRST_DELAY_MS="${DIFFVIM_DELETE_END_FIRST_DELAY_MS:-100}"
DELETE_END_FIRST_SMART="${DIFFVIM_DELETE_END_FIRST_SMART:-0}"
DELETE_END_FIRST_HIGHLIGHT_MS="${DIFFVIM_DELETE_END_FIRST_HIGHLIGHT_MS:-300}"
# Startup feedback: show progress in status line during diff computation
STARTUP_FEEDBACK=0
# Inline char highlight: paint freshly typed chars green, deleted chars red
INLINE_HIGHLIGHT=0
INLINE_HIGHLIGHT_DURATION_MS="${DIFFVIM_INLINE_HIGHLIGHT_DURATION_MS:-200}"
# --pacing: unified timing/pacing mode selector.
# Replaces --adaptive, --adaptive-timing, --gaussian-jitter, --pause-after-lines.
# Old flags still work and override this.
PACING="${DIFFVIM_PACING:-uniform}"
# Gaussian jitter: vary per-char delay for human-like typing
GAUSSIAN_JITTER=0
GAUSSIAN_JITTER_PCT="${DIFFVIM_GAUSSIAN_JITTER_PCT:-20}"
# Dim unchanged lines: reduce opacity of unchanged anchor lines
DIM_UNCHANGED=0
DIM_UNCHANGED_PCT="${DIFFVIM_DIM_UNCHANGED_PCT:-60}"
# Pause after N lines for large hunks
PAUSE_AFTER_LINES=0
PAUSE_AFTER_THRESHOLD="${DIFFVIM_PAUSE_AFTER_THRESHOLD:-50}"
PAUSE_AFTER_MS="${DIFFVIM_PAUSE_AFTER_MS:-500}"
PAUSE_BEFORE_DELETE_MS="${DIFFVIM_PAUSE_BEFORE_DELETE_MS:-200}"
PAUSE_AFTER_DELETE_MS="${DIFFVIM_PAUSE_AFTER_DELETE_MS:-200}"
BLOCK_DELETE_SIZE="${DIFFVIM_BLOCK_DELETE_SIZE:-3}"
FOLD_UNCHANGED=0
THEME="${DIFFVIM_THEME:-}"
# --op-order: unified post-processing mode selector.
# Replaces the individual --optimize-sequence / --left-to-right /
# --delete-end-first / --delete-end-first-smart / --overwrite flags.
# Old flags still work and are mapped to this variable below.
OP_ORDER="${DIFFVIM_OP_ORDER:-optimize}"
OPTIMIZE_SEQUENCE="${DIFFVIM_OPTIMIZE_SEQUENCE:-1}"
LOG_MODE="${DIFFVIM_LOG_MODE:-}"
LOG_FILE="${DIFFVIM_LOG_FILE:-diffvim.log}"
LEFT_TO_RIGHT="${DIFFVIM_LEFT_TO_RIGHT:-1}"
ADAPTIVE_WORD_DELETE="${DIFFVIM_ADAPTIVE_WORD_DELETE:-0}"
ADAPTIVE_WORD_DELETE_THRESHOLD="${DIFFVIM_ADAPTIVE_WORD_DELETE_THRESHOLD:-3}"
ADAPTIVE_WORD_DELETE_START_CHARS="${DIFFVIM_ADAPTIVE_WORD_DELETE_START_CHARS:-3}"
ADAPTIVE_WORD_DELETE_START_MS="${DIFFVIM_ADAPTIVE_WORD_DELETE_START_MS:-80}"
ADAPTIVE_WORD_DELETE_MIN_MS="${DIFFVIM_ADAPTIVE_WORD_DELETE_MIN_MS:-15}"
ADAPTIVE_WORD_DELETE_ACCEL="${DIFFVIM_ADAPTIVE_WORD_DELETE_ACCEL:-0.85}"
ADAPTIVE_WORD_DELETE_WORD_PAUSE_MS="${DIFFVIM_ADAPTIVE_WORD_DELETE_WORD_PAUSE_MS:-100}"
RAPID_IDENTICAL_CHARS="${DIFFVIM_RAPID_IDENTICAL_CHARS:-0}"
RAPID_IDENTICAL_MIN="${DIFFVIM_RAPID_IDENTICAL_MIN:-5}"
RAPID_IDENTICAL_ACCEL="${DIFFVIM_RAPID_IDENTICAL_ACCEL:-0.5}"
# --insert-pacing: unified insertion strategy selector.
# Replaces --max-word-chars, --word-accel. Old flags still work.
INSERT_PACING="${DIFFVIM_INSERT_PACING:-char}"
# --insert-speed: speed for inserts (slow|normal|fast)
INSERT_SPEED="${DIFFVIM_INSERT_SPEED:-normal}"
WORD_ACCEL="${DIFFVIM_WORD_ACCEL:-0}"
WORD_ACCEL_DELETE_PCT="${DIFFVIM_WORD_ACCEL_DELETE_PCT:-20}"
WORD_END_PAUSE_MS="${DIFFVIM_WORD_END_PAUSE_MS:-150}"
LINE_CHANGE_PAUSE_MS="${DIFFVIM_LINE_CHANGE_PAUSE_MS:-200}"
PRESET="${DIFFVIM_PRESET:-}"
LOG_TIMING="${DIFFVIM_LOG_TIMING:-1}"
DEBUG_MODE=0
DEBUG_LOG="/tmp/diffvim-debug.log"

show_help() {
    cat >&2 <<USAGE
Usage: $(basename "$0") [options] <oldfile> <newfile>
       $(basename "$0") [options] --multi(-m) <old1:new1> <old2:new2> ...
       $(basename "$0") [options] --replay(-r) <file>
       $(basename "$0") [options] --git-rev(-R) REV..REV <file> [<file> ...]

Animate a code diff in vim, as if a human were typing it.
Short forms in parentheses (e.g. -s for --speed).

CORE OPTIONS:
  --speed N (-s)           Speed multiplier: 0.5=half speed, 2=double, 5=5x
  --output FILE (-o)       Write result to FILE after animation, then quit
  --context N (-c)         Fold unchanged regions >2N lines, keep N context
                           (0 = fold all unchanged regions)
  --max-hunk-chars N       If a hunk has >N changed chars, apply instantly
  --scroll zz|zt|zb|none   Scroll cursor to center/top/bottom/none (default: zz)
  --multi (-m)             Treat args as old:new pairs for multi-file animation
  --replay (-r)            Animate git history for given file(s)
  --git-rev REV..REV (-R)  Animate a git commit range (e.g. HEAD~3..HEAD)
  --version, -V            Print version and exit
  --dry-run (-d)           Print diff hunks without launching vim
  --step-mode              Space advances one op at a time (starts paused)
  --no-startup-pause       Skip startup delay and messages, start immediately
  --language LANG          Set vim filetype for syntax highlighting (default: auto)
  --sign-column            Show +/- signs in the sign column during animation
  --git-blame (-g)         Echo git blame for the target line of each hunk
  --max-line-len N         Warn on lines longer than N characters
  --keep-dirty             Leave buffer modified; require :q! to quit (default: off)
  --no-vimrc (-N)          Don't load user's ~/.vimrc (isolated vim, default: off)
  --precomputed FILE       Use pre-computed diff from FILE (see compute/ dir)
                           By default diffvim uses compute/bin/diffvim-compute-cpp
                           and falls back to the built-in vimscript LCS if not found.
  --startup-pause          Show config + help before starting (default: off)
  --startup-feedback (-F)  Show progress in status line during diff computation
  --preset NAME (-p)       Apply named preset (fast-delete, review, demo, ai-code)
  --log-mode 1|2           Generate log file without starting vim
  --log-file FILE          Write log to FILE (default: diffvim.log)
  --no-log-timing          Disable timing info in log output
  --diff FILE              Animate a unified diff file (- for stdin)
  --theme dark|light|high-contrast (-t)  Color scheme for highlights
  --debug                  Enable verbose logging to /tmp/diffvim-debug.log
  --help, -h               Show this help

DIFF ALGORITHM:
  --algorithm (-a)              [removed] Patience diff is now the only algorithm
  --semantic-cleanup (-S)  Merge adjacent delete+insert pairs that cancel out
  --indent-aware (-i)      Normalize indentation before line diff
  --word-diff (-w)         Use word-level diff (groups changes by word tokens)

OP ORDER (post-processing):
  --op-order MODE          Op reordering: natural|optimize|left-to-right|
                           end-first|end-first-smart|overwrite (default: optimize)
    natural                No post-processing (raw LCS order)
    optimize               Deletes before inserts (default)
    left-to-right          Keeps, then deletes, then inserts per line
    end-first              Trailing deletes before inserts
    end-first-smart        Trailing deletes + word batching
    overwrite              In-place replacement instead of delete+insert

DELETION PACING:
  --delete-pacing MODE     Deletion strategy: char|rapid-eol|rapid-identical|
                           accel|word|instant (default: word)
    char                   One char at a time (no acceleration)
    rapid-eol              Rapid shot at end of line
    rapid-identical        Accelerate identical char runs (---, ===)
    accel                  Accelerate through long runs (slow→fast→slow)
    word                   Word-by-word with acceleration (default: char→word→rapid)
    instant                All strategies enabled (fastest)
  --delete-speed MODE      Deletion speed: slow|normal|fast|instant (default: normal)
  --delete-threshold N     Min chars to trigger rapid/word modes (default: 3)

INSERTION PACING:
  --insert-pacing MODE     Insertion strategy: char|word|accel (default: char)
    char                   One char at a time (default)
    word                   Batch short words (<=8 chars) instantly
    accel                  Accelerate char-by-char inserts (slow→fast→pause)
  --insert-speed MODE      Insertion speed: slow|normal|fast (default: normal)

TIMING:
  --pacing MODE            Timing mode: uniform|adaptive|gaussian|review
                           (default: uniform)
    uniform                Fixed delays, no jitter (default)
    adaptive               Slow down in complex regions
    gaussian               Add human-like timing jitter
    review                 Pause every 5 lines in large hunks

HIGHLIGHTING:
  --highlight MODE         Highlight mode: none|inline|word|hunk (default: none)
    none                   No highlighting (default)
    inline                 Paint freshly typed/deleted chars (200ms fade)
    word                   Highlight the word at cursor before change
    hunk                   Highlight the entire hunk before animating
  --highlight-color COLOR  Highlight group (default: DiffChange)
  --highlight-duration-ms N  Highlight duration in ms (default: 1000)
  --dim-unchanged (-D)     Dim unchanged anchor lines to draw eye to changes
  --dim-unchanged-pct N    Dimming percentage 0-100 (default: 60)

CONTROLS (during animation, in vim normal mode):
  <Space>  pause / resume
  n        skip current hunk (apply instantly, move to next)
  b        back to previous hunk (revert and restart it)
  q        stop animation — ':q' quits cleanly (use --keep-dirty for ':q!')
  +        speed up (x1.5)
  -        slow down (x0.67)
  =        reset speed to 1.0
  ?        show in-vim help

MULTI-FILE CONTROLS (only with --multi):
  ]        next file (apply current file's remaining hunks, load next)
  [        previous file (revert to previous file's starting state)

GIT REPLAY CONTROLS (only with --replay or --git-rev):
  )        next commit in the replay sequence
  (        previous commit in the replay sequence

ENVIRONMENT VARIABLES:
  All options can be set via DIFFVIM_<OPTION_NAME> env vars
  (e.g. DIFFVIM_OP_ORDER, DIFFVIM_DELETE_PACING, DIFFVIM_PACING, etc.)
  Timing: DIFFVIM_TICK_MS, DIFFVIM_TYPE_DELAY_MS, DIFFVIM_DELETE_DELAY_MS,
  DIFFVIM_MOVE_MIN_MS, DIFFVIM_MOVE_MAX_MS, DIFFVIM_HUNK_PAUSE_MS

PRESETS:
  fast-delete              --delete-pacing word --delete-speed fast --op-order optimize
  review                   --pacing review --highlight hunk --dim-unchanged --op-order left-to-right
  demo                     --pacing gaussian --speed 0.7 --highlight inline
  ai-code                  --op-order end-first-smart --highlight inline --pacing adaptive

SEE ALSO:
  man diffvim, man diffvim-compute
  docs/VISUAL_GUIDE.md, docs/ADOPTION_GUIDE.md
USAGE
}

# Parse options
POSITIONAL=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --speed|-s)         SPEED_MULT="$2"; shift 2 ;;
        --output|-o)        OUTPUT_FILE="$2"; shift 2 ;;
        --context|-c)       CONTEXT_LINES="$2"; shift 2 ;;
        --max-hunk-chars) MAX_HUNK_CHARS="$2"; shift 2 ;;
        --insert-pacing)
            INSERT_PACING="$2"; shift 2
            case "$INSERT_PACING" in
                char|word|accel) : ;;
                *)
                    echo "diffvim: invalid --insert-pacing value '$INSERT_PACING'" >&2
                    echo "  valid: char | word | accel" >&2
                    exit 1 ;;
            esac
            ;;
        --insert-speed)
            INSERT_SPEED="$2"; shift 2
            case "$INSERT_SPEED" in
                slow|normal|fast) : ;;
                *)
                    echo "diffvim: invalid --insert-speed value '$INSERT_SPEED'" >&2
                    echo "  valid: slow | normal | fast" >&2
                    exit 1 ;;
            esac
            ;;
        --scroll)          SCROLL_MODE="$2"; shift 2 ;;
        --multi|-m)         MULTI_MODE=1; shift ;;
        --replay|-r)        REPLAY_MODE=1; shift ;;
        --version|-V)       VERSION=1; shift ;;
        --dry-run|-d)       DRY_RUN=1; shift ;;
        --sync)             SYNC_MODE=1; shift ;;
        --word-diff|-w)     WORD_DIFF=1; shift ;;
        --step-mode)        STEP_MODE=1; shift ;;
        --no-startup-pause) NO_STARTUP_PAUSE=1; shift ;;
        --language)         LANGUAGE="$2"; shift 2 ;;
        --pacing)
            PACING="$2"; shift 2
            case "$PACING" in
                uniform|adaptive|gaussian|review) : ;;
                *)
                    echo "diffvim: invalid --pacing value '$PACING'" >&2
                    echo "  valid: uniform | adaptive | gaussian | review" >&2
                    exit 1 ;;
            esac
            ;;
        --sign-column)      SIGN_COLUMN=1; shift ;;
        --delete-pacing)
            DELETE_PACING="$2"; shift 2
            case "$DELETE_PACING" in
                char|rapid-eol|rapid-identical|accel|word|instant) : ;;
                *)
                    echo "diffvim: invalid --delete-pacing value '$DELETE_PACING'" >&2
                    echo "  valid: char | rapid-eol | rapid-identical | accel | word | instant" >&2
                    exit 1 ;;
            esac
            ;;
        --delete-speed)
            DELETE_SPEED="$2"; shift 2
            case "$DELETE_SPEED" in
                slow|normal|fast|instant) : ;;
                *)
                    echo "diffvim: invalid --delete-speed value '$DELETE_SPEED'" >&2
                    echo "  valid: slow | normal | fast | instant" >&2
                    exit 1 ;;
            esac
            ;;
        --delete-threshold) DELETE_THRESHOLD="$2"; shift 2 ;;
        --keep-dirty)       KEEP_DIRTY=1; shift ;;
        --no-vimrc|-N)      NO_VIMRC=1; shift ;;
        --precomputed)      PRECOMPUTED_FILE="$2"; shift 2 ;;
        --startup-pause)    STARTUP_PAUSE=1; shift ;;
        --algorithm|-a)     shift 2 ;;  # deprecated: patience is now the only algorithm
        --semantic-cleanup|-S) SEMANTIC_CLEANUP=1; shift ;;
        --indent-aware|-i)  INDENT_AWARE=1; shift ;;
        --startup-feedback|-F) STARTUP_FEEDBACK=1; shift ;;
        --dim-unchanged|-D) DIM_UNCHANGED=1; shift ;;
        --dim-unchanged-pct) DIM_UNCHANGED_PCT="$2"; shift 2 ;;
        --theme|-t)          THEME="$2"; shift 2 ;;
        --log-mode)      LOG_MODE="$2"; shift 2 ;;
        --log-file)      LOG_FILE="$2"; shift 2 ;;
        --op-order)
            OP_ORDER="$2"; shift 2
            case "$OP_ORDER" in
                natural|optimize|left-to-right|end-first|end-first-smart|overwrite)
                    : ;; # valid
                *)
                    echo "diffvim: invalid --op-order value '$OP_ORDER'" >&2
                    echo "  valid: natural | optimize | left-to-right | end-first | end-first-smart | overwrite" >&2
                    exit 1 ;;
            esac
            ;;
        --preset|-p)        PRESET="$2"; shift 2 ;;
        --no-log-timing) LOG_TIMING=0; shift ;;
        --debug)          DEBUG_MODE=1; shift ;;
        --git-blame|-g)     GIT_BLAME=1; shift ;;
        --highlight)
            HIGHLIGHT_MODE="$2"; shift 2
            case "$HIGHLIGHT_MODE" in
                none|inline|word|hunk) : ;;
                *)
                    echo "diffvim: invalid --highlight value '$HIGHLIGHT_MODE'" >&2
                    echo "  valid: none | inline | word | hunk" >&2
                    exit 1 ;;
            esac
            ;;
        --highlight-color) HIGHLIGHT_COLOR="$2"; shift 2 ;;
        --highlight-duration-ms) HIGHLIGHT_DURATION_MS="$2"; shift 2 ;;
        --indent-last)      INDENT_LAST=1; shift ;;
        --overwrite)        OVERWRITE_MODE=1; shift ;;
        --flash-pause-ms)   FLASH_PAUSE_MS="$2"; shift 2 ;;
        --flash-highlight-ms) FLASH_HIGHLIGHT_MS="$2"; shift 2 ;;
        --cursor-glide-ms)  CURSOR_GLIDE_MS="$2"; shift 2 ;;
        --cursor-glide-show-intermediate) CURSOR_GLIDE_SHOW_INTERMEDIATE="$2"; shift 2 ;;
        --distance-speed)
            DISTANCE_SPEED="$2"; shift 2
            case "$DISTANCE_SPEED" in
                adaptive|off) : ;;
                *)
                    echo "diffvim: invalid --distance-speed value '$DISTANCE_SPEED'" >&2
                    echo "  valid: adaptive | off" >&2
                    exit 1 ;;
            esac
            ;;
        --distance-threshold) DISTANCE_THRESHOLD="$2"; shift 2 ;;
        --distance-fast-mult) DISTANCE_FAST_MULT="$2"; shift 2 ;;
        --distance-slow-mult) DISTANCE_SLOW_MULT="$2"; shift 2 ;;
        --git-rev|-R)       GIT_REV="$2"; shift 2 ;;
        --max-line-len)  MAX_LINE_LEN="$2"; shift 2 ;;
        --help|-h)       HELP=1; shift ;;
        --)              shift; while [[ $# -gt 0 ]]; do POSITIONAL+=("$1"); shift; done ;;
        -*)              echo "Unknown option: $1" >&2; show_help; exit 1 ;;
        *)               POSITIONAL+=("$1"); shift ;;
    esac
done

if [[ $VERSION -eq 1 ]]; then
    echo "diffvim 1.5.0"
    exit 0
fi

if [[ $HELP -eq 1 ]]; then
    show_help
    exit 0
fi

# Parse --git-rev REV..REV syntax (shorthand for --replay --from REV1 --to REV2)
if [[ -n "$GIT_REV" ]]; then
    if [[ "$GIT_REV" =~ ^([^[:space:]]+)\.\.([^[:space:]]+)$ ]]; then
        REPLAY_FROM="${BASH_REMATCH[1]}"
        REPLAY_TO="${BASH_REMATCH[2]}"
        REPLAY_MODE=1
    else
        echo "Error: --git-rev expects REV..REV syntax (got: $GIT_REV)" >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# --preset: apply a named preset that sets multiple options at once.
# Presets can also be set via DIFFVIM_PRESET env var. Multiple presets
# can be comma-separated. Available presets:
#   fast-delete: maximize non-char deletion and acceleration
#   review: thorough review with highlighting and pauses
#   present: slow, dramatic for presentations
#   ai-code: optimized for AI-generated code diffs
#   custom: reads options from DIFFVIM_PRESET_CUSTOM env var
# ---------------------------------------------------------------------------
if [[ -n "$PRESET" ]]; then
    IFS=',' read -ra PRESETS <<< "$PRESET"
    for p in "${PRESETS[@]}"; do
        case "$p" in
            fast-delete)
                DELETE_PACING=word
                DELETE_SPEED=fast
                OP_ORDER=optimize
                SEMANTIC_CLEANUP=1
                ;;
            review)
                PACING=review
                HIGHLIGHT_MODE=hunk
                DIM_UNCHANGED=1
                OP_ORDER=left-to-right
                SEMANTIC_CLEANUP=1
                ;;
            demo)
                PACING=gaussian
                SPEED_MULT=0.7
                HIGHLIGHT_MODE=inline
                ;;
            ai-code)
                OP_ORDER=end-first-smart
                HIGHLIGHT_MODE=inline
                PACING=adaptive
                SEMANTIC_CLEANUP=1
                ;;
            custom)
                # Read custom options from DIFFVIM_PRESET_CUSTOM env var
                # Format: space-separated --option value pairs
                if [[ -n "${DIFFVIM_PRESET_CUSTOM:-}" ]]; then
                    eval "set -- $DIFFVIM_PRESET_CUSTOM"
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --*) eval "$(echo "$1" | tr '-' '_' | tr '[:lower:]' '[:upper:]' | sed 's/^_//')=\"${2:-1}\"" 2>/dev/null; shift 2 ;;
                            *) shift ;;
                        esac
                    done
                fi
                ;;
            *)
                echo "diffvim: unknown preset '$p' (available: fast-delete, review, demo, ai-code, custom)" >&2
                ;;
        esac
    done
fi

# Apply speed multiplier
if [[ "$SPEED_MULT" != "1.0" && "$SPEED_MULT" != "1" ]]; then
    DIV=$(awk "BEGIN { printf \"%.6f\", 1.0 / $SPEED_MULT }")
    DIFFVIM_TICK_MS=$(awk "BEGIN { printf \"%d\", $DIFFVIM_TICK_MS * $DIV }")
    DIFFVIM_TYPE_DELAY_MS=$(awk "BEGIN { printf \"%d\", $DIFFVIM_TYPE_DELAY_MS * $DIV }")
    DIFFVIM_DELETE_DELAY_MS=$(awk "BEGIN { printf \"%d\", $DIFFVIM_DELETE_DELAY_MS * $DIV }")
    DIFFVIM_MOVE_MIN_MS=$(awk "BEGIN { printf \"%d\", $DIFFVIM_MOVE_MIN_MS * $DIV }")
    DIFFVIM_MOVE_MAX_MS=$(awk "BEGIN { printf \"%d\", $DIFFVIM_MOVE_MAX_MS * $DIV }")
    DIFFVIM_HUNK_PAUSE_MS=$(awk "BEGIN { printf \"%d\", $DIFFVIM_HUNK_PAUSE_MS * $DIV }")
    DIFFVIM_WORD_PAUSE_MS=$(awk "BEGIN { printf \"%d\", $DIFFVIM_WORD_PAUSE_MS * $DIV }")
    export DIFFVIM_TICK_MS DIFFVIM_TYPE_DELAY_MS DIFFVIM_DELETE_DELAY_MS \
           DIFFVIM_MOVE_MIN_MS DIFFVIM_MOVE_MAX_MS DIFFVIM_HUNK_PAUSE_MS DIFFVIM_WORD_PAUSE_MS
fi
# Ensure minimums
[[ $DIFFVIM_TICK_MS -lt 1 ]] && DIFFVIM_TICK_MS=1 && export DIFFVIM_TICK_MS
[[ $DIFFVIM_TYPE_DELAY_MS -lt 1 ]] && DIFFVIM_TYPE_DELAY_MS=1 && export DIFFVIM_TYPE_DELAY_MS
[[ $DIFFVIM_DELETE_DELAY_MS -lt 1 ]] && DIFFVIM_DELETE_DELAY_MS=1 && export DIFFVIM_DELETE_DELAY_MS

# Resolve --op-order into the individual post-processing variables.
# --op-order is the unified selector; the individual flags
# (--optimize-sequence, --left-to-right, --delete-end-first,
# --delete-end-first-smart, --overwrite) are kept for backwards
# compatibility and override the op-order default.
#
# Mapping:
#   natural          -> optimize=0, l2r=0, def=0, def-smart=0, overwrite=0
#   optimize         -> optimize=1, l2r=0, def=0, def-smart=0, overwrite=0 (default)
#   left-to-right    -> optimize=1, l2r=1, def=0, def-smart=0, overwrite=0
#   end-first        -> optimize=1, l2r=0, def=1, def-smart=0, overwrite=0
#   end-first-smart  -> optimize=1, l2r=0, def=1, def-smart=1, overwrite=0
#   overwrite        -> optimize=1, l2r=0, def=0, def-smart=0, overwrite=1
#
# We only apply the op-order defaults for variables that were NOT
# explicitly set on the command line. We detect "explicitly set" by
# comparing against the DIFFVIM_* env var defaults (if the shell
# variable differs from the env default, it was set on CLI).
case "$OP_ORDER" in
    natural)
        OPTIMIZE_SEQUENCE=0
        LEFT_TO_RIGHT=0
        DELETE_END_FIRST=0
        DELETE_END_FIRST_SMART=0
        OVERWRITE_MODE=0
        ;;
    optimize)
        # Default — keep OPTIMIZE_SEQUENCE=1, others 0
        OPTIMIZE_SEQUENCE=1
        ;;
    left-to-right)
        OPTIMIZE_SEQUENCE=1
        LEFT_TO_RIGHT=1
        ;;
    end-first)
        OPTIMIZE_SEQUENCE=1
        DELETE_END_FIRST=1
        ;;
    end-first-smart)
        OPTIMIZE_SEQUENCE=1
        DELETE_END_FIRST=1
        DELETE_END_FIRST_SMART=1
        ;;
    overwrite)
        OPTIMIZE_SEQUENCE=1
        OVERWRITE_MODE=1
        ;;
esac

# Resolve --delete-pacing into the individual deletion-strategy variables.
# --delete-pacing is the unified selector; the individual flags
# (--rapid-eol-delete, --rapid-identical-chars, --accel-delete,
# --adaptive-word-delete) override the pacing default.
#
# Mapping:
#   char             -> rapid_eol=0, rapid_identical=0, accel_delete=0, adaptive_word_delete=0
#   rapid-eol        -> rapid_eol=1, rapid_identical=0, accel_delete=0, adaptive_word_delete=0 (default)
#   rapid-identical  -> rapid_eol=1, rapid_identical=1, accel_delete=0, adaptive_word_delete=0
#   accel            -> rapid_eol=1, rapid_identical=0, accel_delete=1, adaptive_word_delete=0
#   word             -> rapid_eol=1, rapid_identical=0, accel_delete=0, adaptive_word_delete=1
#   instant          -> rapid_eol=1, rapid_identical=1, accel_delete=1, adaptive_word_delete=1
case "$DELETE_PACING" in
    char)
        RAPID_EOL_DELETE=0
        RAPID_IDENTICAL_CHARS=0
        ACCEL_DELETE=0
        ADAPTIVE_WORD_DELETE=0
        ;;
    rapid-eol)
        RAPID_EOL_DELETE=1
        ;;
    rapid-identical)
        RAPID_EOL_DELETE=1
        RAPID_IDENTICAL_CHARS=1
        ;;
    accel)
        RAPID_EOL_DELETE=1
        ACCEL_DELETE=1
        ;;
    word)
        RAPID_EOL_DELETE=1
        ADAPTIVE_WORD_DELETE=1
        ;;
    instant)
        RAPID_EOL_DELETE=1
        RAPID_IDENTICAL_CHARS=1
        ACCEL_DELETE=1
        ADAPTIVE_WORD_DELETE=1
        ;;
esac

# Apply --delete-threshold (overrides rapid_eol_min_chars and adaptive_word_delete_threshold)
if [[ -n "$DELETE_THRESHOLD" && "$DELETE_THRESHOLD" != "$RAPID_EOL_MIN_CHARS" ]]; then
    RAPID_EOL_MIN_CHARS="$DELETE_THRESHOLD"
    ADAPTIVE_WORD_DELETE_THRESHOLD="$DELETE_THRESHOLD"
fi

# Apply --delete-speed (scales the delete timing parameters)
case "$DELETE_SPEED" in
    slow)
        : ;; # keep defaults
    normal)
        : ;; # keep defaults
    fast)
        DIFFVIM_DELETE_DELAY_MS=$((DIFFVIM_DELETE_DELAY_MS / 2))
        ACCEL_DELETE_START_MS=$((ACCEL_DELETE_START_MS / 2))
        ADAPTIVE_WORD_DELETE_START_MS=$((ADAPTIVE_WORD_DELETE_START_MS / 2))
        ;;
    instant)
        DIFFVIM_DELETE_DELAY_MS=1
        ACCEL_DELETE_START_MS=1
        ACCEL_DELETE_MIN_MS=1
        ADAPTIVE_WORD_DELETE_START_MS=1
        ADAPTIVE_WORD_DELETE_MIN_MS=1
        ;;
esac
export DIFFVIM_DELETE_DELAY_MS

export DIFFVIM_OP_ORDER="$OP_ORDER"
export DIFFVIM_OPTIMIZE_SEQUENCE="$([[ $OPTIMIZE_SEQUENCE -eq 1 ]] && echo 1 || echo '')"
export DIFFVIM_DELETE_PACING="$DELETE_PACING"
export DIFFVIM_DELETE_SPEED="$DELETE_SPEED"
export DIFFVIM_DELETE_THRESHOLD="$DELETE_THRESHOLD"

# Resolve --insert-pacing into the individual insertion-strategy variables.
# --insert-pacing is the unified selector; the individual flags
# (--max-word-chars, --word-accel) override the pacing default.
#
# Mapping:
#   char   -> max_word_chars=0, word_accel=0 (one char at a time, default)
#   word   -> max_word_chars=8, word_accel=0 (batch short words <= 8 chars)
#   accel  -> max_word_chars=0, word_accel=1 (accelerate char-by-char inserts)
case "$INSERT_PACING" in
    char)
        : ;; # keep defaults (MAX_WORD_CHARS=0, WORD_ACCEL=0)
    word)
        # Only set MAX_WORD_CHARS if not explicitly set on CLI
        if [[ -z "$MAX_WORD_CHARS" || "$MAX_WORD_CHARS" == "0" ]]; then
            MAX_WORD_CHARS=8
        fi
        ;;
    accel)
        WORD_ACCEL=1
        ;;
esac

# Apply --insert-speed (scales the insert timing parameters)
case "$INSERT_SPEED" in
    slow)
        : ;; # keep defaults
    normal)
        : ;; # keep defaults
    fast)
        DIFFVIM_TYPE_DELAY_MS=$((DIFFVIM_TYPE_DELAY_MS / 2))
        export DIFFVIM_TYPE_DELAY_MS
        DIFFVIM_WORD_PAUSE_MS=$((DIFFVIM_WORD_PAUSE_MS / 2))
        export DIFFVIM_WORD_PAUSE_MS
        ;;
esac

export DIFFVIM_INSERT_PACING="$INSERT_PACING"
export DIFFVIM_INSERT_SPEED="$INSERT_SPEED"
# Re-export MAX_WORD_CHARS since it may have been changed by --insert-pacing word
export DIFFVIM_MAX_WORD_CHARS="$MAX_WORD_CHARS"

# Resolve --pacing into the individual timing variables.
# --pacing is the unified selector; the individual flags
# (--adaptive, --adaptive-timing, --gaussian-jitter, --pause-after-lines)
# override the pacing default.
#
# Mapping:
#   uniform  -> adaptive_timing=0, gaussian_jitter=0, adaptive_mode=0, pause_after=0 (default)
#   adaptive -> adaptive_timing=1, adaptive_mode=1 (slow down in complex regions)
#   gaussian -> gaussian_jitter=1 (human-like timing jitter)
#   review   -> adaptive_mode=1, pause_after_lines=5, pause_after_threshold=20 (pause every 5 lines)
case "$PACING" in
    uniform)
        : ;; # keep defaults
    adaptive)
        ADAPTIVE_TIMING=1
        ADAPTIVE_MODE=1
        ;;
    gaussian)
        GAUSSIAN_JITTER=1
        ;;
    review)
        ADAPTIVE_MODE=1
        PAUSE_AFTER_LINES=5
        PAUSE_AFTER_THRESHOLD=20
        ;;
esac

export DIFFVIM_PACING="$PACING"

# Resolve --highlight into the individual highlight variables.
# --highlight is the unified selector; the individual flags
# (--highlight-word, --highlight-hunk, --highlight-inline) override.
#
# Mapping:
#   none    -> highlight_word=0, highlight_hunk=0, inline_highlight=0 (default)
#   inline  -> inline_highlight=1 (paint freshly typed/deleted chars)
#   word    -> highlight_word=1 (highlight word at cursor before change)
#   hunk    -> highlight_hunk=1 (highlight entire hunk before animating)
case "$HIGHLIGHT_MODE" in
    none)
        : ;; # keep defaults
    inline)
        INLINE_HIGHLIGHT=1
        ;;
    word)
        HIGHLIGHT_WORD=1
        ;;
    hunk)
        HIGHLIGHT_HUNK=1
        ;;
esac

export DIFFVIM_HIGHLIGHT="$HIGHLIGHT_MODE"

