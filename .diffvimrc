# diffvim configuration file
# Place in ~/.diffvimrc or ./.diffvimrc

# Default options (overridden by command-line flags)
# delete_pacing = word
# delete_speed = normal
# insert_pacing = char
# pacing = uniform
# highlight = none
# theme = dark
# scroll = zz

# Performance
# speed = 1.0

# Coloring
# colorize_backend = auto

# Custom presets (define your own)
# [preset.fast]
# delete_pacing = instant
# speed = 5.0
#
# [preset.slow]
# delete_pacing = char
# speed = 0.3
# highlight = inline
