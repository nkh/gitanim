#!/usr/bin/env bash
# diffvim-pipeline — Runs the full animator pipeline: compute → postprocess →
# pace → animator. Routes options to each stage using prefixed option names.
#
# Options are routed by prefix:
#   --compute-*      → diffvim-compute-cpp
#   --postprocess-*  → diffvim-postprocess (C, fallback to Perl)
#   --pace-*         → diffvim-pace (C, fallback to Perl)
#   --animator-*     → diffvim-animator (C, fallback to Perl)
#
# Unprefixed options (--speed, --output, etc.) go to the animator.
#
# Usage:
#   diffvim-pipeline [options] <oldfile> <newfile>
#
# Examples:
#   diffvim-pipeline old.py new.py
#   diffvim-pipeline --compute-algorithm patience --pace-delete-pacing word old.py new.py
#   diffvim-pipeline --animator-no-display --animator-snapshot out.txt old.py new.py

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# --- Tool selection -------------------------------------------------------
# Compute: C++ only. If the binary is missing, fall back to the Perl
# inline LCS (compute_builtin.pl, added in this refactor). Both produce
# the same op-stream format.
COMPUTE_CPP="$ROOT_DIR/compute/bin/diffvim-compute-cpp"
COMPUTE_PERL="$ROOT_DIR/compute/perl/compute_builtin.pl"

if [[ -f "$COMPUTE_CPP" && -x "$COMPUTE_CPP" ]]; then
    COMPUTE="$COMPUTE_CPP"
elif [[ -f "$COMPUTE_PERL" ]]; then
    COMPUTE="perl $COMPUTE_PERL"
else
    echo "diffvim-pipeline: no compute tool available." >&2
    echo "  Expected: $COMPUTE_CPP" >&2
    echo "  Or fallback: $COMPUTE_PERL" >&2
    echo "  Run 'make -C compute' to build the C++ tool." >&2
    exit 1
fi

# Postprocess: C preferred, Perl fallback
POSTPROCESS_PERL="$ROOT_DIR/animator/perl/postprocess.pl"
POSTPROCESS="$ROOT_DIR/animator/bin/diffvim-postprocess"
[ ! -f "$POSTPROCESS" ] && POSTPROCESS="perl $POSTPROCESS_PERL"

# Pace: C preferred, Perl fallback
PACE_PERL="$ROOT_DIR/animator/perl/pace.pl"
PACE="$ROOT_DIR/animator/bin/diffvim-pace"
[ ! -f "$PACE" ] && PACE="perl $PACE_PERL"

# Animator: C preferred, Perl fallback
ANIMATOR_C="$ROOT_DIR/animator/bin/diffvim-animator-c"
ANIMATOR_PERL="$ROOT_DIR/animator/perl/animator.pl"
if [[ -f "$ANIMATOR_C" ]]; then
    ANIMATOR="$ANIMATOR_C"
else
    ANIMATOR="perl $ANIMATOR_PERL"
fi

show_help() {
    cat <<HELP
diffvim-pipeline — Run the full animator pipeline

Usage: diffvim-pipeline [options] <oldfile> <newfile>

The pipeline runs 4 stages:
  1. compute     — diffvim-compute-cpp (C++; Perl builtin fallback)
  2. postprocess  — diffvim-postprocess (C; Perl fallback)
  3. pace         — diffvim-pace (C; Perl fallback)
  4. animator     — diffvim-animator (C; Perl fallback)

Option routing by prefix:
  --compute-*       Options for diffvim-compute-cpp
                    (e.g. --compute-algorithm patience)
  --postprocess-*   Options for diffvim-postprocess
                    (e.g. --postprocess-op-order optimize,
                          --postprocess-semantic-cleanup)
  --pace-*          Options for diffvim-pace
                    (e.g. --pace-delete-pacing word,
                          --pace-delete-speed fast,
                          --pace-pacing gaussian)
  --animator-*      Options for diffvim-animator
                    (e.g. --animator-no-display,
                          --animator-snapshot out.txt,
                          --animator-speed 2.0)

Unprefixed options go to the animator:
  --no-display      Process without rendering
  --speed N         Speed multiplier
  --output FILE     Write final buffer to FILE
  --snapshot FILE   Write buffer to FILE at end
  --help, -h        Show this help

The C++ compute tool (compute/bin/diffvim-compute-cpp) is the default.
If it is missing, the pipeline falls back to the Perl builtin LCS.

Examples:
  diffvim-pipeline old.py new.py
  diffvim-pipeline --pace-delete-pacing word --no-display --snapshot out.txt old.py new.py
  diffvim-pipeline --compute-algorithm patience --postprocess-semantic-cleanup --pace-pacing gaussian old.py new.py

Environment:
  DIFFVIM_COMPUTE_BIN    Override compute binary path (advanced)
HELP
}

# Parse arguments
COMPUTE_ARGS=()
POSTPROCESS_ARGS=()
PACE_ARGS=()
ANIMATOR_ARGS=()
POSITIONAL=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            show_help
            exit 0
            ;;
        --compute-*)
            # Strip --compute- prefix and pass to compute tool
            opt="${1#--compute-}"
            COMPUTE_ARGS+=("--$opt")
            shift
            # If next arg doesn't start with -, it's a value
            if [[ $# -gt 0 && "$1" != -* ]]; then
                COMPUTE_ARGS+=("$1"); shift
            fi
            ;;
        --postprocess-*)
            opt="${1#--postprocess-}"
            POSTPROCESS_ARGS+=("--$opt")
            shift
            if [[ $# -gt 0 && "$1" != -* ]]; then
                POSTPROCESS_ARGS+=("$1"); shift
            fi
            ;;
        --pace-*)
            opt="${1#--pace-}"
            PACE_ARGS+=("--$opt")
            shift
            if [[ $# -gt 0 && "$1" != -* ]]; then
                PACE_ARGS+=("$1"); shift
            fi
            ;;
        --animator-*)
            opt="${1#--animator-}"
            ANIMATOR_ARGS+=("--$opt")
            shift
            if [[ $# -gt 0 && "$1" != -* ]]; then
                ANIMATOR_ARGS+=("$1"); shift
            fi
            ;;
        --no-display|--speed|--output|--snapshot|--scroll|--syntax)
            # Unprefixed animator options
            ANIMATOR_ARGS+=("$1")
            shift
            if [[ $# -gt 0 && "$1" != -* ]]; then
                ANIMATOR_ARGS+=("$1"); shift
            fi
            ;;
        --*|-*)
            # Unknown option — pass to animator
            ANIMATOR_ARGS+=("$1")
            shift
            if [[ $# -gt 0 && "$1" != -* ]]; then
                ANIMATOR_ARGS+=("$1"); shift
            fi
            ;;
        *)
            POSITIONAL+=("$1"); shift
            ;;
    esac
done

if [[ ${#POSITIONAL[@]} -lt 2 ]]; then
    echo "Error: need <oldfile> <newfile>" >&2
    echo "Run '$0 --help' for details." >&2
    exit 1
fi

OLD="${POSITIONAL[0]}"
NEW="${POSITIONAL[1]}"

# Optional override via environment (advanced; rarely needed)
if [[ -n "${DIFFVIM_COMPUTE_BIN:-}" && -f "$DIFFVIM_COMPUTE_BIN" ]]; then
    COMPUTE="$DIFFVIM_COMPUTE_BIN"
fi

# Create temp files
WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' EXIT
RAW_OPS="$WORKDIR/raw_ops.txt"
TIMED_OPS="$WORKDIR/timed_ops.txt"

# Stage 1: Compute
$COMPUTE "${COMPUTE_ARGS[@]}" "$OLD" "$NEW" "$RAW_OPS" 2>/dev/null

# Stage 2: Postprocess
$POSTPROCESS "${POSTPROCESS_ARGS[@]}" < "$RAW_OPS" 2>/dev/null > "$WORKDIR/post_ops.txt"

# Stage 3: Pace
$PACE "${PACE_ARGS[@]}" < "$WORKDIR/post_ops.txt" 2>/dev/null > "$TIMED_OPS"

# Stage 4: Animate
$ANIMATOR "${ANIMATOR_ARGS[@]}" "$OLD" < "$TIMED_OPS"
