#!/bin/bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
BIN_DIR="$ROOT/animator/bin"
DO_OVERWRITE=0; DO_INDENT_LAST=0; DEBUG=0; DUMP_DIR=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --overwrite)    DO_OVERWRITE=1; shift ;;
        --indent-last)  DO_INDENT_LAST=1; shift ;;
        --debug)        DEBUG=1; shift ;;
        --dump-dir)     DUMP_DIR="$2"; shift 2 ;;
        --op-debug)     export DV_OP_DEBUG=1; shift ;;
        --help|-h)      head -15 "$0"; exit 0 ;;
        *)              shift ;;
    esac
done
OPS=$(mktemp /tmp/pp_XXXXXX.txt); trap 'rm -f "$OPS"' EXIT
cat > "$OPS"
# 1. Reorder + position adjustment (always runs first)
"$BIN_DIR/pp_layer1" < "$OPS" > "${OPS}.tmp" 2>/dev/null; mv "${OPS}.tmp" "$OPS"
# 2. Overwrite (optional) — runs after positions are correct
if [[ $DO_OVERWRITE -eq 1 ]]; then "$BIN_DIR/pp_overwrite" < "$OPS" > "${OPS}.tmp" 2>/dev/null; mv "${OPS}.tmp" "$OPS"; fi
# 3. Delete-indent-last (optional) — adjusts its own positions
if [[ $DO_INDENT_LAST -eq 1 ]]; then "$BIN_DIR/pp_indent_last" < "$OPS" > "${OPS}.tmp" 2>/dev/null; mv "${OPS}.tmp" "$OPS"; fi
cat "$OPS"
