#compdef diffvim diffvim-tmux diffvim.pl

# Zsh completion for diffvim / diffvim-tmux / diffvim.pl
#
# Install:
#   cp completion/_diffvim /usr/local/share/zsh/site-functions/
# or:
#   cp completion/_diffvim ~/.zsh/functions/

_diffvim() {
    local -a opts
    opts=(
        '--speed[Speed multiplier]:speed:(0.5 1 2 3 5)'
        '--output[Write result to FILE]:file:_files'
        '--context[Fold unchanged regions]:n:'
        '--max-hunk-chars[Skip char-by-char for large hunks]:n:'
        '--scroll[Cursor scroll position]:scroll:(zz zt zb none)'
        '--multi[Treat args as old:new pairs]'
        '--replay[Animate git history]'
        '--git-rev[Commit range REV..REV]:rev:'
        '--version[Print version info]'
        '--dry-run[Print diff ops without launching vim]'
        '--word-diff[Use word-level diff]'
        '--step-mode[Space advances one char op]'
        '--no-startup-pause[Skip startup delay]'
        '--language[Set vim filetype]:lang:'
        '--sign-column[Show +/- signs in sign column]'
        '--git-blame[Show git blame for changed lines]'
        '--max-line-len[Warn on long lines]:n:'
        '--keep-dirty[Leave buffer modified; require :q!]'
        '--no-vimrc[Do not load ~/.vimrc]'
        '--precomputed[Use precomputed diff]:file:_files'
        '--startup-pause[Show config before starting]'
        '--startup-feedback[Show progress during computation]'
        '--algorithm[Line-level diff algorithm]:algo:(lcs myers patience)'
        '--semantic-cleanup[Merge adjacent delete+insert pairs]'
        '--indent-aware[Detect indent changes separately]'
        '--op-order[Op reordering mode]:mode:(natural optimize left-to-right end-first end-first-smart overwrite)'
        '--delete-pacing[Deletion strategy]:mode:(char rapid-eol rapid-identical accel word instant)'
        '--delete-speed[Deletion speed]:speed:(slow normal fast instant)'
        '--delete-threshold[Min chars to trigger rapid/word]:n:'
        '--insert-pacing[Insertion strategy]:mode:(char word accel)'
        '--insert-speed[Insertion speed]:speed:(slow normal fast)'
        '--pacing[Timing mode]:mode:(uniform adaptive gaussian review)'
        '--highlight[Highlight mode]:mode:(none inline word hunk)'
        '--highlight-color[Highlight group]:color:'
        '--highlight-duration-ms[Highlight duration]:ms:'
        '--dim-unchanged[Dim unchanged lines]'
        '--dim-unchanged-pct[Dimming percentage]:pct:'
        '--theme[Color theme]:theme:(dark light high-contrast)'
        '--preset[Apply named preset]:preset:(fast-delete review demo ai-code custom)'
        '--log-mode[Log mode]:mode:(1 2)'
        '--log-file[Log file]:file:_files'
        '--no-log-timing[Disable timing in log]'
        '--diff[Animate unified diff]:file:_files'
        '--debug[Enable verbose logging]'
        '--help[Show help]'
        '*:files:_files'
    )

    _arguments -s $opts
}

_diffvim "$@"
