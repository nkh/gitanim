#!/usr/bin/env bash
# ad_pipeline — Runs the full animator pipeline: compute → postprocess →
# pace → animator. Routes options to each stage using prefixed option names.
#
# Options are routed by prefix:
#   --compute-*      → ad_compute
#   --postprocess-*  → ad_postprocess (C, fallback to Perl)
#   --pace-*         → ad_layer_pace (C, fallback to Perl)
#   --animator-*     → ad (C, fallback to Perl)
#
# Load config file from XDG location ($XDG_CONFIG_HOME/ad/config,
# defaults to ~/.config/ad/config). No legacy fallbacks.
cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}"
cfg="$cfg_dir/ad/config"
[[ -f "$cfg" ]] && source "$cfg"

# Unprefixed options (--speed, --output, etc.) go to the animator.
#
# Usage:
#   ad_pipeline [options] <oldfile> <newfile>
#
# Examples:
#   ad_pipeline old.py new.py
#   ad_pipeline --compute-algorithm patience --pace-delete-pacing word old.py new.py
#   ad_pipeline --animator-no-display --animator-snapshot out.txt old.py new.py

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"   # pipeline/ → project root

# --- Tool selection -------------------------------------------------------
# Compute: C++ only. If the binary is missing, fall back to the Perl
# inline LCS (compute_builtin.pl, added in this refactor). Both produce
# the same op-stream format.
COMPUTE_CPP="$ROOT_DIR/bin/ad_compute"
COMPUTE_PERL="$ROOT_DIR/diff_engine/perl/compute.pl"

if [[ -f "$COMPUTE_CPP" && -x "$COMPUTE_CPP" ]]; then
    COMPUTE="$COMPUTE_CPP"
elif [[ -f "$COMPUTE_PERL" ]]; then
    COMPUTE="perl $COMPUTE_PERL"
else
    echo "ad_pipeline: no compute tool available." >&2
    echo "  Expected: $COMPUTE_CPP" >&2
    echo "  Or fallback: $COMPUTE_PERL" >&2
    echo "  Run 'make' to build the C++ tool." >&2
    exit 1
fi

# Postprocess: bash orchestrator (always). No Perl fallback — the
# orchestrator itself is bash, and it dispatches to layer binaries
# (C preferred, Perl fallback per-layer).
POSTPROCESS="$ROOT_DIR/pipeline/ad_postprocess"
if [ ! -f "$POSTPROCESS" ]; then
    # Fallback: look in bin/ (installed location)
    if [ -f "$ROOT_DIR/bin/ad_postprocess" ]; then
        POSTPROCESS="$ROOT_DIR/bin/ad_postprocess"
    fi
fi

# Pace: C preferred, Perl fallback
PACE_PERL="$ROOT_DIR/layers/perl/ad_layer_pace.pl"
PACE="$ROOT_DIR/bin/ad_layer_pace"
[ ! -f "$PACE" ] && PACE="perl $PACE_PERL"

# Decorate: C preferred, Perl fallback
DECORATE_PERL="$ROOT_DIR/layers/perl/ad_layer_highlight.pl"
DECORATE="$ROOT_DIR/bin/ad_layer_highlight"
[ ! -f "$DECORATE" ] && DECORATE="perl $DECORATE_PERL"

# Animator: C preferred, Perl fallback
ANIMATOR_C="$ROOT_DIR/bin/ad"
ANIMATOR_PERL="$ROOT_DIR/animator/perl/ad.pl"
if [[ -f "$ANIMATOR_C" ]]; then
    ANIMATOR="$ANIMATOR_C"
else
    ANIMATOR="perl $ANIMATOR_PERL"
fi

show_help() {
    cat <<HELP
ad_pipeline — Run the full animator pipeline

Usage: ad_pipeline [options] <oldfile> <newfile>

The pipeline runs 4 stages:
  1. compute     — ad_compute (C++; Perl builtin fallback)
  2. postprocess  — ad_postprocess (C; Perl fallback)
  3. pace         — ad_layer_pace (C; Perl fallback)
  4. animator     — ad (C; Perl fallback)

Option routing by prefix:
  --compute-*       Options for ad_compute
                    (e.g. --compute-algorithm patience)
  --postprocess-*   Options for ad_postprocess
                    (e.g. --postprocess-op-order optimize,
                          --postprocess-semantic-cleanup)
  --pace-*          Options for ad_layer_pace
                    (e.g. --pace-delete-pacing word,
                          --pace-delete-speed fast,
                          --pace-pacing gaussian)
  --animator-*      Options for ad
                    (e.g. --animator-no-display,
                          --animator-snapshot out.txt,
                          --animator-speed 2.0)

Unprefixed options go to the animator:
  --no-display      Process without rendering
  --speed N         Speed multiplier
  --output FILE     Write final buffer to FILE
  --snapshot FILE   Write buffer to FILE at end
  --help, -h        Show this help

The C++ compute tool (bin/ad_compute) is the default.
If it is missing, the pipeline falls back to the Perl builtin LCS.

Examples:
  ad_pipeline old.py new.py
  ad_pipeline --pace-delete-pacing word --no-display --snapshot out.txt old.py new.py
  ad_pipeline --compute-algorithm patience --postprocess-semantic-cleanup --pace-pacing gaussian old.py new.py

Environment:
  AD_COMPUTE_BIN    Override compute binary path (advanced)
HELP
}

# Parse arguments
COMPUTE_ARGS=()
POSTPROCESS_ARGS=()
PACE_ARGS=()
ANIMATOR_ARGS=()
DECORATE_ARGS=()
POSITIONAL=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            show_help
            exit 0
            ;;
        --compute-*)
            # Strip --compute- prefix and pass to compute tool
            opt="${1#--compute-}"
            COMPUTE_ARGS+=("--$opt")
            shift
            # If next arg doesn't start with -, it's a value
            if [[ $# -gt 0 && "$1" != -* ]]; then
                COMPUTE_ARGS+=("$1"); shift
            fi
            ;;
        --line-delete-in-place)
            POSTPROCESS_ARGS+=("--ad-layer=ad_layer_line_delete_in_place")
            shift
            ;;
        --indent-last)
            POSTPROCESS_ARGS+=("--ad-layer=ad_layer_indent_last")
            shift
            ;;
        --overwrite)
            POSTPROCESS_ARGS+=("--ad-layer=ad_layer_overwrite")
            shift
            ;;
        # Generic layer addition: --ad-layer=<name> adds a layer to the
        # chain. See docs/src/plugin-layers.md for the plugin contract.
        --ad-layer=*)
            POSTPROCESS_ARGS+=("$1")
            shift
            ;;
        --ad-layer)
            POSTPROCESS_ARGS+=("--ad-layer=$2")
            shift 2
            ;;
        --ad-layer-path=*)
            POSTPROCESS_ARGS+=("$1")
            shift
            ;;
        --ad-layer-path)
            POSTPROCESS_ARGS+=("--ad-layer-path=$2")
            shift 2
            ;;
        --list-layers)
            exec "$ROOT_DIR/pipeline/ad_postprocess" --list-layers
            ;;
        --postprocess-*)
            opt="${1#--postprocess-}"
            POSTPROCESS_ARGS+=("--$opt")
            shift
            if [[ $# -gt 0 && "$1" != -* ]]; then
                POSTPROCESS_ARGS+=("$1"); shift
            fi
            ;;
        --pace-*)
            opt="${1#--pace-}"
            PACE_ARGS+=("--$opt")
            shift
            if [[ $# -gt 0 && "$1" != -* ]]; then
                PACE_ARGS+=("$1"); shift
            fi
            ;;
        --animator-*)
            opt="${1#--animator-}"
            ANIMATOR_ARGS+=("--$opt")
            shift
            if [[ $# -gt 0 && "$1" != -* ]]; then
                ANIMATOR_ARGS+=("$1"); shift
            fi
            ;;
        --no-display|--speed|--output|--snapshot|--scroll|--syntax|\
        --diff-stat|--diff-highlight|--bell|--line-numbers|--progress|\
        --verbose|--dry-run)
            # Unprefixed animator options (boolean or with value)
            ANIMATOR_ARGS+=("$1")
            shift
            if [[ $# -gt 0 && "$1" != -* ]]; then
                ANIMATOR_ARGS+=("$1"); shift
            fi
            ;;
        --*|-*)
            # Unknown option — route to the right stage
            opt="$1"
            shift
            val=""
            [[ $# -gt 0 && "$1" != -* ]] && { val="$1"; shift; }
            case "$opt" in
                --op-order|--semantic-cleanup|-S|--indent-aware|-i|--indent-last|--overwrite|--stream)
                    POSTPROCESS_ARGS+=("$opt")
                    [[ -n "$val" ]] && POSTPROCESS_ARGS+=("$val")
                    ;;
                --word-diff|--no-optimize-sequence)
                    COMPUTE_ARGS+=("$opt")
                    [[ -n "$val" ]] && COMPUTE_ARGS+=("$val")
                    ;;
                --delete-pacing|--insert-pacing|--delete-speed|--insert-speed|\
                --delete-threshold|--pacing|--gaussian-jitter-pct|\
                --pause-after-lines|--pause-after-threshold|--pause-after-ms|\
                --accel-delete|--accel-delete-start-ms|--accel-delete-min-ms|--accel-delete-accel|\
                --block-delete-size|--pause-before-delete-ms|--pause-after-delete-ms|\
                --flash-pause-ms|--flash-highlight-ms|\
                --cursor-glide-ms|--cursor-glide-show-intermediate|\
                --distance-speed|--distance-threshold|--distance-fast-mult|--distance-slow-mult|\
                --hunk-pause-ms|--type-delay-ms|--delete-delay-ms|--word-pause-ms)
                    PACE_ARGS+=("$opt")
                    [[ -n "$val" ]] && PACE_ARGS+=("$val")
                    ;;
                --highlight|--highlight-duration-ms|--dim-unchanged|-D|--dim-unchanged-pct|\
                --fold-unchanged|--sign-column|--git-blame|-g|--max-hunk-chars|--theme|-t)
                    DECORATE_ARGS+=("$opt")
                    [[ -n "$val" ]] && DECORATE_ARGS+=("$val")
                    ;;
                --diff-stat|--diff-highlight|--bell|--scroll|--line-numbers|--progress|--speed)
                    ANIMATOR_ARGS+=("$opt")
                    [[ -n "$val" ]] && ANIMATOR_ARGS+=("$val")
                    ;;
                --left-to-right)
                    export AD_LEFT_TO_RIGHT=1
                    ;;
                --no-left-to-right)
                    export AD_LEFT_TO_RIGHT=0
                    ;;
                *)
                    ANIMATOR_ARGS+=("$opt")
                    [[ -n "$val" ]] && ANIMATOR_ARGS+=("$val")
                    ;;
            esac
            ;;
        *)
            POSITIONAL+=("$1"); shift
            ;;
    esac
done

if [[ ${#POSITIONAL[@]} -lt 2 ]]; then
    echo "Error: need <oldfile> <newfile>" >&2
    echo "Run '$0 --help' for details." >&2
    exit 1
fi

OLD="${POSITIONAL[0]}"
NEW="${POSITIONAL[1]}"

# Optional override via environment (advanced; rarely needed)
if [[ -n "${AD_COMPUTE_BIN:-}" && -f "$AD_COMPUTE_BIN" ]]; then
    COMPUTE="$AD_COMPUTE_BIN"
fi

# Create temp files
WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR" && kill $(jobs -p) 2>/dev/null' EXIT
RAW_OPS="$WORKDIR/raw_ops.txt"
TIMED_OPS="$WORKDIR/timed_ops.txt"
COLORIZE_OLD="$WORKDIR/old.colormap"
COLORIZE_NEW="$WORKDIR/new.colormap"
COLORIZE_PID=""

# Start coloring in parallel with the processing pipeline.
# The colorize tool runs on both old and new files concurrently
# with the compute → postprocess → pace stages.
COLORIZE_TOOL="$ROOT_DIR/animator/perl/colorize.pl"
if [[ -f "$COLORIZE_TOOL" ]]; then
    COLORIZE_BACKEND="${AD_COLORIZE_BACKEND:-auto}"
    # Run both colorizations in the background, output to temp files
    ( perl "$COLORIZE_TOOL" --backend "$COLORIZE_BACKEND" "$OLD" "$COLORIZE_OLD" 2>/dev/null
      perl "$COLORIZE_TOOL" --backend "$COLORIZE_BACKEND" "$NEW" "$COLORIZE_NEW" 2>/dev/null ) &
    COLORIZE_PID=$!
fi

# #7: Binary file detection — refuse to animate binary files
for f in "$OLD" "$NEW"; do
    if [[ -f "$f" ]]; then
        if head -c 8192 "$f" | grep -qP '\x00'; then
            echo "ad_pipeline: error: binary file detected: $f" >&2
            echo "  Binary files cannot be animated. Aborting." >&2
            exit 1
        fi
    fi
done

# #66: Better error messages
run_stage() {
    local name="$1"; shift
    local output_file="$1"; shift
    if ! "$@" 2>/dev/null > "$output_file"; then
        echo "ad_pipeline: error: stage '$name' failed" >&2
        echo "  Command: $*" >&2
        exit 1
    fi
}

# Stage 1: Compute
run_stage "compute" "$RAW_OPS" $COMPUTE "${COMPUTE_ARGS[@]}" "$OLD" "$NEW" "$RAW_OPS"

# Stage 2: Postprocess — runs the layer chain.
# Default: ad_layer_reorder first, then any user-requested layers
# (via --indent-last, --overwrite, --line-delete-in-place, --ad-layer).
# The user flags above already pushed --ad-layer=ad_layer_<name> entries
# into POSTPROCESS_ARGS; we prepend the default reorder layer here.
if [[ ${#POSTPROCESS_ARGS[@]} -eq 0 || "${POSTPROCESS_ARGS[0]}" != "--ad-layer=ad_layer_reorder" ]]; then
    POSTPROCESS_ARGS=("--ad-layer=ad_layer_reorder" "${POSTPROCESS_ARGS[@]}")
fi

run_stage "postprocess" "$WORKDIR/post_ops.txt" $POSTPROCESS "${POSTPROCESS_ARGS[@]}" < "$RAW_OPS"

# Stage 3: Pace
run_stage "pace" "$TIMED_OPS" $PACE "${PACE_ARGS[@]}" < "$WORKDIR/post_ops.txt"

# Stage 3b: Decorate (optional — passes through if no decoration args)
# DECORATE_ARGS was initialized at top with other arrays
DECORATED_OPS="$WORKDIR/decorated_ops.txt"
if [[ -f "$DECORATE" ]] || [[ -f "$DECORATE_PERL" ]]; then
    run_stage "decorate" "$DECORATED_OPS" $DECORATE "${DECORATE_ARGS[@]}" < "$TIMED_OPS"
    TIMED_OPS="$DECORATED_OPS"
fi

# Wait for coloring to finish (if still running)
if [[ -n "$COLORIZE_PID" ]]; then
    wait "$COLORIZE_PID" 2>/dev/null
fi

# Stage 4: Animate
# Pass colormap files to the animator if they exist
ANIMATOR_COLOR_ARGS=()
if [[ -f "$COLORIZE_OLD" ]]; then
    ANIMATOR_COLOR_ARGS+=("--colormap-old" "$COLORIZE_OLD")
fi
if [[ -f "$COLORIZE_NEW" ]]; then
    ANIMATOR_COLOR_ARGS+=("--colormap-new" "$COLORIZE_NEW")
fi

$ANIMATOR "${ANIMATOR_ARGS[@]}" "${ANIMATOR_COLOR_ARGS[@]}" "$OLD" < "$TIMED_OPS"

# --- Unprefixed option routing ---
