#!/usr/bin/env bash
# ad_postprocess — Dynamic postprocess orchestrator (layer plugin host).
#
# Reads V2 TSV from stdin, runs a chain of layer plugins, writes V2 TSV
# to stdout. The chain is supplied entirely on the command line.
#
# Plugin contract (see docs/src/plugin-layers.md):
#   * A layer is any executable that reads V2 TSV from stdin and writes
#     V2 TSV to stdout.
#   * Extensions are honored: .pl → perl, .py → python3, .rb → ruby,
#     .sh → bash, .js → node. Anything else must be executable on its own.
#
# Layer chain:
#   --ad-layer=<name>     Add a layer to the chain. Layers run in argv
#                          order (NOT sorted, NOT deduplicated). The same
#                          layer can be passed twice — it runs twice.
#   --ad-layer-path=<dir>  Add a directory to the layer search path.
#                          Repeatable. Default: <project>/layers/c and
#                          <project>/layers/perl.
#
# If no --ad-layer is given, the caller (ad_vim, ad_pipeline) is
# responsible for supplying its own default chain. This orchestrator
# has no opinion about what runs by default.
#
# <name> lookup:
#   * If <name> contains '/', it's treated as a path (relative to CWD or
#     absolute). Run it directly.
#   * Else, search each --ad-layer-path dir in declared order. The first
#     dir containing a file named <name> (verbatim) wins.
#   * If no match, error and exit 1.
#
# Usage:
#   ad_postprocess [--ad-layer=<name>]... [--ad-layer-path=<dir>]... < in > out
#   ad_postprocess --list-layers [--ad-layer-path=<dir>]...
#   ad_postprocess --help
#
# Environment:
#   AD_DEBUG_LAYERS=1     Enable per-layer debug dumps in /tmp/ad_debug/

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
# Default search path: compiled binaries (bin/) and Perl scripts
# (layers/perl/). Source files in layers/c/ are NOT directly executable
# as layers — they must be compiled first via `make`.
DEFAULT_LAYER_PATHS=("$ROOT/bin" "$ROOT/layers/perl")

die() { echo "ad_postprocess: $*" >&2; exit 1; }

# ── Layer resolution ────────────────────────────────────────────────────
# Given a layer name (or path), find an executable that implements it.
# Echoes the command to run (interpreter + path). Returns 1 on failure.
resolve_layer() {
    local name="$1"
    # 1. If name contains '/', treat as path.
    if [[ "$name" == */* ]]; then
        if [[ ! -e "$name" ]]; then
            echo "ad_postprocess: layer path does not exist: $name" >&2
            return 1
        fi
        # Pick interpreter by extension.
        local ext="${name##*.}"
        case "$ext" in
            pl) echo "perl $name" ;;
            py) echo "python3 $name" ;;
            rb) echo "ruby $name" ;;
            sh) echo "bash $name" ;;
            js) echo "node $name" ;;
            *)
                if [[ -x "$name" ]]; then
                    echo "$name"
                else
                    echo "ad_postprocess: layer '$name' is not executable" >&2
                    return 1
                fi
                ;;
        esac
        return 0
    fi
    # 2. Search each layer path.
    local searched=""
    for dir in "${LAYER_PATHS[@]}"; do
        [[ -d "$dir" ]] || continue
        searched+="  $dir"$'\n'
        if [[ -f "$dir/$name" ]]; then
            local ext="${name##*.}"
            # Only treat as extension if name has a dot AND the part after
            # the last dot is short (≤4 chars) and alphanumeric.
            if [[ "$name" == *.* ]] && [[ "${name##*.}" =~ ^[A-Za-z0-9]{1,4}$ ]]; then
                case "$ext" in
                    pl) echo "perl $dir/$name"; return 0 ;;
                    py) echo "python3 $dir/$name"; return 0 ;;
                    rb) echo "ruby $dir/$name"; return 0 ;;
                    sh) echo "bash $dir/$name"; return 0 ;;
                    js) echo "node $dir/$name"; return 0 ;;
                    *)
                        if [[ -x "$dir/$name" ]]; then
                            echo "$dir/$name"; return 0
                        fi
                        echo "ad_postprocess: layer '$name' found in $dir but is not executable" >&2
                        return 1
                        ;;
                esac
            else
                # No extension — must be executable.
                if [[ -x "$dir/$name" ]]; then
                    echo "$dir/$name"; return 0
                fi
                echo "ad_postprocess: layer '$name' found in $dir but is not executable" >&2
                return 1
            fi
        fi
    done
    echo "ad_postprocess: layer '$name' not found in:" >&2
    printf '  %s\n' "${LAYER_PATHS[@]}" >&2
    return 1
}

# ── List layers in search path ──────────────────────────────────────────
list_layers() {
    echo "Layer search path:"
    for dir in "${LAYER_PATHS[@]}"; do
        echo "  $dir"
    done
    echo ""
    echo "Available layers:"
    for dir in "${LAYER_PATHS[@]}"; do
        [[ -d "$dir" ]] || continue
        for f in "$dir"/*; do
            [[ -f "$f" ]] || continue
            local name
            name="$(basename "$f")"
            local status="?"
            if [[ -x "$f" ]]; then
                status="exec"
            elif [[ "$name" == *.pl ]]; then
                status="perl"
            elif [[ "$name" == *.py ]]; then
                status="python3"
            elif [[ "$name" == *.rb ]]; then
                status="ruby"
            elif [[ "$name" == *.sh ]]; then
                status="bash"
            elif [[ "$name" == *.js ]]; then
                status="node"
            fi
            printf "  %-30s  [%s]  %s\n" "$name" "$status" "$f"
        done
    done
}

# ── CLI parsing ─────────────────────────────────────────────────────────
LAYER_NAMES=()
LAYER_PATHS=("${DEFAULT_LAYER_PATHS[@]}")
PASSTHROUGH_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --ad-layer=*)
            LAYER_NAMES+=("${1#--ad-layer=}")
            shift
            ;;
        --ad-layer)
            LAYER_NAMES+=("$2")
            shift 2
            ;;
        --ad-layer-path=*)
            LAYER_PATHS+=("${1#--ad-layer-path=}")
            shift
            ;;
        --ad-layer-path)
            LAYER_PATHS+=("$2")
            shift 2
            ;;
        --list-layers)
            list_layers
            exit 0
            ;;
        --help|-h)
            cat <<HELP
ad_postprocess — Dynamic postprocess orchestrator

Usage:
  ad_postprocess [--ad-layer=<name>]... [--ad-layer-path=<dir>]... < in > out
  ad_postprocess --list-layers [--ad-layer-path=<dir>]...
  ad_postprocess --help

Layer chain:
  --ad-layer=<name>     Add a layer. Layers run in argv order. The same
                        layer can be passed twice (it runs twice).
  --ad-layer-path=<dir> Add a directory to the layer search path.
                        Repeatable. Default: layers/c and layers/perl.

<name> lookup:
  * Contains '/' → treated as a path (relative or absolute).
  * Else → searched in each --ad-layer-path dir, in declared order.
  * Extensions honored: .pl, .py, .rb, .sh, .js. Otherwise the file
    must be executable.

Environment:
  AD_DEBUG_LAYERS=1     Enable per-layer debug dumps in /tmp/ad_debug/

See docs/src/plugin-layers.md for the full plugin contract.
HELP
            exit 0
            ;;
        --)
            shift
            PASSTHROUGH_ARGS+=("$@")
            break
            ;;
        *)
            # Unknown option — pass through to every layer.
            PASSTHROUGH_ARGS+=("$1")
            shift
            ;;
    esac
done

if [[ ${#LAYER_NAMES[@]} -eq 0 ]]; then
    die "no layers specified (use --ad-layer=<name>); ad_postprocess has no default chain"
fi

# ── Resolve each layer and run them in order ────────────────────────────
T=$(mktemp); cat > "$T"
trap 'rm -f "$T" "$T.2"' EXIT

echo "ad_postprocess: running ${#LAYER_NAMES[@]} layer(s):" >&2
for name in "${LAYER_NAMES[@]}"; do
    bin="$(resolve_layer "$name")" || exit 1
    echo "  → $name  ($bin)" >&2
    if ! $bin ${PASSTHROUGH_ARGS[@]:-} < "$T" > "$T.2" 2>/dev/null; then
        echo "ad_postprocess: layer '$name' failed (exit $?)" >&2
        echo "  bin:  $bin" >&2
        echo "  args: ${PASSTHROUGH_ARGS[*]:-}" >&2
        exit 1
    fi
    mv "$T.2" "$T"
done

cat "$T"
